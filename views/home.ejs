<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Sir C R Reddy Boys Hostel</title>
<meta
  name="description"
  content="Sir C R Reddy Boys Hostel, Vatluru, Eluru, Andhra Pradesh. View hostel facilities, fee details, rules, mess, security and contact information."
>

<meta
  name="robots"
  content="index, follow"
>

<link
  rel="canonical"
  href="https://hostel-management-wb7z.onrender.com/"
>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    :root{
      --primary-color: #00d4ff;
      --secondary-color: #009ac1;
      --sidebar-dark: rgba(10,25,47,0.95);
      --text-light: #f0f0f0;
      --font-poppins: 'Poppins', sans-serif;
      --sidebar-width: 280px;
      --sidebar-collapsed: 70px;
      --header-height: 140px; 
      --gold: #ffcc00;
      --gold-soft: rgba(255,204,0,0.12);
      --royal-1: #0d1b4c;
      --royal-2: #12306b;
      --royal-3: #1a1a1a;
    }

    *{box-sizing:border-box}
    body{
      margin:0;
      font-family:var(--font-poppins);
      background: url('images/hostel-bg.jpg') no-repeat center center/cover;
      color:var(--text-light);
      min-height:100vh;
      line-height:1.6;
      overflow-x: hidden;
    }

    body::before{
      content:"";
      position:fixed;
      inset:0;
      background: rgba(0,0,0,0.55);
      z-index:-1;
    }

    /* ====== Header ====== */
    .college-header{
      position:fixed;
      top:0; left:0; right:0;
      height: var(--header-height);
      display:flex;
      align-items:center;
      justify-content:space-between;
      z-index:1000;
      padding: 0 40px;
      background: linear-gradient(90deg, var(--royal-1), var(--royal-2), var(--royal-3), var(--royal-2), var(--royal-1));
      background-size: 300% 300%;
      animation: shimmerMove 15s ease-in-out infinite;
      box-shadow: 0 6px 18px rgba(0,0,0,0.45);
      backdrop-filter: blur(4px);
    }

    .header-left, .header-right {
      flex: 0 0 100px; /* Gives equal space to sides so center stays center */
    }

    .header-right { text-align: right; }

    .header-left img{
      height:80px;
      width:auto;
      filter: drop-shadow(0 0 8px rgba(255,255,255,0.8));
    }

    .header-center{
      flex: 1;
      text-align: center;
      padding: 0 10px;
    }

    .header-text h1{
      margin:0;
      font-size: 1.4rem;
      letter-spacing:0.6px;
      text-transform:uppercase;
      color:#fff;
      font-weight:700;
    }
    .boyshostel{ color:var(--gold); }

    .login-btn{
      background: linear-gradient(90deg, #ffdb4d, #ffb300);
      color:#000;
      font-weight:700;
      padding:10px 22px;
      border-radius:26px;
      border: none;
      cursor:pointer;
      text-transform:uppercase;
      box-shadow: 0 0 12px rgba(255,204,0,0.6);
      transition: transform .18s ease;
      white-space:nowrap;
      font-size:0.85rem;
    }

    /* ====== Sidebar ====== */
    .sidebar {
      position: fixed; left: 0; top: var(--header-height);
      width: var(--sidebar-width); height: calc(100vh - var(--header-height));
      background: linear-gradient(180deg, var(--royal-1), var(--royal-2));
      box-shadow: 4px 0 14px rgba(0,0,0,0.6); z-index:900;
      transition: width 300ms cubic-bezier(.2,.9,.2,1);
      overflow-y: auto; overflow-x: hidden;
    }
    .sidebar.collapsed { width: var(--sidebar-collapsed); }

    .nav-list { padding: 10px; display:flex; flex-direction:column; gap:8px; }
    .nav-item { 
      display:flex; align-items:center; gap:12px; background:transparent; 
      border:none; color:#fff; padding:12px; cursor:pointer; 
      border-radius:8px; width:100%; text-align:left; transition: 0.3s;
    }
    .nav-item i { color:var(--primary-color); width:20px; text-align: center; font-size: 1.2rem;}
    .sidebar.collapsed .label { display:none; }
    .nav-item:hover, .nav-item.active { background: var(--gold-soft); color: var(--gold); }

    /* ====== Content Area ====== */
    .container { 
        margin-left: var(--sidebar-width); 
        transition: margin-left 300ms; 
        padding: 40px; 
        width: calc(100% - var(--sidebar-width));
    }
    .sidebar.collapsed ~ .container { 
        margin-left: var(--sidebar-collapsed); 
        width: calc(100% - var(--sidebar-collapsed));
    }
    
    .content h2 { font-size: 1.8rem; margin-bottom: 15px; }
    .content p { font-size: 1rem; line-height: 1.6; }

    .highlight-box { 
        background: rgba(255,255,255,0.05); 
        border-left:5px solid var(--primary-color); 
        padding:20px; border-radius:10px; margin:20px 0; 
    }

    .image-gallery { 
        display:grid; 
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); 
        gap:20px; margin-top: 20px;
    }
    .image-gallery img { width:100%; height:220px; object-fit:cover; border-radius:12px; border:2px solid rgba(0,212,255,0.3); }

    /* ====== Mobile Adjustments ====== */
    @media (max-width: 760px){
      :root { --header-height: 90px; }

      .college-header { padding: 0 10px; }
      
      .header-left, .header-right { flex: 0 0 50px; } /* Smaller side containers */

      .header-left img { height: 40px; }
      
      .header-text h1 { 
          font-size: 0.75rem; 
          white-space: normal; /* Allows wrap so it stays centered */
          line-height: 1.2;
          text-align: center;
      }
      
      .login-btn { padding: 5px 10px; font-size: 0.6rem; border-radius: 15px; }

      .sidebar { top: 90px; height: calc(100vh - 90px); }
      .container { 
          margin-left: var(--sidebar-collapsed); 
          padding: 20px; 
          width: calc(100% - var(--sidebar-collapsed));
      }
    }

    @keyframes shimmerMove { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
    .spacer { height: var(--header-height); }
    footer { position:fixed; bottom:10px; right:10px; background:rgba(0,0,0,0.6); padding:5px 10px; border-radius:5px; font-size:12px; z-index: 1001;}
  </style>
</head>
<body>

  <div class="college-header">
    <div class="header-left">
      <img src="images/college_logo.png" alt="Logo">
    </div>
    <div class="header-center">
      <div class="header-text">
        <h1>SIR C R REDDY COLLEGE OF ENGINEERING (AUTONOMOUS)<br class="mobile-only"> <span class="boyshostel">BOYS HOSTEL</span></h1>
      </div>
    </div>
    <div class="header-right">
      <button class="login-btn" onclick="location.href='/choose_login'">Login</button>
    </div>
  </div>

  <div class="spacer"></div>

  <aside class="sidebar" id="sidebar">
    <div style="text-align: center; padding: 15px;">
        <button id="sidebarToggle" style="background:none; border:none; color:white; cursor:pointer; font-size:1.5rem;">
            <i class="fa-solid fa-bars"></i>
        </button>
    </div>
    <nav class="nav-list">
      <button class="nav-item active" data-section="about"><i class="fa-solid fa-building-columns"></i><span class="label">About</span></button>
      <button class="nav-item" data-section="fee"><i class="fa-solid fa-coins"></i><span class="label">Fee</span></button>
      <button class="nav-item" data-section="rules"><i class="fa-solid fa-scroll"></i><span class="label">Rules</span></button>
      <button class="nav-item" data-section="facilities"><i class="fa-solid fa-bolt"></i><span class="label">Facilities</span></button>
      <button class="nav-item" data-section="mess"><i class="fa-solid fa-utensils"></i><span class="label">Mess</span></button>
      <button class="nav-item" data-section="security"><i class="fa-solid fa-shield-halved"></i><span class="label">Security</span></button>
      <button class="nav-item" data-section="contact"><i class="fa-solid fa-phone"></i><span class="label">Contact</span></button>
    </nav>
  </aside>

  <main class="container">
    <div class="content" id="contentArea">
      <h2 style="color: var(--gold); text-align:center;">Welcome to Sir <br>C R Reddy Boys Hostel</h2>
      <p style="text-align:center;">Experience comfort, discipline, and growth in a home away from home.</p>
      <div class="image-gallery">
        <img src="images/h6.jpg" alt="Hostel Night View">
        <img src="images/h1.jpg" alt="Building">
        <img src="images/h2.jpg" alt="Entrance">
      </div>
    </div>
  </main>

  <footer>© 2025 | <a href="#" style="color:var(--primary-color); text-decoration: none;">Hostel Management</a></footer>

  <script>
    // Content data objects (Abbreviated for space, keep your original full content here)
    const content = {
       about: `
                <h2>About Hostel</h2>
                <p>Located within the beautiful campus of Sir C R Reddy College of Engineering, Eluru.</p>
                <p>Our boys hostel comprises multiple blocks — each with modern rooms, 24/7 water and power facilities, and an environment that encourages study and friendship.</p>
                <div class="highlight-box">
                    <p><b>Head of Hostel:</b> Prof. [ Mr A SURYA PRAKASH  ]</p>
                    <p><b>Wardens:</b> Experienced faculty members managing each block with care and dedication.</p>
                    <p><b>Achievements:</b> Students have organized cultural fests, sports tournaments, and community service activities within the hostel.</p>
                </div>
                <h3>Hostel Environment Gallery</h3>
                <p style="text-align:center; font-weight:500; font-size:1.05rem;">Here's a glimpse of our vibrant hostel environment:</p>
    <div class="image-gallery">
      <img src="images/h4.jpg" alt="Hostel Exterior View">
      <img src="images/h3.jpg" alt="Hostel Common Area">
      <img src="images/h5.jpg" alt="Hostel Entrance">
    </div>
            `,
            fee: `
                <h2>Fee Details</h2>
                <p>All hostel fee payments must be made <b>only through SBI Collect</b>.</p>
                <div class="highlight-box">
                    <p><i class="fa-solid fa-circle-info" style="color:var(--primary-color);"></i> The total annual fee includes both <b>Room Rent</b> and <b>Mess Charges</b>.</p>
                    <p><b>Payment Steps:</b></p>
                    <ol>
                        <li>Visit the official <a href="https://www.onlinesbi.sbi/sbicollect/" target="_blank" style="color:var(--primary-color);text-decoration:none;">SBI Collect Portal</a>.</li>
                        <li>Select “Andhra Pradesh” → “Sir C R Reddy College of Engineering”.</li>
                        <li>Enter your details (Student ID, Name, Block, Room No, etc.).</li>
                        <li>Make the payment using UPI, Net Banking, or Debit Card.</li>
                    </ol>
                    <p>Receipt will be automatically verified and updated in the system.</p>
                </div>
            `,
            rules: `
                <h2>Hostel Rules</h2>
                <div class="highlight-box">
                    <p>Discipline is paramount for a harmonious living environment.</p>
                </div>
                <ul>
                    <li>Maintain discipline and cleanliness at all times.</li>
                    <li>Respect wardens and fellow students.</li>
                    <li>Entry after 9:00 PM is strictly prohibited without permission.</li>
                    <li>Ragging or misconduct will lead to immediate and strict disciplinary action.</li>
                    <li>Visitors are allowed only during specified hours and must register at the gate.</li>
                </ul>
            `,
            facilities: `
                <h2>Facilities</h2>
                <ul>
                    <li>24x7 purified water supply </li>
                    <li> cc camera protection</li>
                    <li> NO power supply issue 24x7 Power Backup Through Generator </li>
                    <li>High-speed free Wi-Fi access (monitored and filtered).</li>
                    <li>Clean and hygienic restrooms and common rooms.</li>
                    <li>Sports grounds and indoor gaming zones (e.g., Chess, Carrom).</li>
                    <li>Quick maintenance support for any issues.</li>
                    <li>Dedicated Study Halls for focused preparation.</li>
                </ul>
                <h3>Hostel Room Examples</h3>
                <div class="image-gallery">
                    <img src="https://source.unsplash.com/random/400x250/?hostel-room,student-dorm" alt="Hostel Room with Beds">
                    <img src="https://source.unsplash.com/random/400x250/?study-desk,dormitory" alt="Hostel Study Desk">
                    <img src="https://source.unsplash.com/random/400x250/?common-room,hostel-lounge" alt="Hostel Common Room">
                </div>
            `,
            mess: `
                <h2>Mess Details</h2>
                <p>Our hostel mess is completely managed by the students, fostering responsibility and ensuring both quality and affordability.</p>
                <div class="highlight-box">
                    <p>Daily meals are nutritious and served on time. The menu is decided by student representatives and reviewed weekly.</p>
                    <p>Special dishes are prepared on weekends and festivals, maintaining a homely atmosphere.</p>
                </div>
                <h3>Mess Hall & Food</h3>
                <div class="image-gallery">
                    <img src="https://source.unsplash.com/random/400x250/?mess-hall,cafeteria" alt="Hostel Mess Hall">
                    <img src="https://source.unsplash.com/random/400x250/?indian-food,thali" alt="Example Meal Served">
                    <img src="https://source.unsplash.com/random/400x250/?kitchen,cooking" alt="Hostel Kitchen View">
                </div>
            `,
            security: `
                <h2>Security</h2>
                <p>Our hostel maintains strict security measures to ensure the safety and well-being of all students. Your security is our top priority.</p>
                <div class="highlight-box">
                    <p><i class="fa-solid fa-person-walking-arrow-right" style="color:var(--primary-color);"></i> Every student must inform the warden before leaving the hostel premises. An <b>outpass</b> is mandatory for all exits.</p>
                    <p><i class="fa-solid fa-fingerprint" style="color:var(--primary-color);"></i> Entry and exit are recorded using thumb impressions to ensure accurate monitoring.</p>
                    <p><i class="fa-solid fa-user-lock" style="color:var(--primary-color);"></i> 24×7 security staff are stationed at all gates to maintain safety and discipline.</p>
                </div>
                <h3>Security Measures</h3>
                <div class="image-gallery">
                    <img src="https://source.unsplash.com/random/400x250/?cctv,security-camera" alt="CCTV Surveillance">
                    <img src="https://source.unsplash.com/random/400x250/?guard,gate" alt="Hostel Gate with Guard">
                    <img src="https://source.unsplash.com/random/400x250/?access-control,biometrics" alt="Biometric Access System">
                </div>
            `,
            contact: `
                <h2>Contact</h2>
                <div class="highlight-box">
                    <p><i class="fa-solid fa-location-dot" style="color:var(--primary-color);"></i> <b>Address:</b> Sir C R Reddy Boys Hostel, Vatluru, Eluru, Andhra Pradesh - 534007</p>
                    <p><i class="fa-solid fa-phone-volume" style="color:var(--primary-color);"></i> <b>Phone:</b> 123456789</p>
                    <p><i class="fa-solid fa-envelope" style="color:var(--primary-color);"></i> <b>Email:</b> hostel@sircrreddy.edu.in</p>
                </div>
            `
        };


    const sidebar = document.getElementById('sidebar');
    
    document.getElementById('sidebarToggle').addEventListener('click', () => {
      sidebar.classList.toggle('collapsed');
    });

    document.querySelectorAll('.nav-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const section = btn.dataset.section;
        const area = document.getElementById('contentArea');
        area.innerHTML = content[section] || '<h2>Section</h2>';
        
        document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        if (window.innerWidth <= 760) {
          sidebar.classList.add('collapsed');
        }
      });
    });

    if (window.innerWidth <= 760) sidebar.classList.add('collapsed');
  </script>
</body>
</html>
