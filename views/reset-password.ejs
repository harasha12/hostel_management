<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password</title>

    <style>
        body {
            margin: 0;
            padding: 0;
            height: 100vh;
            background: url("/images/hostel-bg.jpg") no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #fff;
        }

        .overlay {
            background: rgba(0, 0, 0, 0.6);
            min-height: 100vh;
            backdrop-filter: blur(5px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }

        .reset-box {
            width: 400px;
            background: rgba(255, 255, 255, 0.15);
            padding: 30px 35px;
            border-radius: 12px;
            box-shadow: 0 8px 25px rgba(0,0,0,0.5);
            backdrop-filter: blur(10px);
            text-align: center;
            animation: dropFade 0.7s ease-in-out;
        }

        @keyframes dropFade {
            0% { opacity: 0; transform: translateY(-25px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        .reset-box h2 {
            margin-bottom: 20px;
            font-size: 2rem;
            text-shadow: 2px 2px 5px #000;
        }

        .reset-box label {
            float: left;
            font-weight: bold;
            margin-bottom: 6px;
        }

        .reset-box input {
            width: 100%;
            padding: 12px;
            margin-bottom: 18px;
            border-radius: 6px;
            border: none;
            font-size: 1rem;
        }

        .reset-box button {
            width: 100%;
            padding: 12px;
            background: #28a745;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s ease;
        }

        .reset-box button:hover {
            background: #1e7e34;
            transform: translateY(-2px);
        }

        .back-link {
            display: block;
            margin-top: 15px;
            color: #ffcc00;
            font-weight: bold;
            text-decoration: none;
        }

        .back-link:hover {
            text-decoration: underline;
        }
    </style>
</head>

<body>

<div class="overlay">
    <div class="reset-box">
        <h2>Reset Password</h2>

        <form action="/reset-password" method="POST">

            <label>Email</label>
            <input type="email" name="email" value="<%= email %>" required>

            <label>OTP</label>
            <input type="text" name="otp" placeholder="Enter received OTP" required>

            <label>New Password</label>
            <input type="password" name="newPassword" placeholder="Enter new password" required>

            <button type="submit">Reset Password</button>
        </form>

        <a href="/choose_login" class="back-link">⬅ Back to Login</a>
    </div>
</div>

</body>
</html>
