<%
  const outpassesSafe = Array.isArray(outpasses) ? outpasses : [];
  const roomQuerySafe = typeof roomQuery !== 'undefined' ? roomQuery : '';
  const userSafe = locals.session ? (locals.session.name || 'Security') : 'Security';
  const countSafe = typeof countToday !== 'undefined' ? countToday : outpassesSafe.length;
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <style>
    :root {
      --gold: #ffcc00;
      --glass: rgba(255, 255, 255, 0.07);
      --glass-border: rgba(255, 255, 255, 0.12);
      --success: #00ff88;
    }

    /* Container Wrap */
    .emergency-container {
      max-width: 1000px;
      margin: 0 auto;
      padding: 15px;
      animation: fadeIn 0.4s ease;
    }

    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }

    /* Header Styling */
    .emergency-header {
      background: var(--glass);
      backdrop-filter: blur(10px);
      border: 1px solid var(--glass-border);
      padding: 20px;
      border-radius: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      border-left: 5px solid var(--gold);
    }

    .header-left h1 { margin: 0; font-size: 1.4rem; color: var(--gold); letter-spacing: 1px; }
    .header-left p { margin: 5px 0 0; font-size: 0.85rem; opacity: 0.8; }
    .header-right { text-align: right; }
    .count-badge { background: var(--gold); color: #000; padding: 5px 12px; border-radius: 20px; font-weight: 800; font-size: 0.9rem; }

    /* Search Section */
    .search-section {
      margin-bottom: 25px;
    }

    .search-box {
      display: flex;
      background: var(--glass);
      border: 1px solid var(--glass-border);
      border-radius: 12px;
      padding: 5px;
      transition: 0.3s;
    }

    .search-box:focus-within { border-color: var(--gold); box-shadow: 0 0 15px rgba(255, 204, 0, 0.2); }

    .search-box input {
      flex: 1;
      background: transparent;
      border: none;
      padding: 12px 15px;
      color: white;
      font-size: 1rem;
      outline: none;
    }

    .search-box button {
      background: var(--gold);
      border: none;
      color: #000;
      padding: 0 20px;
      border-radius: 10px;
      cursor: pointer;
      font-weight: bold;
    }

    /* Table & Cards Logic */
    .outpass-list { width: 100%; }

    /* Desktop View */
    .desktop-table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0 8px;
      display: table;
    }

    .desktop-table th { padding: 15px; color: var(--gold); text-align: left; font-size: 0.9rem; text-transform: uppercase; }
    .desktop-table td { background: var(--glass); padding: 15px; border-top: 1px solid var(--glass-border); border-bottom: 1px solid var(--glass-border); }
    .desktop-table td:first-child { border-left: 1px solid var(--glass-border); border-radius: 12px 0 0 12px; }
    .desktop-table td:last-child { border-right: 1px solid var(--glass-border); border-radius: 0 12px 12px 0; }

    /* Mobile Cards (Hidden by default) */
    .mobile-card { display: none; }

    /* Status Tags */
    .tag {
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 0.75rem;
      font-weight: bold;
      background: rgba(0, 255, 136, 0.1);
      color: var(--success);
      border: 1px solid var(--success);
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      .desktop-table { display: none; }
      .mobile-card {
        display: block;
        background: var(--glass);
        border: 1px solid var(--glass-border);
        border-radius: 15px;
        padding: 15px;
        margin-bottom: 15px;
        position: relative;
        overflow: hidden;
      }
      .mobile-card::before { content: ""; position: absolute; left: 0; top: 0; height: 100%; width: 4px; background: var(--gold); }
      
      .card-row { display: flex; justify-content: space-between; margin-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 8px; }
      .card-row:last-child { border: none; margin-bottom: 0; }
      .label { font-size: 0.8rem; opacity: 0.6; text-transform: uppercase; }
      .value { font-size: 0.95rem; font-weight: 600; }
      
      .header-info { flex-direction: column; text-align: center; }
      .emergency-header { flex-direction: column; gap: 10px; text-align: center; border-left: none; border-top: 5px solid var(--gold); }
      .header-right { text-align: center; }
    }
  </style>
</head>
<body>

<div class="emergency-container">
  
  <div class="emergency-header">
    <div class="header-left">
      <h1>Emergency Outpasses</h1>
      <p>Security Portal | <%= userSafe %></p>
    </div>
    <div class="header-right">
      <div class="count-badge">Today: <%= countSafe %></div>
    </div>
  </div>

  <div class="search-section">
    <form action="/security/emergencyOutpasses" method="GET" class="search-box">
      <input type="text" name="room_no" placeholder="Search by Room Number..." value="<%= roomQuerySafe %>">
      <button type="submit"><i class="fas fa-search"></i></button>
    </form>
  </div>

  <div class="outpass-list">
    <% if (outpassesSafe.length === 0) { %>
      <div style="text-align: center; padding: 50px; background: var(--glass); border-radius: 15px; border: 1px dashed var(--glass-border);">
        <i class="fas fa-ghost fa-3x" style="color: var(--gold); margin-bottom: 15px;"></i>
        <p>No active emergency outpasses found.</p>
      </div>
    <% } else { %>
      
      <table class="desktop-table">
        <thead>
          <tr>
            <th>Student</th>
            <th>Room</th>
            <th>Reason</th>
            <th>Status</th>
            <th>Time</th>
          </tr>
        </thead>
        <tbody>
          <% outpassesSafe.forEach(op => { %>
            <tr>
              <td><i class="fas fa-user-circle" style="color: var(--gold)"></i> <strong><%= op.student_name || op.name %></strong></td>
              <td><%= op.room_no %></td>
              <td style="font-style: italic; opacity: 0.8;"><%= op.reason %></td>
              <td><span class="tag"><%= op.status %></span></td>
              <td><small><%= op.approved_at ? new Date(op.approved_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '-' %></small></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <% outpassesSafe.forEach(op => { %>
        <div class="mobile-card">
          <div class="card-row">
            <span class="label">Student</span>
            <span class="value" style="color: var(--gold)"><%= op.student_name || op.name %></span>
          </div>
          <div class="card-row">
            <span class="label">Room</span>
            <span class="value"><%= op.room_no %></span>
          </div>
          <div class="card-row">
            <span class="label">Reason</span>
            <span class="value" style="font-size: 0.85rem;"><%= op.reason %></span>
          </div>
          <div class="card-row">
            <span class="label">Time</span>
            <span class="value"><%= op.approved_at ? new Date(op.approved_at).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : '-' %></span>
          </div>
          <div class="card-row" style="border: none;">
            <span class="label">Status</span>
            <span class="tag"><%= op.status %></span>
          </div>
        </div>
      <% }) %>

    <% } %>
  </div>

</div>

</body>
</html>
