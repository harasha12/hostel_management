<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Security Registration</title>

<style>
body {
  margin: 0;
  padding: 0;
  height: 100vh;
  background: url("/images/hostel-bg.jpg") no-repeat center center fixed;
  background-size: cover;
  font-family: "Segoe UI", sans-serif;
}
.overlay {
  background: rgba(0,0,0,0.6);
  height: 100vh;
  backdrop-filter: blur(5px);
  display: flex;
  justify-content: center;
  align-items: center;
}
.form-box {
  width: 420px;
  background: rgba(255, 255, 255, 0.12);
  padding: 40px;
  border-radius: 16px;
  backdrop-filter: blur(15px);
  box-shadow: 0px 8px 25px rgba(0,0,0,0.4);
  text-align: center;
  animation: fadeIn 0.4s ease;
}
.form-box h2 {
  margin-bottom: 25px;
  color: #ffdd57;
  font-size: 28px;
  font-weight: bold;
  text-shadow: 1px 1px 4px #000;
}
label {
  display: block;
  text-align: left;
  font-weight: bold;
  margin-bottom: 6px;
  color: #fff;
}
input {
  width: 100%;
  padding: 12px;
  border-radius: 8px;
  border: 1px solid #ddd;
  margin-bottom: 16px;
  font-size: 15px;
}
button {
  width: 100%;
  background: #ffc107;
  border: none;
  padding: 12px;
  border-radius: 8px;
  font-size: 17px;
  font-weight: bold;
  cursor: pointer;
  color: #333;
  transition: 0.3s;
}
button:hover {
  background: #e0a800;
}
.back-link {
  display: block;
  margin-top: 15px;
  color: #ffdd57;
  font-size: 14px;
  text-decoration: none;
}
.back-link:hover {
  text-decoration: underline;
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-10px); }
  to   { opacity: 1; transform: translateY(0); }
}
</style>
</head>

<body>
<div class="overlay">
  <div class="form-box">
    <h2>Security Registration</h2>

    <form action="/register/security" method="POST">

      <label>Name:</label>
      <input type="text" name="name" required>

      <label>Email:</label>
      <input type="email" name="email" required>

      <label>Password:</label>
      <input type="password" name="password" required>

      <label>Hostel ID:</label>
      <input type="number" name="hostel_id" required>

      <button type="submit">Register</button>
    </form>

    <a class="back-link" href="/choose_login">← Back</a>
  </div>
</div>
</body>
</html>
