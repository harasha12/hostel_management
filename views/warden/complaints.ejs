<% if (!isSpa) { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Manage Complaints</title>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;800&display=swap" rel="stylesheet">
<% } %>

<style>
:root {
  --primary-dark: #162039;
  --primary-blue: #2853a0;
  --accent-gold: #f8d300;
  --soft-gray: #f4f6fb;
  --danger: #db3159;
  --success: #28bb75;
  --table-header: #22304c;
  --card-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

body {
  background-color: var(--soft-gray);
  font-family: 'Montserrat', sans-serif;
  margin: 0;
  padding: 0;
  overflow-x: hidden; 
}

.content-wrapper {
  padding: 15px;
  width: 100%; /* Full width */
  max-width: 1400px; /* Increased max-width for bigger screens */
  margin: auto;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 15px;
  padding: 25px; /* Increased padding */
  box-shadow: var(--card-shadow);
  width: 100%;
  box-sizing: border-box;
}

.page-title {
  color: var(--primary-dark);
  font-weight: 800;
  font-size: 1.6rem;
  margin-bottom: 5px;
  display: flex;
  align-items: center;
  gap: 10px;
}

.page-subtitle {
  color: #666;
  font-size: 0.9rem;
  margin-bottom: 25px;
}

/* TABLE STYLING */
.table-wrapper {
  width: 100%;
  overflow-x: auto; /* Desktop lo content ekkuvaithe scroll avvడానికి */
}

table {
  width: 100%;
  border-collapse: collapse;
}

thead th {
  background: var(--table-header);
  color: white;
  padding: 15px;
  text-align: left;
  font-size: 0.9rem;
  white-space: nowrap;
}

tbody td {
  padding: 15px;
  border-bottom: 1px solid #eee;
  font-size: 0.9rem;
  color: #333;
  word-break: break-word; /* Long text ని కట్ చేస్తుంది */
}

/* STATUS COLORS */
.status-badge { font-weight: 800; text-transform: uppercase; font-size: 0.75rem; }
.text-success { color: var(--success) !important; }
.text-danger { color: var(--danger) !important; }
.text-primary { color: var(--primary-blue) !important; }

/* ACTION FORM STYLING */
.action-form {
  display: flex;
  flex-wrap: wrap; /* Input content ని లోపలే ఉంచుతుంది */
  gap: 8px;
}
.action-form input, .action-form select {
  padding: 10px;
  border: 1px solid #ddd;
  border-radius: 6px;
  font-size: 0.85rem;
  flex: 1;
  min-width: 120px;
}
.action-form button {
  background: var(--primary-blue);
  color: white;
  border: none;
  padding: 10px 18px;
  border-radius: 6px;
  cursor: pointer;
  font-weight: 700;
}

/* MOBILE UI - FULL FIX FOR OUT OF BOX ISSUES */
@media screen and (max-width: 768px) {
  .content-wrapper { padding: 8px; }
  .card { padding: 15px; border-radius: 12px; }

  thead { display: none; } 
  
  table, tbody, tr, td { display: block; width: 100%; }

  tbody tr {
    background: #fff;
    border: 2px solid #f0f2f5;
    border-radius: 12px;
    margin-bottom: 20px;
    padding: 12px;
    box-sizing: border-box;
  }

  tbody td {
    display: block; /* Flex తీసేసి Block పెట్టాను */
    width: 100%;
    text-align: left; /* Left align is safer for mobile */
    padding: 8px 0;
    border-bottom: 1px solid #f9f9f9;
    box-sizing: border-box;
    position: relative;
  }

  tbody td::before {
    content: attr(data-label);
    display: block; /* Label ని పైన చూపిస్తుంది */
    font-weight: 800;
    color: var(--primary-blue);
    font-size: 0.7rem;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  /* Description and Reply sections */
  tbody td[data-label="Description"], 
  tbody td[data-label="Reply"] {
    background: #fcfcfc;
    padding: 10px;
    border-radius: 6px;
    margin: 5px 0;
  }
  
  tbody td[data-label="Action"] {
    border-bottom: none;
    padding-top: 15px;
  }

  .action-form {
    flex-direction: column;
    width: 100%;
  }
  
  .action-form input, .action-form select, .action-form button {
    width: 100%; /* Mobile లో అన్నీ ఫుల్ విడ్త్ */
  }
}

.back-dashboard {
  display: inline-block;
  margin-top: 25px;
  text-decoration: none;
  color: var(--primary-blue);
  font-weight: 700;
  font-size: 0.9rem;
}
</style>

<% if (!isSpa) { %>
<body>
  <%- include('../partials/header') %>
<% } %>

<div class="content-wrapper">
  <div id="message-container">
    <% if (typeof messages !== 'undefined' && messages.success) { %>
      <div class="message-box success"><i class="fas fa-check-circle"></i> <%= messages.success %></div>
    <% } %>
  </div>

  <div class="card">
    <h2 class="page-title"><i class="fas fa-bullhorn"></i> All Complaints</h2>
    <p class="page-subtitle">View and resolve student complaints in real-time.</p>

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Student</th>
            <th>Room</th>
            <th>Subject</th>
            <th>Description</th>
            <th>Status</th>
            <th>Reply</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (typeof complaints !== 'undefined' && complaints.length > 0) { %>
            <% complaints.forEach(c => { %>
              <% 
                let statusClass = 'text-danger'; 
                if (c.status === 'Resolved') statusClass = 'text-success';
                else if (c.status === 'Replied') statusClass = 'text-primary';
              %>
              <tr>
                <td data-label="Student"><strong><%= c.student_name %></strong></td>
                <td data-label="Room"><%= c.room_no %></td>
                <td data-label="Subject"><%= c.subject %></td>
                <td data-label="Description"><%= c.description %></td>
                <td data-label="Status">
                  <span class="status-badge <%= statusClass %>"><%= c.status %></span>
                </td>
                <td data-label="Reply"><%= c.reply || "No reply yet" %></td>
                <td data-label="Action">
                  <form action="/warden/complaints/<%= c.complaint_id %>/reply" method="POST" class="action-form">
                    <input type="text" name="reply" placeholder="Type your reply here..." required>
                    <select name="status">
                      <option value="Replied" <%= c.status === 'Replied' ? 'selected' : '' %>>Replied</option>
                      <option value="Resolved" <%= c.status === 'Resolved' ? 'selected' : '' %>>Resolved</option>
                    </select>
                    <button type="submit">Update</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="7" style="text-align: center; padding: 40px; color: #999;">No complaints found.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (!isSpa) { %>
    <div style="text-align:center;">
      <a href="/warden/dashboard" class="back-dashboard"><i class="fas fa-arrow-left"></i> Back to Dashboard</a>
    </div>
    <% } %>
  </div>
</div>

<script>
  // Auto hide messages
  setTimeout(() => {
    const msg = document.querySelector('.message-box');
    if (msg) msg.style.opacity = '0';
    setTimeout(() => { if(msg) msg.style.display = 'none'; }, 500);
  }, 4000);
</script>

<% if (!isSpa) { %>
  <%- include('../partials/footer') %>
</body>
</html>
<% } %>
