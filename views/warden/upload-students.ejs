<style>
:root{
  --primary:#3498db;
  --primary-dark:#2980b9;
  --success:#28a745;
  --danger:#e74c3c;
  --shadow:0 14px 40px rgba(0,0,0,0.12);
}

.upload-wrapper{
  max-width:520px;
  margin:40px auto;
  background:#fff;
  padding:34px 30px;
  border-radius:14px;
  box-shadow:var(--shadow);
  text-align:center;
}

.upload-wrapper h2{
  margin-bottom:20px;
  font-weight:900;
  color:#2c3e50;
}

label{
  display:block;
  text-align:left;
  font-weight:700;
  margin-bottom:8px;
}

input[type="file"]{
  width:100%;
  padding:10px;
  border-radius:8px;
  border:2px solid #dcdde1;
  margin-bottom:18px;
}

button{
  width:100%;
  padding:12px;
  border:none;
  border-radius:50px;
  background:var(--primary);
  color:#fff;
  font-size:1rem;
  font-weight:800;
  cursor:pointer;
  transition:.25s;
}

button:hover{
  background:var(--primary-dark);
  transform:scale(1.04);
}

.back-link{
  display:inline-block;
  margin-top:22px;
  font-weight:700;
  text-decoration:none;
  color:#2c3e50;
}

.back-link:hover{
  text-decoration:underline;
}

/* messages */
#message-container{
  position:fixed;
  top:20px;
  left:50%;
  transform:translateX(-50%);
  z-index:9999;
  width:90%;
  max-width:420px;
}

.message{
  padding:14px 18px;
  border-radius:10px;
  font-weight:700;
  color:#fff;
  margin-bottom:10px;
  animation:fade 4s forwards;
}

.success{ background:var(--success); }
.error{ background:var(--danger); }

@keyframes fade{
  0%{opacity:0;transform:translateY(-20px)}
  10%,90%{opacity:1;transform:none}
  100%{opacity:0;transform:translateY(-20px)}
}
</style>

<!-- 🔔 Messages -->
<div id="message-container">
  <% if (success) { %>
    <div class="message success">
      <i class="fas fa-check-circle"></i> <%= success %>
    </div>
  <% } %>

  <% if (error) { %>
    <div class="message error">
      <i class="fas fa-times-circle"></i> <%= error %>
    </div>
  <% } %>
</div>

<div class="upload-wrapper">

  <h2>📁 Upload Student Details</h2>

  <form action="/warden/upload-students" method="POST" enctype="multipart/form-data">
    <label>Select Excel / CSV File</label>
    <input type="file" name="studentsFile" accept=".xlsx,.csv" required>

    <button type="submit">
      <i class="fas fa-upload"></i> Upload Students
    </button>
  </form>

  <a href="/warden/dashboard" class="back-link">
    ⬅ Back to Dashboard
  </a>
</div>

<script>
setTimeout(()=>{
  document.querySelectorAll('.message').forEach(m=>m.remove());
},4000);
window.scrollTo({top:0,behavior:"smooth"});
</script>
