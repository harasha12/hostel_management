<script>
async function spaNavigate(e, url) {
  e.preventDefault();

  const link = e.currentTarget;
  const title = link.querySelector('.nav-label')?.innerText.trim();
  
  const miniHeader = document.getElementById('miniHeader');
  const collegeHeader = document.querySelector('.college-header');
  const content = document.getElementById('content-container'); // dynamic content

  // loading state
  content.innerHTML = `<div style="padding:40px;text-align:center;color:#ffd600;">
    <i class="fas fa-spinner fa-spin fa-2x"></i><br><br>Loading...
  </div>`;

  const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
  const html = await res.text();
  collegeHeader.style.display = "flex";

  // show mini-header
  if (title) {
    miniHeader.innerText = title;

    if (url === "/warden/dashboard") {
        miniHeader.style.display = "none";
    } else {
        miniHeader.style.display = "block";
    }
}

  // hide big header
  

  // inject page
  content.innerHTML = html;
  if (typeof initMarkAttendanceSPA === "function") {
  initMarkAttendanceSPA();}

  history.pushState({}, '', url);

  // close sidebar mobile-only
  if (window.innerWidth <= 820 && typeof closeSidebar === "function") {
    closeSidebar();
  }
}

window.onpopstate=()=>location.reload();
</script>
<script>
/* ========= MARK ATTENDANCE – SPA SAFE ========= */

document.addEventListener('change', function (e) {

  if (e.target && e.target.id === 'blockSelect') {

    const form = document.getElementById('filterForm');
    const roomSelect = document.getElementById('roomSelect');

    if (!form || !roomSelect) return;

    const roomsByBlock = JSON.parse(form.dataset.rooms || '{}');
    const selectedBlock = e.target.value;

    console.log("BLOCKS FROM DB:", Object.keys(roomsByBlock));
    console.log("SELECTED BLOCK:", selectedBlock);

    roomSelect.innerHTML = '<option value="">Room</option>';

    if (selectedBlock && roomsByBlock[selectedBlock]) {
      console.log("ROOMS FOR BLOCK:", roomsByBlock[selectedBlock]);

      roomsByBlock[selectedBlock].forEach(room => {
        const opt = document.createElement('option');
        opt.value = room;
        opt.textContent = room;
        roomSelect.appendChild(opt);
      });
    } else {
      console.log("ROOMS FOR BLOCK: []");
    }
  }

});
</script>
<script>
if (
  location.pathname.startsWith('/warden/') &&
  location.pathname !== '/warden/dashboard'
) {
  fetch('/warden/dashboard', { method: 'HEAD' })
    .then(res => {
      if (res.redirected) {
        window.location.replace(res.url);
      } else {
        window.location.replace('/warden/dashboard');
      }
    });
}

</script>
<script>
async function updateOutpass(id, action, btn) {
  btn.disabled = true;
  btn.innerText = '...';

  const res = await fetch(`/warden/approveOutpass/${id}/${action}`, {
    method: 'POST',
    headers: {
      'X-Requested-With': 'XMLHttpRequest'
    }
  });

  const data = await res.json();

  if (data.success) {
    const card = btn.closest('.mobile-card') || btn.closest('tr');

    // update status badge
    const badge = card.querySelector('.status-badge');
    badge.innerText = data.status;
    badge.className = `status-badge ${data.status.toLowerCase()}`;

    // remove action buttons
    const actions = card.querySelector('.mobile-actions') || btn.parentElement;
    if (actions) actions.remove();
  } else {
    alert('Action failed');
    btn.disabled = false;
    btn.innerText = action;
  }
}
</script>
<script>
async function handleOutpass(id, action, btn) {

  // 🔒 Find parent container
  const container = btn.closest('tr') || btn.closest('.mobile-card');

  // 🔒 Disable ALL buttons immediately
  const allButtons = container.querySelectorAll('button');
  allButtons.forEach(b => {
    b.disabled = true;
    b.style.opacity = '0.6';
    b.style.cursor = 'not-allowed';
  });

  btn.innerText = '...';

  try {
    const res = await fetch(`/warden/approveOutpass/${id}/${action}`, {
      method: 'POST',
      headers: {
        'X-Requested-With': 'XMLHttpRequest'
      }
    });

    const data = await res.json();

    if (!data.success) throw new Error('Failed');

    // ✅ Update status badge
    const badge = container.querySelector('.status-badge');
    badge.innerText = data.status;
    badge.className = `status-badge ${data.status.toLowerCase()}`;

    // 🧹 Remove action area completely
    const actions =
      container.querySelector('.mobile-actions') ||
      container.querySelector('td:last-child');

    if (actions) actions.innerHTML = '—';

  } catch (err) {
    alert('Action failed. Try again.');

    // ❌ Re-enable buttons ONLY if failed
    allButtons.forEach(b => {
      b.disabled = false;
      b.style.opacity = '1';
      b.style.cursor = 'pointer';
    });

    btn.innerText = action;
  }
}
</script>

</body>
