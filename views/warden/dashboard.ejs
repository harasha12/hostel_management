<%
  const noticeData = typeof latestNotice !== "undefined" ? latestNotice : null;
  let showNotice = false;
  let noticeTime = null;
  let isNew = false;

  if (noticeData) {
    noticeTime = new Date(noticeData.created_at);
    const now = new Date();
    const hoursDiff = Math.abs(now - noticeTime) / 36e5;
    isNew = hoursDiff <= 24;
    showNotice = true;
  }
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>Warden Dashboard</title>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>

<style>
:root {
  --accent-gold:#ffd600;
  --sidebar-width:290px;
  --sidebar-collapsed:60px;
}

html,
body{
    margin:0;
    height:100%;
    overflow:hidden; 
     overflow-y:auto;  /* Page scroll off */
}

body{
    font-family:"Segoe UI",Arial,sans-serif;
    background:
        linear-gradient(rgba(0,0,0,.70),rgba(0,0,0,.70)),
        url('/images/hostel-bg.jpg') no-repeat center center fixed;
    background-size:cover;
    color:#fff;
}

.bg-layer{
    position:fixed;
    inset:0;
    background:transparent;
    backdrop-filter:none;
    z-index:-1;
}

/* HEADER */
.college-header{
    display:flex;
    justify-content:center;
    align-items:center;
    padding:12px 20px;   /* 25px -> 12px */

    background:linear-gradient(90deg,#0a1a3f 0%,#153b6f 60%,#1a1a1a 100%);

    border-bottom:3px solid rgba(0,0,0,.4);
    box-shadow:0 4px 20px rgba(0,0,0,.6);
}

.college-header-inner{
    display:flex;
    align-items:center;
    gap:12px;            /* 16px -> 12px */
}

.college-header img{
    height:55px;         /* 70px -> 55px */
    border-radius:6px;
}

.header-text{
    text-align:center;
}

.header-text h2{
    margin:0;
    color:#fff;
    font-size:1.15rem;   /* smaller */
    text-shadow:2px 2px 4px #000;
}

.header-text p{
    margin:3px 0 0;
    color:#f0f0f0;
    font-size:0.75rem;   /* smaller */
    line-height:1.3;
}

.compact-title{
    display:none;
}
/* LAYOUT */
.dashboard{
    display:flex;
    height:calc(100vh - 130px);
    overflow:hidden;
}

/* SIDEBAR */
.sidebar{
    width:var(--sidebar-width);

    background:linear-gradient(180deg,#0d1b4c,#12306b);

    box-shadow:4px 0 10px rgba(0,0,0,.4);

    display:flex;
    flex-direction:column;

    overflow-y:auto;
    overflow-x:hidden;

    height:calc(100vh - 130px);
}


.sidebar.collapsed {
  width:var(--sidebar-collapsed);
}

#toggleBtn {
  height:42px;
  margin:6px;
  border:none;
  border-radius:6px;
  background:rgba(255,255,255,0.08);
  color:var(--accent-gold);
  cursor:pointer;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:18px;
}

/* NAV ITEMS */
.nav {
  margin-top:8px;
  display:flex;
  flex-direction:column;
  gap:4px;
}
.nav-item {
  display:flex;
  align-items:center;
  gap:12px;
  padding:12px 16px;
  color:white;
  font-size:15px;
  text-decoration:none;
  border-radius:6px;
  transition:0.2s;
  white-space:nowrap;
}
.nav-item i {
  font-size:19px;
  min-width:22px;
  text-align:center;
}
.nav-item:hover {
  background:rgba(255,255,255,0.15);
  color:var(--accent-gold);
}

.sidebar.collapsed .nav-label {
  display:block;
  font-size:10px;
  margin-top:4px;
  text-align:center;
  opacity:0.9;
}


.sidebar.collapsed .nav-item {
  flex-direction:column;
  gap:2px;
  justify-content:center;
  padding:10px 0;
}


/* TOOLTIP WHEN COLLAPSED */
.nav-item[data-tip] {
  position:relative;
}
.sidebar.collapsed .nav-item:hover::after {
  content:attr(data-tip);
  position:absolute;
  left:calc(100% + 10px);
  top:50%;
  transform:translateY(-50%);
  background:black;
  color:white;
  padding:4px 6px;
  border-radius:4px;
  font-size:11px;
  white-space:nowrap;
}

/* LOGOUT */
.logout{
    padding:12px;
    flex-shrink:0;
}
.logout a {
  display:flex;
  align-items:center;
  gap:10px;
  padding:10px 12px;
  border:1px solid var(--accent-gold);
  border-radius:6px;
  color:var(--accent-gold);
  text-decoration:none;
  font-size:14px;
}
.logout a i { font-size:17px; }
.sidebar.collapsed .logout a span { display:none; }

/* MAIN */
.main{

    flex:1;

    min-width:0;

    padding:24px;

    overflow-y:auto;

    overflow-x:hidden;
     min-height:calc(100vh - 165px);

    
}

.welcome h1 {
  color:var(--accent-gold);
  text-align:center;
  margin-bottom:12px;
  font-size:24px;
}

/* CARDS */
.metrics {
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
  gap:18px;
}
.sidebar{
    width:var(--sidebar-width);

    background:linear-gradient(180deg,#0d1b4c,#12306b);

    box-shadow:4px 0 10px rgba(0,0,0,.4);

    display:flex;
    flex-direction:column;

    overflow-y:auto;
    overflow-x:hidden;

    height:100%;
}
.card .icon {
  font-size:30px;
  color:var(--accent-gold);
  margin-bottom:6px;
}
.card .num {
  font-size:22px;
  font-weight:700;
}
.card .label {
  font-size:0.85rem;
  color:#ddd;
}

/* TABLE */
.table-section {
  margin-top:20px;
}
.table-title {
  font-size:16px;
  font-weight:600;
  margin-bottom:10px;
}
table{
    width:100%;
    border-collapse:collapse;

    background:rgba(255,255,255,.10);

    backdrop-filter:blur(5px);

    border-radius:12px;

    overflow:hidden;
}
thead th{
    color:#FFD700;
}
tbody td{
    color:#fff;
    border-top:1px solid rgba(255,255,255,.15);
}

/* MOBILE */

.notification-banner {
  width: 100%;
  background: linear-gradient(90deg, rgba(255,214,0,0.92), rgba(255,214,0,0.85));
  color: black;
  font-weight: 700;
  padding: 10px 0;
  margin-bottom: 10px;
  font-size: 0.95rem;
  overflow: hidden;
  border-bottom: 2px solid rgba(0,0,0,0.25);
  white-space: nowrap;
}

.scrolling-text {
  display: inline-block;
  padding-left: 100%;
  animation: scroll-left 15s linear infinite;
}

@keyframes scroll-left {
  to { transform: translateX(-100%); }
}

/* mobile adjustments */
@media (max-width: 768px) {
  .notification-banner {
    font-size: 0.85rem;
    padding: 8px 0;
  }
}

.nav-label {
  max-width:100%;
  white-space:normal;       /* 👈 allows wrapping */
  word-break:break-word;    /* 👈 splits big words */
  line-height:1.15;
  margin-top:2px;
}
.sidebar {
  overflow-y: auto;     /* 👈 vertical scroll */
  overflow-x: hidden;   /* 👈 horizontal avoid */
  scrollbar-width: thin; /* firefox thin scrollbar */
}
.sidebar::-webkit-scrollbar {
  width: 6px;
}

.sidebar::-webkit-scrollbar-track {
  background: rgba(255,255,255,0.05);
  border-radius: 4px;
}

.sidebar::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,0.25);
  border-radius: 4px;
}
@media(max-width:820px){
  .sidebar {
    max-height: 100vh;
  }
}
.mini-header {
  width:100%;
  padding:12px 14px;
  margin-bottom:12px;
  background:rgba(0,0,0,0.50);
  backdrop-filter:blur(6px);
  border-left:4px solid var(--accent-gold);
  font-size:1.05rem;
  font-weight:600;
  color:var(--accent-gold);
  text-transform:uppercase;
}
/* =========================
   MOBILE UI – FIXED VERSION
   ========================= */
@media (max-width: 768px) {

  /* ---- layout fix ---- */
  body {
    overflow-x: hidden;
  }

  .dashboard {
    min-height: auto;
  }

  /* ---- sidebar visible ---- */
  .sidebar {
    width: 72px;
    flex-shrink: 0;
  }

  .sidebar.collapsed {
    width: 60px;
  }

  #toggleBtn {
    display: flex;
  }

  /* ---- nav items (mobile only) ---- */
  .nav-item {
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 8px 4px;
    font-size: 11px;
  }

  .nav-item i {
    font-size: 18px;
    min-width: unset;
  }

  .nav-label {
    font-size: 10px;
    line-height: 1.1;
    text-align: center;
    white-space: normal;
    word-break: break-word;
  }

  /* ---- main dashboard ---- */
  .main {
    padding: 14px 10px;
  }

  .welcome h1 {
    font-size: 18px;
  }

  /* ---- cards ---- */
  .metrics {
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .card {
    padding: 12px;
  }

  .card .icon {
    font-size: 22px;
  }

  .card .num {
    font-size: 17px;
  }

  /* ---- table ---- */
  .table-section {
    overflow-x: auto;
  }

  table {
    min-width: 620px;
    font-size: 12px;
  }

  /* ---- header compact ---- */
  .college-header img {
    height: 44px;
  }

  .header-text h2 {
    font-size: 0.8rem;
  }

  .header-text p {
    display: none;
  }
}
/* =========================
   MOBILE MAIN WIDTH FIX
   ========================= */
@media (max-width: 768px) {

  .dashboard {
    width: 100vw;
    overflow-x: hidden;
  }

  .main {
    width: calc(100vw - 72px); /* sidebar width */
    max-width: calc(100vw - 72px);
  }

  .metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

}



</style>
</head>
