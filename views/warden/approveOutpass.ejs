<% if (!isSpa) { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Approve Outpass</title>
<% } %>

<style>
  :root {
    --bg-dark: rgba(0, 0, 0, 0.55);
    --card-bg: rgba(255, 255, 255, 0.08);
    --accent-gold: #ffcc00;
    --success: #28bb75;
    --danger: #db3159;
    --text-light: #ffffff;
  }

  body {
    background-color: #1a1a1a;
    font-family: "Segoe UI", Arial, sans-serif;
    color: var(--text-light);
    margin: 10px;
  }

  .outpass-heading {
    color: var(--accent-gold);
    text-align: center;
    margin-bottom: 20px;
    text-shadow: 1px 1px 4px #000;
  }

  /* DESKTOP TABLE STYLE */
  .outpass-table-wrap {
    background: var(--bg-dark);
    border-radius: 12px;
    overflow-x: auto;
    box-shadow: 0 8px 20px rgba(0,0,0,0.4);
  }

  .outpass-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
  }

  .outpass-table th, .outpass-table td {
    padding: 12px;
    text-align: center;
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  /* 📱 MOBILE SLIDING AREA */
  @media (max-width: 820px) {
    .desktop-table { display: none; }

    .mobile-cards-container {
      height: 70vh;              /* Fixed height for sliding */
      overflow-y: auto;          /* Vertical scroll enabled */
      padding: 5px;
      scrollbar-width: thin;     /* Firefox scrollbar */
      -webkit-overflow-scrolling: touch; /* Smooth scroll for iOS */
      display: flex;
      flex-direction: column;
      gap: 15px;
    }

    /* Track/Scrollbar styling */
    .mobile-cards-container::-webkit-scrollbar {
      width: 4px;
    }
    .mobile-cards-container::-webkit-scrollbar-thumb {
      background: var(--accent-gold);
      border-radius: 10px;
    }

    .mobile-card {
      background: var(--card-bg);
      border: 1px solid rgba(255,255,255,0.1);
      border-left: 5px solid #3b82f6;
      padding: 15px;
      border-radius: 12px;
      position: relative;
    }

    .mobile-card.pending-border { border-left-color: var(--accent-gold); }
    .mobile-card.resolved-border { border-left-color: var(--success); }

    .card-row {
      display: flex;
      justify-content: space-between;
      margin-bottom: 6px;
      font-size: 0.9rem;
    }

    .card-label { color: var(--accent-gold); font-weight: bold; }

    .mobile-actions {
      display: flex;
      gap: 10px;
      margin-top: 12px;
      border-top: 1px solid rgba(255,255,255,0.1);
      padding-top: 10px;
    }

    .btn-action {
      flex: 1;
      padding: 10px;
      border: none;
      border-radius: 8px;
      font-weight: bold;
      cursor: pointer;
    }
  }

  .status-badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: bold;
  }
  .pending { background: var(--accent-gold); color: #000; }
  .approved { background: var(--success); color: #fff; }
  .rejected { background: var(--danger); color: #fff; }

  .btn-approve { background: var(--success); color: white; }
  .btn-reject { background: var(--danger); color: white; }
  
  .back-link {
    display: inline-block;
    margin-top: 20px;
    color: var(--accent-gold);
    text-decoration: none;
    font-weight: bold;
  }
</style>

<div class="outpass-container">
  <h2 class="outpass-heading">Outpass Requests</h2>

  <div class="outpass-table-wrap desktop-table">
    <table class="outpass-table">
      <thead>
        <tr>
          <th>Student ID</th>
          <th>Name</th>
          <th>Type</th>
          <th>Dates</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <% outpasses.forEach(op => { %>
        <tr>
          <td><%= op.student_id %></td>
          <td><%= op.name %></td>
          <td><%= op.outpass_type %></td>
          <td><%= op.out_date.toISOString().split('T')[0] %> to <%= op.return_date.toISOString().split('T')[0] %></td>
          <td><span class="status-badge <%= op.status.toLowerCase() %>"><%= op.status %></span></td>
          <td>
            <% if (op.status === 'Pending') { %>
              <div style="display:flex; gap:5px; justify-content:center;">
                <form action="/warden/approveOutpass/<%= op.outpass_id %>/approve" method="POST"><button class="btn-action btn-approve" onclick="updateOutpass('<%= op.outpass_id %>', 'approve', this)">✔</button></form>
                <form action="/warden/approveOutpass/<%= op.outpass_id %>/reject" method="POST"><button class="btn-action btn-reject" onclick="updateOutpass('<%= op.outpass_id %>', 'reject', this)">✖</button></form>
              </div>
            <% } else { %> - <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

<div class="mobile-cards-container">
  <% outpasses.forEach(op => { %>
  <div class="mobile-card <%= op.status === 'Pending' ? 'pending-border' : 'resolved-border' %>">
    <div class="card-row">
      <span class="card-label">Student</span>
      <span class="card-value"><%= op.name %> (<%= op.student_id %>)</span>
    </div>
    <div class="card-row">
      <span class="card-label">Type</span>
      <span class="card-value"><%= op.outpass_type %></span>
    </div>
    <div class="card-row">
      <span class="card-label">Reason</span>
      <span class="card-value"><%= op.reason %></span>
    </div>
    
    <div class="card-row">
      <span class="card-label">Out Date</span>
      <span class="card-value"><%= op.out_date.toISOString().split('T')[0] %></span>
    </div>
    <div class="card-row">
      <span class="card-label">Return Date</span>
      <span class="card-value"><%= op.return_date.toISOString().split('T')[0] %></span>
    </div>

    <div class="card-row">
      <span class="card-label">Status</span>
      <span class="status-badge <%= op.status.toLowerCase() %>"><%= op.status %></span>
    </div>

    <% if (op.status === 'Pending') { %>
    <div class="mobile-actions">
      <form action="/warden/approveOutpass/<%= op.outpass_id %>/approve" method="POST" style="flex:1;">
        <button class="btn-action btn-approve"
        onclick="updateOutpass('<%= op.outpass_id %>', 'approve', this)">
  Approve
</button>
      </form>
      <form action="/warden/approveOutpass/<%= op.outpass_id %>/reject" method="POST" style="flex:1;">
        <button class="btn-action btn-reject" onclick="updateOutpass('<%= op.outpass_id %>', 'reject', this)">Reject</button>
      </form>
    </div>
    <% } %>
  </div>
  <% }) %>
</div>

  <% if (!isSpa) { %>
    <a href="/warden/dashboard" class="back-link">← Back to Dashboard</a>
  <% } %>
</div>

<% if (!isSpa) { %>
</body>
</html>
<% } %>
