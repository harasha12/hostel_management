<style>
:root{
  --accent:#1e40af;
  --muted:#6b7280;
  --bg:#f8fafc;
  --card:#ffffff;
  --paid:#16a34a;
  --due:#dc2626;
}

.profile-wrapper{
  max-width:1100px;
  margin:30px auto;
  background:var(--card);
  padding:26px;
  border-radius:14px;
  box-shadow:0 12px 35px rgba(0,0,0,.08);
}

h2,h3{
  text-align:center;
  color:#1f2937;
  margin-bottom:16px;
}

table{
  width:100%;
  border-collapse:collapse;
  margin-top:16px;
}

th,td{
  padding:12px 14px;
  border-bottom:1px solid #e5e7eb;
}

th{
  background:#f3f4f6;
  text-align:left;
  width:260px;
}

.fee-table th{
  background:linear-gradient(135deg,#2563eb,#1e40af);
  color:#fff;
  text-align:center;
}

.fee-table td{
  text-align:center;
}

.paid{ color:var(--paid); font-weight:700; }
.due{ color:var(--due); font-weight:700; }

.badge{
  padding:4px 10px;
  border-radius:999px;
  font-weight:700;
  font-size:13px;
}

.badge.success{ background:#dcfce7; color:#166534; }
.badge.warn{ background:#fff7ed; color:#9a3412; }
.badge.danger{ background:#fee2e2; color:#991b1b; }

.actions{
  display:flex;
  justify-content:space-between;
  margin-top:24px;
}

.btn{
  padding:10px 18px;
  border-radius:8px;
  font-weight:700;
  text-decoration:none;
  border:none;
  cursor:pointer;
}

.btn.primary{
  background:linear-gradient(135deg,#2563eb,#1e40af);
  color:#fff;
}

.btn.secondary{
  background:#e5e7eb;
  color:#111827;
}

.modal{
  position:fixed;
  inset:0;
  background:rgba(0,0,0,.5);
  display:none;
  align-items:center;
  justify-content:center;
  z-index:2000;
}

.modal-content{
  background:#fff;
  padding:18px;
  border-radius:12px;
  position:relative;
}

.modal-content img{
  max-width:420px;
  border-radius:8px;
}

.close{
  position:absolute;
  top:8px;
  right:12px;
  font-size:22px;
  cursor:pointer;
}
.btn.danger{
    background:#dc2626;
    color:#fff;
}
.btn.danger{

    background:#dc2626;

    color:white;

}

.btn.danger:hover{

    background:#b91c1c;

}
</style>

<div class="profile-wrapper">

  <h2>🎓 Student Profile</h2>

  <!-- BASIC DETAILS -->
  <table>
    <tr><th>Name</th><td><%= student.name %></td></tr>
    <tr><th>Father Name</th><td><%= student.father_name || '-' %></td></tr>
    <tr><th>Student ID</th><td><%= student.student_id %></td></tr>
    <tr><th>Unique ID</th><td><%= student.student_unique_id || '-' %></td></tr>
    <tr><th>Email</th><td><%= student.email %></td></tr>
    <tr><th>Room No</th><td><%= student.room_no || '-' %></td></tr>
    <tr><th>Course</th><td><%= student.course || '-' %></td></tr>
    <tr><th>Year</th><td><%= student.year || '-' %></td></tr>
    <tr><th>Year of Join</th><td><%= student.year_of_join || '-' %></td></tr>
    <tr>
      <th>Attendance</th>
      <td>
        <% if(attendanceSummary.total_classes > 0){ %>
          <%= ((attendanceSummary.present_count / attendanceSummary.total_classes)*100).toFixed(2) %>%
        <% } else { %> 0% <% } %>
      </td>
    </tr>
    <tr>
      <th>Student Aadhaar</th>
      <td>
        <% if(student.student_aadhaar){ %>
          **** **** **** <%= student.student_aadhaar.slice(-4) %>
          <button class="btn secondary" onclick="viewAadhaar('<%= student.student_id %>','student')">View</button>
        <% } else { %> Not uploaded <% } %>
      </td>
    </tr>
    <tr>
      <th>Father Aadhaar</th>
      <td>
        <% if(student.father_aadhaar){ %>
          **** **** **** <%= student.father_aadhaar.slice(-4) %>
          <button class="btn secondary" onclick="viewAadhaar('<%= student.student_id %>','father')">View</button>
        <% } else { %> Not uploaded <% } %>
      </td>
    </tr>
  </table>

  <!-- FEE SUMMARY -->
  <h3>💰 Academic Fee Summary</h3>

  <table class="fee-table">
    <thead>
      <tr>
        <th>Year</th>
        <th>Room Rent</th>
        <th>Mess-1</th>
        <th>Mess-2</th>
        <th>Total</th>
        <th>Paid</th>
        <th>Due</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
  <% if (!feeSummary || feeSummary.length === 0) { %>
    <tr>
      <td colspan="8">No payments yet</td>
    </tr>
  <% } else { %>
    <% feeSummary.forEach(f => { 
      const year = f.academic_year || f.year;
      const room = Number(f.room_rent || 0);
      const mess1 = Number(f.mess_bill1 || 0);
      const mess2 = Number(f.mess_bill2 || 0);
      const total = Number(f.total_fee || (room + mess1 + mess2));
      const paid = Number(f.paid_amount || f.total_paid || 0);
      const due  = Number(f.due_amount || (total - paid));
    %>
      <tr>
        <td><%= year %></td>
        <td>₹<%= room.toFixed(2) %></td>
        <td>₹<%= mess1.toFixed(2) %></td>
        <td>₹<%= mess2.toFixed(2) %></td>
        <td>₹<%= total.toFixed(2) %></td>
        <td class="paid">₹<%= paid.toFixed(2) %></td>
        <td class="due">₹<%= due.toFixed(2) %></td>
        <td>
          <% if (due <= 0) { %>
            <span class="badge success">Paid</span>
          <% } else if (paid > 0) { %>
            <span class="badge warn">Partial</span>
          <% } else { %>
            <span class="badge danger">Pending</span>
          <% } %>
        </td>
      </tr>
    <% }) %>
  <% } %>
</tbody>

  </table>
  <hr>

<h3>Student Actions</h3>

<% if(student.status === "ACTIVE"){ %>



<% } else if(student.status === "VACATED"){ %>

<span class="badge warn">

Student Already Vacated

</span>

<% } else { %>

<span class="badge danger">

Passed Out Student

</span>

<% } %>

  <div class="actions">

    <div>
        <% if(student.status === 'ACTIVE'){ %>

            <button class="btn danger"
                    onclick="vacateStudent('<%= student.student_id %>')">
                🏠 Vacate Student
            </button>

        <% } else if(student.status === 'VACATED'){ %>

            <span class="badge warn">Vacated</span>

        <% } else if(student.status === 'PASSED_OUT'){ %>

            <span class="badge danger">Passed Out</span>

        <% } %>
    </div>

    <div>
        <a href="/warden/dashboard" class="btn secondary">
            ⬅ Dashboard
        </a>

        <a href="javascript:history.back()" class="btn primary">
            ⬅ Back
        </a>
    </div>

</div>

</div>

<!-- Aadhaar Modal -->
<div id="aadhaarModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeModal()">&times;</span>
    <img id="aadhaarImage">
  </div>
</div>

<script>
function viewAadhaar(id,type){
  document.getElementById('aadhaarImage').src = `/student/aadhaar/${type}/${id}`;
  document.getElementById('aadhaarModal').style.display='flex';
}
function closeModal(){
  document.getElementById('aadhaarModal').style.display='none';
}
window.scrollTo({top:0,behavior:"smooth"});
function vacateStudent(studentId){

    if(!confirm("Are you sure you want to vacate this student?")){
        return;
    }

    fetch("/warden/student/vacate/" + studentId,{
        method:"POST"
    })
    .then(r=>r.json())
    .then(data=>{

        alert(data.message);

        location.reload();

    });

}
function vacateStudent(studentId){

    if(!confirm("Are you sure you want to vacate this student?")){
        return;
    }

    fetch("/warden/student/vacate/" + studentId,{
        method:"POST"
    })
    .then(res=>res.json())
    .then(data=>{

        alert(data.message);

        if(data.success){

            location.reload();

        }

    });

}
</script>
