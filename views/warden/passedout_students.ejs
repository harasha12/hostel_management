<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Passed Out Students</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<style>

*{
    box-sizing:border-box;
}

body{
    font-family:Arial,sans-serif;
    background:#182235;
    margin:0;
    padding:30px;
}

.container{
    max-width:1200px;
    margin:auto;
    background:#fff;
    padding:25px;
    border-radius:12px;
    box-shadow:0 10px 25px rgba(0,0,0,.2);
}

h2{
    text-align:center;
    margin-bottom:20px;
}

.top-bar{
    display:flex;
    justify-content:flex-start;
    margin-bottom:20px;
}

.back-btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:10px 18px;
    background:#2563eb;
    color:#fff;
    text-decoration:none;
    border-radius:10px;
    font-weight:600;
    transition:.3s;
}

.back-btn:hover{
    background:#1d4ed8;
}

.search{
    margin-bottom:20px;
}

.search form{
    display:flex;
    justify-content:center;
    gap:10px;
    flex-wrap:wrap;
}

.search input{
    padding:10px;
    width:300px;
    border:1px solid #ccc;
    border-radius:8px;
}

.search button{
    padding:10px 20px;
    background:#1e40af;
    color:#fff;
    border:none;
    border-radius:8px;
    cursor:pointer;
}

.table-wrapper{
    width:100%;
    overflow-x:auto;
}

table{
    width:100%;
    min-width:750px;
    border-collapse:collapse;
}

th{
    background:#1e40af;
    color:#fff;
    padding:12px;
}

td{
    padding:10px;
    border-bottom:1px solid #ddd;
    text-align:center;
}

img{
    width:60px;
    height:60px;
    border-radius:50%;
    object-fit:cover;
}

.btn{
    display:inline-block;
    background:#16a34a;
    padding:8px 15px;
    text-decoration:none;
    color:#fff;
    border-radius:6px;
    white-space:nowrap;
}

.btn:hover{
    background:#15803d;
}

/* ================= MOBILE ================= */

@media(max-width:768px){

body{
    padding:12px;
}

.container{
    width:100%;
    padding:15px;
}

.top-bar{
    margin-bottom:15px;
}

.back-btn{
    width:100%;
    justify-content:center;
}

h2{
    font-size:22px;
}

.search form{
    flex-direction:column;
}

.search input{
    width:100%;
}

.search button{
    width:100%;
}

table{
    min-width:700px;
}

th,
td{
    font-size:14px;
    padding:10px 8px;
}

img{
    width:50px;
    height:50px;
}

.btn{
    font-size:13px;
    padding:8px 12px;
}

}

</style>

</head>

<body>

<div class="container">

<div class="top-bar">
<a href="/warden/dashboard" class="back-btn">
<i class="fas fa-arrow-left"></i> Back to Dashboard
</a>
</div>

<h2>🎓 Passed Out Students</h2>

<div class="search">

<form method="GET">

<input
type="text"
name="search"
placeholder="Search Student"
value="<%=search%>">

<button type="submit">
Search
</button>

</form>

</div>

<div class="table-wrapper">

<table>

<tr>
<th>Photo</th>
<th>Student ID</th>
<th>Name</th>
<th>Course</th>
<th>Year</th>
<th>Room</th>
<th>Action</th>
</tr>

<% students.forEach(student=>{ %>

<tr>

<td>
<img src="<%= student.profile_image ? '/uploads/profile_images/'+student.profile_image : '/images/default-avatar.png' %>">
</td>

<td><%=student.student_id%></td>

<td><%=student.name%></td>

<td><%=student.course%></td>

<td><%=student.year%></td>

<td><%=student.room_no || "-"%></td>

<td>
<a
class="btn"
href="/warden/student/<%=student.student_id%>">
View Profile
</a>
</td>

</tr>

<% }) %>

</table>

</div>

</div>

</body>
</html>