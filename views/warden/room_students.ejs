<style>
:root{
  --accent:#2c3e50;
  --accent-2:#3498db;
  --success:#28a745;
  --warning:#e67e22;
  --danger:#e74c3c;
  --muted:#6b7280;
}

.room-wrapper{
  max-width:1200px;
  margin:auto;
  background:#fff;
  padding:22px;
  border-radius:14px;
  box-shadow:0 10px 30px rgba(0,0,0,.08);
}

.header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  margin-bottom:20px;
}

.header h2{
  margin:0;
  color:var(--accent);
}

.back-btn{
  background:#6c757d;
  color:#fff;
  padding:8px 14px;
  border-radius:8px;
  text-decoration:none;
  font-weight:600;
}

table{
  width:100%;
  border-collapse:collapse;
  margin-top:10px;
}

th{
  background:var(--accent);
  color:#fff;
  padding:12px;
  font-size:13px;
  text-align:center;
}

td{
  padding:10px;
  text-align:center;
  border-bottom:1px solid #eee;
}

tr:hover{ background:#f9f9f9; }

.status-paid{ color:var(--success); font-weight:700; }
.status-due{ color:var(--warning); font-weight:700; }

.view-btn{
  background:var(--accent-2);
  color:#fff;
  padding:5px 10px;
  border-radius:6px;
  text-decoration:none;
  font-size:13px;
}

.summary{
  margin-top:14px;
  text-align:right;
  font-weight:600;
  color:var(--muted);
}

/* Mobile */
@media(max-width:820px){
  table{ font-size:13px; }
  th,td{ padding:8px; }
}
</style>

<div class="room-wrapper">

  <div class="header">
    <h2>🏠 Room <%= room_no %> – Students Overview</h2>
    <a href="/warden/dashboard" class="back-btn">⬅ Dashboard</a>
  </div>

  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Reg ID</th>
        <th>Course</th>
        <th>Year</th>
        <th>Paid (₹)</th>
        <th>Due (₹)</th>
        <th>Status</th>
        <th>Attendance</th>
        <th>Profile</th>
      </tr>
    </thead>
    <tbody>
      <% if(students.length===0){ %>
        <tr><td colspan="9">No students found</td></tr>
      <% } %>

      <% students.forEach(stu=>{ 
        const totalVerified = stu.feeSummary.reduce((a,y)=>a+Number(y.verified_amount),0);
        const totalDue = stu.feeSummary.reduce((a,y)=>a+Number(y.due_amount),0);
        const attendance = stu.attendanceSummary.total_classes>0
          ? ((stu.attendanceSummary.present_count / stu.attendanceSummary.total_classes)*100).toFixed(1)
          : "0.0";
      %>
      <tr>
        <td><%= stu.name %></td>
        <td><%= stu.student_unique_id %></td>
        <td><%= stu.course %></td>
        <td><%= stu.year %></td>
        <td>₹ <%= totalVerified.toFixed(2) %></td>
        <td>₹ <%= totalDue.toFixed(2) %></td>
        <td class="<%= totalDue<=0?'status-paid':'status-due' %>">
          <%= totalDue<=0 ? 'Fully Paid' : 'Due' %>
        </td>
        <td><%= attendance %>%</td>
        <td>
          <a href="/warden/student/<%= stu.student_id %>" class="view-btn">👁 View</a>
        </td>
      </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="summary">
    Total Students: <%= students.length %>
  </div>

</div>

<script>
  // SPA scroll fix
  window.scrollTo({top:0,behavior:'smooth'});
</script>
