<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>View Student Profiles</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&family=Roboto:wght@400;500&display=swap" rel="stylesheet">

<style>
    body {
      font-family: 'Roboto', sans-serif;
      margin: 0;
      background: #182235;
      padding: 20px 0;
      height: 100vh; /* Viewport height fixed */
      display: flex;
      flex-direction: column;
      overflow: hidden; /* Body scroll prevent chestundi */
      color: #f8f9fa;
    }

    .students-container {
      max-width: 1200px;
      margin: auto;
      background: #f8f9fa;
      border-radius: 16px;
      box-shadow: 0 12px 48px rgba(0,0,0,0.3);
      padding: 25px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      height: 90vh; /* Container height set chesam */
    }

    .students-heading {
      font-family: 'Montserrat', serif;
      color: #1b243b;
      text-align: center;
      font-weight: 900;
      font-size: 1.8em;
      margin: 0;
      border-bottom: 3px solid #ffc107;
      padding-bottom: 8px;
    }

    .search-bar {
      text-align: center;
      flex-shrink: 0; /* Search bar size thaggakunda chustundi */
    }

    .search-bar input {
      padding: 12px;
      width: 100%;
      max-width: 320px;
      border-radius: 8px;
      border: 2px solid #ffc107;
      font-size: 1em;
    }

    .search-bar button {
      padding: 12px 22px;
      border: none;
      border-radius: 8px;
      background: #22304c;
      color: #ffe082;
      font-weight: 700;
      cursor: pointer;
      margin-left: 5px;
    }

    /* 📱 SCROLLING AREA - Ikkade magic jarugutundi */
    .students-scroll-area {
      flex: 1; /* Migilina space antha idhe teesukuntundi */
      overflow-y: auto; /* Vertical scrolling enable chesam */
      padding: 10px;
      scrollbar-width: thin;
      scrollbar-color: #ffc107 transparent;
    }

    /* Chrome, Safari scrollbar styling */
    .students-scroll-area::-webkit-scrollbar {
      width: 6px;
    }
    .students-scroll-area::-webkit-scrollbar-thumb {
      background: #ffc107;
      border-radius: 10px;
    }

    .students-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }

    .student-card {
      background: #fff;
      border-radius: 14px;
      padding: 18px;
      box-shadow: 0 4px 16px rgba(34,48,76,0.1);
      transition: .25s;
      border: 2px solid transparent;
      display: flex;
      flex-direction: column;
      gap: 12px;
      color: #333;
    }

    .student-card:hover {
      transform: translateY(-4px);
      border-color: #ffd700;
    }

    .student-top {
      display: flex;
      gap: 15px;
      align-items: center;
    }

    .student-top img {
      width: 80px;
      height: 80px;
      border-radius: 10px;
      object-fit: cover;
      border: 2px solid #ffc107;
    }

    .student-details h3 {
      margin: 0;
      font-size: 1.1em;
      color: #182235;
    }

    .student-details p {
      margin: 2px 0;
      font-size: 0.9em;
    }

    .btn {
      display: block;
      background: #ffc107;
      color: #1b243b;
      padding: 10px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: 700;
      text-align: center;
      transition: 0.2s;
    }

    /* ---- MOBILE VIEW ---- */
    @media (max-width: 820px) {
      body { padding: 0; }
      .students-container {
        height: 100vh;
        border-radius: 0;
        padding: 15px;
      }
      .students-grid {
        grid-template-columns: 1fr !important;
      }
      .student-top {
        flex-direction: row;
        text-align: left;
      }
    }

    @media (max-width: 460px) {
      .student-top { flex-direction: column; text-align: center; }
      .search-bar form { display: flex; flex-direction: column; gap: 10px; align-items: center; }
      .search-bar button { margin-left: 0; width: 100%; max-width: 320px; }
    }
</style>

</head>
<body>

  <div class="students-container">
    <h2 class="students-heading">👨‍🎓 View Student Profiles</h2>

    <div class="search-bar">
      <form method="GET" action="/warden/viewStudents">
        <input
          type="text"
          name="search"
          placeholder="Search by name / ID / room"
          value="<%= search %>"
        >
        <button type="submit">Search</button>
      </form>
    </div>

    <div class="students-scroll-area">
      <% if (students.length > 0) { %>
        <div class="students-grid">
          <% students.forEach(s => { %>
            <div class="student-card">
              <div class="student-top">
                <img
                  src="<%= s.profile_image ? '/uploads/profile_images/' + s.profile_image : '/images/default-avatar.png' %>"
                  alt="Student Photo"
                >

                <div class="student-details">
                  <h3><%= s.name %></h3>
                  <p><strong>ID:</strong> <%= s.student_id %></p>
                  <p><strong>Room:</strong> <%= s.room_no || '-' %></p>
                  <p><strong>Course:</strong> <%= s.course || '-' %></p>
                  <p><strong>Year:</strong> <%= s.year || '-' %></p>
                </div>
              </div>

              <a href="/warden/student/<%= s.student_id %>" class="btn">
                👁 View Profile
              </a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p style="text-align:center;color:#22304c;font-weight:600; padding: 20px;">
          No students found
        </p>
      <% } %>
    </div> </div>

</body>
</html>
