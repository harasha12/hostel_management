<% if (!isSpa) { %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Upload Results - Mobile UI</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
<% } %>

<style>
  :root {
    --bg-dark: #121212;
    --card-bg: rgba(255, 255, 255, 0.08);
    --accent-gold: #ffcc00;
    --success: #28bb75;
    --danger: #db3159;
    --text-light: #ffffff;
    --text-muted: #bbbbbb;
  }

  body {
    background-color: var(--bg-dark);
    font-family: 'Segoe UI', Roboto, sans-serif;
    color: var(--text-light);
    margin: 0;
    padding: 15px; /* Reduced for mobile */
    min-height: 100vh;
    box-sizing: border-box;
  }

  .results-wrapper {
    width: 100%;
    max-width: 450px;
    margin: 20px auto; /* Centers the card horizontally */
    background: var(--card-bg);
    border-radius: 20px;
    padding: 25px 20px; /* Adjusted padding */
    border: 1px solid rgba(255, 204, 0, 0.2);
    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(10px);
    box-sizing: border-box; /* Crucial for mobile */
  }

  .results-heading {
    color: var(--accent-gold);
    text-align: center;
    margin-bottom: 25px;
    font-size: 1.3rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .input-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 15px;
  }

  input, select {
    width: 100%; /* Ensures it stays inside parent */
    box-sizing: border-box; 
    padding: 12px;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.3);
    color: #fff;
    font-size: 16px; /* Prevents iOS zoom on focus */
  }

  button {
    width: 100%;
    padding: 15px;
    border-radius: 12px;
    background: var(--accent-gold);
    color: #000;
    font-weight: 800;
    border: none;
    cursor: pointer;
  }

  /* Alert styling */
  .message-toast {
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 9999;
    width: 85%;
    max-width: 400px;
    padding: 15px;
    border-radius: 10px;
    display: none; /* Hidden by default */
  }
</style>

<div id="toast" class="message-toast"></div>

<div class="results-wrapper">
  <h2 class="results-heading"><i class="fas fa-file-upload"></i> Upload Results</h2>

  <form id="uploadForm" action="/warden/upload_results" method="POST" enctype="multipart/form-data">
    <div class="input-group">
      <label>Academic Year</label>
      <input type="number" name="year" min="1" max="4" placeholder="Year (1-4)" required>
    </div>

    <div class="input-group">
      <label>Semester</label>
      <input type="text" name="semester" placeholder="e.g., 2-1" pattern="[1-8]-[1-2]" required>
    </div>

    <div class="input-group">
      <label>Result Type</label>
      <select name="result_type" required>
        <option value="regular">Regular</option>
        <option value="supply">Supplementary</option>
        <option value="revaluation">Revaluation</option>
      </select>
    </div>

    <div class="input-group">
      <label>Results PDF</label>
      <input type="file" name="result_pdf" accept=".pdf" required>
    </div>

    <button type="submit" id="submitBtn">
      <i class="fas fa-cloud-upload-alt"></i> Upload & Process
    </button>
  </form>

  <a href="/warden/eligibility" class="back-link" style="color: var(--accent-gold); display: block; text-align: center; margin-top: 20px; text-decoration: none;">
    <i class="fas fa-arrow-left"></i> View Eligibility List
  </a>
</div>

<script>
  const form = document.getElementById('uploadForm');
  const toast = document.getElementById('toast');

  function showToast(msg, type) {
    toast.innerText = msg;
    toast.style.display = 'block';
    toast.style.background = type === 'success' ? '#28bb75' : '#db3159';
    setTimeout(() => { toast.style.display = 'none'; }, 4000);
  }

  // Handle SPA Submission
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submitBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData
      });

      if (response.ok) {
        showToast("Results uploaded successfully!", "success");
        form.reset();
      } else {
        showToast("Upload failed. Please try again.", "error");
      }
    } catch (err) {
      showToast("Network error occurred.", "error");
    } finally {
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-cloud-upload-alt"></i> Upload & Process';
    }
  });
</script>

<% if (!isSpa) { %>
</body>
</html>
<% } %>
