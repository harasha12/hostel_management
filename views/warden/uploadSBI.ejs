<style>
:root {
  --gold: #ffc107;
  --gold-dark: #ffd700;
  --success: #28bb75;
  --danger: #db3159;
  --shadow: 0 10px 30px rgba(0,0,0,0.15);
  --bg-color: #f0f2f5; /* Light grey background for contrast */
}

/* Base Body adjustment for mobile */
body {
  margin: 0;
  padding: 10px;
  background-color: var(--bg-color);
  font-family: 'Segoe UI', Roboto, sans-serif;
}

/* message box */
#message-container {
  position: fixed;
  top: 15px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
  width: 90%;
  max-width: 400px;
}

.message {
  padding: 12px 15px;
  border-radius: 8px;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10px;
  font-size: 0.9rem;
  text-align: center;
  box-shadow: 0 4px 10px rgba(0,0,0,0.2);
  animation: fade 4s forwards;
}

.success { background: var(--success); }
.error { background: var(--danger); }

@keyframes fade {
  0% { opacity: 0; transform: translateY(-20px); }
  10%, 90% { opacity: 1; transform: translateY(0); }
  100% { opacity: 0; transform: translateY(-20px); }
}

/* Container - Mobile Responsive Fix */
.sbipdf-container {
  width: 95%; /* Take most of the screen on mobile */
  max-width: 450px; /* Limit on Desktop */
  margin: 40px auto; 
  background: #ffffff;
  border-radius: 16px;
  box-shadow: var(--shadow);
  padding: 25px 20px; /* Balanced padding */
  border: 2px solid var(--gold);
  box-sizing: border-box; /* Crucial: padding won't increase width */
}

.sbipdf-heading {
  text-align: center;
  font-size: 1.3rem;
  font-weight: 800;
  color: #1b243b;
  padding: 12px;
  margin-bottom: 25px;
  background: linear-gradient(135deg, #fdfcfb 0%, #e2d1c3 100%);
  border-bottom: 3px solid var(--gold);
  border-radius: 10px;
}

.sbipdf-form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.sbipdf-label {
  font-weight: 700;
  color: #444;
  font-size: 0.95rem;
  margin-left: 5px;
}

.sbipdf-input {
  width: 100%; /* Full width within container */
  padding: 12px;
  border-radius: 8px;
  border: 2px solid #ddd;
  background: #fafafa;
  font-size: 16px; /* Prevents auto-zoom on iPhones */
  box-sizing: border-box;
}

.sbipdf-input:focus {
  border-color: var(--gold);
  background: #fff;
  outline: none;
}

.sbipdf-upload-btn {
  background: var(--gold);
  color: #222;
  border: none;
  border-radius: 12px;
  font-weight: 800;
  font-size: 1.1rem;
  padding: 14px;
  cursor: pointer;
  transition: .2s;
  width: 100%;
}

.sbipdf-upload-btn:active {
  transform: scale(0.96);
}

.back-link {
  display: block;
  margin: 25px auto 0;
  font-weight: 700;
  text-align: center;
  color: #333;
  background: #eee;
  border-radius: 10px;
  padding: 12px;
  text-decoration: none;
  font-size: 0.9rem;
  transition: .2s;
}

/* Tablet & Laptop Adjustments */
@media (min-width: 600px) {
  .sbipdf-container {
    padding: 35px;
  }
  .sbipdf-heading { font-size: 1.5rem; }
}
</style>

<div id="message-container">
  <% if (success) { %>
    <div class="message success"><%= success %></div>
  <% } %>

  <% if (error) { %>
    <div class="message error"><%= error %></div>
  <% } %>
</div>

<div class="sbipdf-container">
  <h2 class="sbipdf-heading">
    <i class="fas fa-file-excel" style="color: #1d6f42;"></i> Upload SBI Excel
  </h2>

  <form
    id="sbiForm"
    action="/warden/uploadSBI"
    method="POST"
    enctype="multipart/form-data"
    class="sbipdf-form"
  >
    <div class="input-group">
      <label class="sbipdf-label">Select SBI Collect Excel File</label>
      <input
        type="file"
        name="sbi_excel"
        class="sbipdf-input"
        accept=".xls,.xlsx"
        required
      >
    </div>

    <button type="submit" class="sbipdf-upload-btn" id="sbiBtn">
      Upload Excel
    </button>
  </form>

  <a href="/warden/dashboard" class="back-link">
    ⬅ Back to Dashboard
  </a>
</div>

<script>
  // Message auto-remove
  setTimeout(() => {
    document.querySelectorAll('.message').forEach(m => m.remove());
  }, 4000);

  // Simple SPA behavior (Optional)
  const sbiForm = document.getElementById('sbiForm');
  const sbiBtn = document.getElementById('sbiBtn');

  sbiForm.onsubmit = function() {
    sbiBtn.disabled = true;
    sbiBtn.innerHTML = "Uploading...";
  };
</script>
