<style>
:root{
  --accent:#156244;
  --accent-2:#1f7a52;
  --muted:#6b7280;
  --danger:#d9534f;
  --warning:#ffb700;
}

.page-wrapper{
  width:100%;
  max-width:1200px;
  margin:auto;
  background:#fff;
  border-radius:14px;
  padding:22px;
  box-shadow:0 10px 30px rgba(0,0,0,0.08);
}

.header-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:12px;
  margin-bottom:16px;
}

.title h1{
  margin:0;
  font-size:20px;
  color:var(--accent-2);
}

.subtitle{
  font-size:13px;
  color:var(--muted);
  margin-top:6px;
}

.btn{
  padding:8px 14px;
  border-radius:8px;
  border:none;
  cursor:pointer;
  font-weight:700;
  background:linear-gradient(180deg,var(--accent),var(--accent-2));
  color:#fff;
}

.btn.secondary{
  background:#eef2f0;
  color:#0f5132;
}

#filterForm{
  display:grid;
  grid-template-columns:1fr 1fr 1fr auto;
  gap:12px;
  margin-bottom:18px;
}

#filterForm select{
  padding:9px;
  border-radius:8px;
  border:1px solid #ddd;
}

.table-wrap{
  overflow-x:auto;
}

table{
  width:100%;
  border-collapse:collapse;
  min-width:600px;
}

th{
  background:linear-gradient(90deg,var(--accent),var(--accent-2));
  color:#fff;
  padding:10px;
  font-size:13px;
}

td{
  padding:10px;
  border-bottom:1px solid #eee;
  font-size:14px;
}

.badge{
  padding:5px 10px;
  border-radius:999px;
  font-size:12px;
  font-weight:700;
}

.badge.warn{background:#fff3cd;color:#856404;}
.badge.success{background:#d4edda;color:#155724;}
.badge.danger{background:#f8d7da;color:#721c24;}

.cards{display:none;}

@media(max-width:820px){
  #filterForm{grid-template-columns:1fr;}
  .table-wrap{display:none;}
  .cards{display:block;}
}
.view-eye{
  font-size:18px;
  text-decoration:none;
  cursor:pointer;
  transition:0.2s ease;
}

.view-eye:hover{
  transform:scale(1.2);
  filter:drop-shadow(0 0 6px rgba(0,0,0,0.4));
}

</style>

<div class="page-wrapper">

  <div class="header-row">
    <div class="title">
      <h1>📋 Mark Attendance</h1>
      <div class="subtitle">
  <%= block ? `Block: ${block}` : '' %>
  <%= year ? ` | Year: ${year}` : '' %>
  <%= room_no ? ` | Room: ${room_no}` : '' %>
</div>

    </div>

    <div>
      <a href="/warden/dashboard" class="btn secondary">🏠 Dashboard</a>
    </div>
  </div>

  <!-- FILTER -->
  <form
  id="filterForm"
  method="GET"
  action="/warden/markAttendance"
  data-rooms='<%- JSON.stringify(roomsByBlock) %>'
  data-selected-room="<%= room_no || '' %>"
>



  <!-- BLOCK -->
  <select id="blockSelect" name="block" required>
    <option value="">Block</option>
    <% blocks.forEach(b => { %>
      <option value="<%= b %>" <%= block === b ? 'selected' : '' %>>
        <%= b %>
      </option>
    <% }) %>
  </select>

  <!-- YEAR -->
  <select id="yearSelect" name="year" required>
    <option value="">Year</option>
    <option value="1" <%= year == 1 ? 'selected' : '' %>>1st</option>
    <option value="2" <%= year == 2 ? 'selected' : '' %>>2nd</option>
    <option value="3" <%= year == 3 ? 'selected' : '' %>>3rd</option>
    <option value="4" <%= year == 4 ? 'selected' : '' %>>4th</option>
  </select>

  <!-- ROOM -->
  <select id="roomSelect" name="room_no" required>
    <option value="">Room</option>
    <% rooms.forEach(r => { %>
      <option value="<%= r %>" <%= room_no === r ? 'selected' : '' %>>
        <%= r %>
      </option>
    <% }) %>
  </select>

  <button class="btn">Show</button>
</form>



  <% if(students.length>0){ %>

  <form method="POST" action="/warden/submitAttendance">

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
           <th>ID</th>
<th>Name</th>
<th>Room</th>
<th>Profile</th>
<th>Status</th>

          </tr>
        </thead>
        <tbody>
  <% students.forEach(s => { %>
    <tr>
      <td><%= s.student_id %></td>
      <td><%= s.name %></td>
      <td><%= s.room_no %></td>

      <!-- 👁️ PROFILE VIEW -->
      <td style="text-align:center;">
        <a href="/warden/student/<%= s.student_id %>"
           title="View Student Profile"
           class="view-eye">
           👁️
        </a>
      </td>

      <!-- STATUS -->
      <td>
        <% if (s.leave_status === 'On Leave') { %>
          <span class="badge warn">ON LEAVE</span>
          <input
            type="hidden"
            name="attendance_<%= s.student_id %>"
            value="On Leave"
          >
        <% } else { %>
          <select name="attendance_<%= s.student_id %>">
            <option value="Present">Present</option>
            <option value="Absent">Absent</option>
          </select>
        <% } %>
      </td>
    </tr>
  <% }) %>
</tbody>

      </table>
    </div>

    <div style="margin-top:16px;text-align:right;">
      <button class="btn">✅ Submit Attendance</button>
    </div>

  </form>

  <% } else { %>
    <p style="text-align:center;color:var(--muted);">Select filters to view students</p>
  <% } %>

</div>

<script>
function initMarkAttendanceSPA() {
  const form = document.getElementById('filterForm');
  const blockSelect = document.getElementById('blockSelect');
  const roomSelect = document.getElementById('roomSelect');

  if (!form || !blockSelect || !roomSelect) return;

  if (form.dataset.bound === "true") return;
  form.dataset.bound = "true";

  const roomsByBlock = JSON.parse(form.dataset.rooms || '{}');

  console.log("BLOCKS FROM DB:", Object.keys(roomsByBlock));

  function updateRooms() {
    const selectedBlock = blockSelect.value;
    console.log("SELECTED BLOCK:", selectedBlock);

    roomSelect.innerHTML = '<option value="">Room</option>';

    if (selectedBlock && roomsByBlock[selectedBlock]) {
      console.log("ROOMS FOR BLOCK:", roomsByBlock[selectedBlock]);

      roomsByBlock[selectedBlock].forEach(room => {
        const opt = document.createElement('option');
        opt.value = room;
        opt.textContent = room;
        roomSelect.appendChild(opt);
      });
    } else {
      console.log("ROOMS FOR BLOCK: []");
    }
  }

  // 🔥 IMPORTANT: listen ONLY on change
  blockSelect.addEventListener('change', updateRooms);
}
</script>




