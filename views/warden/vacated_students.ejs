```ejs
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vacated Students</title>

<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;900&family=Roboto:wght@400;500&display=swap" rel="stylesheet">

<style>

body{
    font-family:'Roboto',sans-serif;
    margin:0;
    background:#182235;
    padding:20px;
}

.container{

    max-width:1200px;
    margin:auto;
    background:#fff;
    border-radius:15px;
    padding:25px;
    box-shadow:0 10px 35px rgba(0,0,0,.25);

}

.heading{

    text-align:center;
    color:#182235;
    font-size:30px;
    font-weight:800;
    margin-bottom:20px;
    border-bottom:3px solid #ffc107;
    padding-bottom:10px;

}

.search-box{

    display:flex;
    justify-content:center;
    margin-bottom:20px;

}

.search-box form{

    display:flex;
    gap:10px;
    flex-wrap:wrap;

}

.search-box input{

    width:320px;
    padding:12px;
    border:2px solid #ffc107;
    border-radius:8px;
    outline:none;
    font-size:15px;

}

.search-box button{

    background:#22304c;
    color:white;
    border:none;
    padding:12px 20px;
    border-radius:8px;
    cursor:pointer;
    font-weight:bold;

}

.search-box button:hover{

    background:#ffc107;
    color:#182235;

}

.table-wrapper{

    overflow-x:auto;

}

table{

    width:100%;
    border-collapse:collapse;

}

th{

    background:#22304c;
    color:#fff;
    padding:14px;

}

td{

    padding:14px;
    text-align:center;
    border-bottom:1px solid #ddd;

}

tr:hover{

    background:#f8f8f8;

}

.badge{

    background:#f59e0b;
    color:white;
    padding:6px 12px;
    border-radius:20px;
    font-size:13px;
    font-weight:bold;

}

.btn{

    display:inline-block;
    padding:9px 16px;
    background:#2563eb;
    color:white;
    border-radius:8px;
    text-decoration:none;
    font-weight:bold;
    transition:.3s;

}

.btn:hover{

    background:#1d4ed8;

}

.empty{

    text-align:center;
    padding:40px;
    color:#777;
    font-size:18px;

}

@media(max-width:768px){

.heading{

font-size:24px;

}

.search-box input{

width:100%;

}

.search-box form{

width:100%;

flex-direction:column;

}

.search-box button{

width:100%;

}

}
.top-bar{
    display:flex;
    justify-content:flex-start;
    margin-bottom:20px;
}

.back-btn{
    display:inline-flex;
    align-items:center;
    gap:8px;
    padding:10px 18px;
    background:#2563eb;
    color:#fff;
    text-decoration:none;
    border-radius:10px;
    font-weight:600;
    transition:0.3s;
    box-shadow:0 4px 10px rgba(0,0,0,.2);
}

.back-btn:hover{
    background:#1d4ed8;
    transform:translateY(-2px);
}
</style>

</head>

<body>

<div class="container">
<div class="top-bar">
    <a href="/warden/dashboard" class="back-btn">
        <i class="fas fa-arrow-left"></i> Back to Dashboard
    </a>
</div>
<div class="heading">

🏠 Vacated Students

</div>

<div class="search-box">

<form method="GET">

<input
type="text"
name="search"
placeholder="Search by Name / Student ID / Room"
value="<%= search %>">

<button type="submit">

🔍 Search

</button>

</form>

</div>

<div class="table-wrapper">

<% if(students.length>0){ %>

<table>

<thead>

<tr>

<th>Student ID</th>

<th>Name</th>

<th>Course</th>

<th>Year</th>

<th>Room</th>

<th>Status</th>

<th>Profile</th>

</tr>

</thead>

<tbody>

<% students.forEach(student=>{ %>

<tr>

<td><%= student.student_id %></td>

<td><%= student.name %></td>

<td><%= student.course %></td>

<td><%= student.year %></td>

<td><%= student.room_no || "-" %></td>

<td>

<span class="badge">

VACATED

</span>

</td>

<td>

<a class="btn"

href="/warden/student/<%= student.student_id %>">

View Profile

</a>

</td>

</tr>

<% }) %>

</tbody>

</table>

<% }else{ %>

<div class="empty">

No Vacated Students Found

</div>

<% } %>

</div>

</div>

</body>

</html>
```
