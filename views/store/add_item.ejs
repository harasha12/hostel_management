<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add Grocery Item</title>

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
            font-family:"Segoe UI",Tahoma,sans-serif;
        }

        body{
            background:#f1f5f9;
            color:#1e293b;
        }

        /* ================= SIDEBAR ================= */

        .sidebar{
            position:fixed;
            left:0;
            top:0;
            width:260px;
            height:100vh;

            background:linear-gradient(
                180deg,
                #0f172a,
                #1e293b
            );

            color:white;
            z-index:1000;

            display:flex;
            flex-direction:column;

            box-shadow:4px 0 20px rgba(0,0,0,.15);

            transition:.3s;
        }

        .brand{
            padding:25px 20px;
            text-align:center;
            border-bottom:1px solid rgba(255,255,255,.1);
        }

        .brand-icon{
            font-size:40px;
            margin-bottom:8px;
        }

        .brand h2{
            font-size:20px;
        }

        .brand span{
            display:block;
            margin-top:5px;
            font-size:12px;
            color:#94a3b8;
        }

        .nav{
            padding:20px 12px;
            flex:1;
        }

        .nav a{
            display:flex;
            align-items:center;
            gap:13px;

            padding:13px 16px;
            margin-bottom:6px;

            color:#cbd5e1;
            text-decoration:none;

            border-radius:9px;

            transition:.25s;
        }

        .nav a:hover{
            background:rgba(255,255,255,.09);
            color:white;
            transform:translateX(4px);
        }

        .nav a.active{
            background:linear-gradient(
                135deg,
                #2563eb,
                #1d4ed8
            );

            color:white;
        }

        .nav-icon{
            width:25px;
            text-align:center;
            font-size:18px;
        }

        .logout{
            padding:15px 12px 25px;
            border-top:1px solid rgba(255,255,255,.1);
        }

        .logout a{
            display:flex;
            align-items:center;
            gap:13px;

            padding:13px 16px;

            color:#fecaca;
            text-decoration:none;
            border-radius:9px;
        }

        .logout a:hover{
            background:rgba(239,68,68,.15);
        }

        /* ================= MAIN ================= */

        .main{
            margin-left:260px;
            min-height:100vh;
            padding:30px;
        }

        /* ================= MOBILE HEADER ================= */

        .mobile-header{
            display:none;

            align-items:center;
            justify-content:space-between;

            background:white;
            padding:15px 18px;

            margin-bottom:20px;
            border-radius:12px;

            box-shadow:0 4px 15px rgba(0,0,0,.06);
        }

        .menu-btn{
            border:none;
            background:#2563eb;
            color:white;

            width:42px;
            height:42px;

            border-radius:8px;

            font-size:22px;
            cursor:pointer;
        }

        .mobile-title{
            font-size:17px;
            font-weight:700;
        }

        /* ================= PAGE HEADER ================= */

        .page-header{
            background:white;

            padding:25px 30px;

            border-radius:15px;

            box-shadow:0 4px 15px rgba(0,0,0,.05);

            margin-bottom:25px;
        }

        .page-header h1{
            font-size:26px;
            color:#0f172a;
            margin-bottom:6px;
        }

        .page-header p{
            color:#64748b;
            font-size:14px;
        }

        /* ================= FORM CARD ================= */

        .form-card{
            background:white;

            max-width:850px;

            padding:30px;

            border-radius:15px;

            box-shadow:0 5px 20px rgba(0,0,0,.06);

            margin:auto;
        }

        .form-title{
            display:flex;
            align-items:center;
            gap:12px;

            padding-bottom:20px;
            margin-bottom:25px;

            border-bottom:1px solid #e2e8f0;
        }

        .form-title-icon{
            width:50px;
            height:50px;

            background:#dbeafe;

            border-radius:12px;

            display:flex;
            align-items:center;
            justify-content:center;

            font-size:25px;
        }

        .form-title h2{
            font-size:20px;
            color:#1e293b;
        }

        .form-title p{
            color:#64748b;
            font-size:13px;
            margin-top:3px;
        }

        /* ================= FORM ================= */

        .form-grid{
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:22px;
        }

        .form-group{
            display:flex;
            flex-direction:column;
        }

        .form-group.full{
            grid-column:1 / -1;
        }

        label{
            font-size:14px;
            font-weight:600;
            color:#334155;

            margin-bottom:8px;
        }

        .required{
            color:#ef4444;
        }

        input,
        select,
        textarea{

            width:100%;

            padding:13px 14px;

            border:1px solid #cbd5e1;

            border-radius:9px;

            background:#f8fafc;

            color:#1e293b;

            font-size:14px;

            transition:.25s;
        }

        input:focus,
        select:focus,
        textarea:focus{

            outline:none;

            border-color:#2563eb;

            background:white;

            box-shadow:
                0 0 0 3px rgba(37,99,235,.1);
        }

        textarea{
            min-height:110px;
            resize:vertical;
        }

        .hint{
            margin-top:6px;
            font-size:12px;
            color:#94a3b8;
        }

        /* ================= BUTTONS ================= */

        .form-actions{

            display:flex;
            justify-content:flex-end;
            gap:12px;

            margin-top:30px;

            padding-top:22px;

            border-top:1px solid #e2e8f0;
        }

        .btn{

            padding:12px 22px;

            border:none;

            border-radius:9px;

            font-size:14px;

            font-weight:600;

            cursor:pointer;

            text-decoration:none;

            transition:.25s;
        }

        .btn-cancel{

            background:#e2e8f0;
            color:#334155;
        }

        .btn-cancel:hover{
            background:#cbd5e1;
        }

        .btn-save{

            background:linear-gradient(
                135deg,
                #2563eb,
                #1d4ed8
            );

            color:white;

            box-shadow:
                0 5px 12px rgba(37,99,235,.25);
        }

        .btn-save:hover{

            transform:translateY(-2px);

            box-shadow:
                0 8px 18px rgba(37,99,235,.3);
        }

        /* ================= OVERLAY ================= */

        .sidebar-overlay{
            display:none;

            position:fixed;
            inset:0;

            background:rgba(0,0,0,.5);

            z-index:999;
        }

        /* ================= MOBILE ================= */

        @media(max-width:768px){

            .sidebar{
                transform:translateX(-100%);
                width:270px;
            }

            .sidebar.open{
                transform:translateX(0);
            }

            .sidebar-overlay.show{
                display:block;
            }

            .main{
                margin-left:0;
                padding:15px;
            }

            .mobile-header{
                display:flex;
            }

            .page-header{
                padding:20px;
            }

            .page-header h1{
                font-size:22px;
            }

            .form-card{
                padding:20px;
            }

            .form-grid{
                grid-template-columns:1fr;
                gap:18px;
            }

            .form-group.full{
                grid-column:auto;
            }

            .form-actions{
                flex-direction:column-reverse;
            }

            .btn{
                width:100%;
                text-align:center;
            }
        }

    </style>

</head>


<body>


<!-- ================= SIDEBAR ================= -->

<aside class="sidebar" id="sidebar">

    <div class="brand">

        <div class="brand-icon">
            📦
        </div>

        <h2>Store Manager</h2>

        <span>Hostel Inventory System</span>

    </div>


    <nav class="nav">

        <a href="/store/dashboard">
            <span class="nav-icon">🏠</span>
            Dashboard
        </a>

        <a href="/store/items" class="active">
            <span class="nav-icon">📋</span>
            Master Items
        </a>

        <a href="/store/stock-entry">
            <span class="nav-icon">📥</span>
            Stock Entry
        </a>

        <a href="/store/current-stock">
            <span class="nav-icon">📦</span>
            Current Stock
        </a>

        <a href="/store/daily-usage">
            <span class="nav-icon">🍽️</span>
            Daily Usage
        </a>

        <a href="/store/reports">
            <span class="nav-icon">📊</span>
            Reports
        </a>

    </nav>


    <div class="logout">

        <a href="/store/logout">

            <span class="nav-icon">
                🚪
            </span>

            Logout

        </a>

    </div>

</aside>


<!-- MOBILE OVERLAY -->

<div
    class="sidebar-overlay"
    id="sidebarOverlay"
    onclick="closeSidebar()">
</div>


<!-- ================= MAIN ================= -->

<main class="main">


    <!-- MOBILE HEADER -->

    <div class="mobile-header">

        <button
            class="menu-btn"
            onclick="openSidebar()">

            ☰

        </button>

        <div class="mobile-title">
            📦 Store Management
        </div>

        <div></div>

    </div>


    <!-- PAGE HEADER -->

    <div class="page-header">

        <h1>
            ➕ Add Grocery Item
        </h1>

        <p>
            Add a new item to the hostel grocery master list.
        </p>

    </div>


    <!-- FORM -->

    <div class="form-card">


        <div class="form-title">

            <div class="form-title-icon">
                📋
            </div>

            <div>

                <h2>
                    Item Information
                </h2>

                <p>
                    Enter the basic details of the grocery item.
                </p>

            </div>

        </div>


        <form
            action="/store/items/add"
            method="POST">


            <div class="form-grid">


                <!-- ITEM NAME -->

                <div class="form-group">

                    <label>
                        Item Name
                        <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        name="item_name"
                        placeholder="Example: Rice"
                        required>

                </div>


                <!-- CATEGORY -->

                <div class="form-group">

                    <label>
                        Category
                        <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        name="category"
                        placeholder="Example: Grains"
                        required>

                </div>


                <!-- UNIT -->

                <div class="form-group">

                    <label>
                        Unit
                    </label>

                    <select name="unit">

                        <option value="KG">
                            Kilogram (KG)
                        </option>

                        <option value="Litre">
                            Litre
                        </option>

                        <option value="Nos">
                            Numbers (Nos)
                        </option>

                        <option value="Packet">
                            Packet
                        </option>

                        <option value="Box">
                            Box
                        </option>

                    </select>

                    <span class="hint">
                        Select how this item is measured.
                    </span>

                </div>


                <!-- MINIMUM STOCK -->

                <div class="form-group">

                    <label>
                        Minimum Stock
                    </label>

                    <input
                        type="number"
                        step="0.01"
                        min="0"
                        name="minimum_stock"
                        placeholder="Example: 50">

                    <span class="hint">
                        System can use this value for low-stock alerts.
                    </span>

                </div>


                <!-- DESCRIPTION -->

                <div class="form-group full">

                    <label>
                        Description
                    </label>

                    <textarea
                        name="description"
                        placeholder="Enter any additional information about this item..."></textarea>

                </div>


            </div>


            <!-- ACTIONS -->

            <div class="form-actions">

                <a
                    href="/store/items"
                    class="btn btn-cancel">

                    Cancel

                </a>


                <button
                    type="submit"
                    class="btn btn-save">

                    💾 Save Item

                </button>

            </div>


        </form>

    </div>


</main>


<script>

function openSidebar(){

    document
        .getElementById("sidebar")
        .classList.add("open");

    document
        .getElementById("sidebarOverlay")
        .classList.add("show");

}


function closeSidebar(){

    document
        .getElementById("sidebar")
        .classList.remove("open");

    document
        .getElementById("sidebarOverlay")
        .classList.remove("show");

}

</script>


</body>

</html>
