<h2>Stock Entry</h2>

<form action="/store/stock-entry" method="POST">

<label>Select Item</label>

<select name="item_id" required>

<% items.forEach(item=>{ %>

<option value="<%= item.id %>">

<%= item.item_name %>

</option>

<% }) %>

</select>

<br><br>

<label>Quantity</label>

<input
type="number"
step="0.01"
name="quantity"
required>

<br><br>

<label>Supplier</label>

<input
type="text"
name="supplier_name">

<br><br>

<label>Invoice No</label>

<input
type="text"
name="invoice_no">

<br><br>

<label>Entry Date</label>

<input
type="date"
name="entry_date"
required>

<br><br>

<label>Remarks</label>

<textarea
name="remarks"></textarea>

<br><br>

<button type="submit">

Save Stock

</button>

</form>