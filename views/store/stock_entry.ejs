<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Stock Entry | Store Manager</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",Tahoma,sans-serif;
}

body{
    background:#f1f5f9;
    color:#1e293b;
}

/* ================= SIDEBAR ================= */

.sidebar{
    position:fixed;
    left:0;
    top:0;
    width:260px;
    height:100vh;

    background:linear-gradient(180deg,#0f172a,#1e293b);

    color:white;
    z-index:1000;

    display:flex;
    flex-direction:column;

    box-shadow:4px 0 20px rgba(0,0,0,.15);

    transition:.3s;
}

.brand{
    padding:25px 20px;
    text-align:center;

    border-bottom:1px solid rgba(255,255,255,.1);
}

.brand-icon{
    font-size:40px;
    margin-bottom:8px;
}

.brand h2{
    font-size:20px;
}

.brand span{
    display:block;
    margin-top:5px;
    font-size:12px;
    color:#94a3b8;
}

.nav{
    padding:20px 12px;
    flex:1;
}

.nav a{
    display:flex;
    align-items:center;
    gap:13px;

    padding:13px 16px;
    margin-bottom:6px;

    color:#cbd5e1;
    text-decoration:none;

    border-radius:9px;

    transition:.25s;
}

.nav a:hover{
    background:rgba(255,255,255,.09);
    color:white;
    transform:translateX(4px);
}

.nav a.active{
    background:linear-gradient(
        135deg,
        #2563eb,
        #1d4ed8
    );

    color:white;
}

.nav-icon{
    width:25px;
    text-align:center;
    font-size:18px;
}

.logout{
    padding:15px 12px 25px;
    border-top:1px solid rgba(255,255,255,.1);
}

.logout a{
    display:flex;
    align-items:center;
    gap:13px;

    padding:13px 16px;

    color:#fecaca;
    text-decoration:none;

    border-radius:9px;
}

.logout a:hover{
    background:rgba(239,68,68,.15);
}

/* ================= MAIN ================= */

.main{
    margin-left:260px;
    min-height:100vh;
    padding:30px;
}

/* ================= MOBILE HEADER ================= */

.mobile-header{
    display:none;

    align-items:center;
    justify-content:space-between;

    background:white;

    padding:15px 18px;

    margin-bottom:20px;

    border-radius:12px;

    box-shadow:0 4px 15px rgba(0,0,0,.06);
}

.menu-btn{
    border:none;

    background:#2563eb;
    color:white;

    width:42px;
    height:42px;

    border-radius:8px;

    font-size:22px;

    cursor:pointer;
}

.mobile-title{
    font-size:17px;
    font-weight:700;
}

/* ================= PAGE HEADER ================= */

.page-header{
    background:white;

    padding:25px 30px;

    border-radius:15px;

    box-shadow:0 4px 15px rgba(0,0,0,.05);

    margin-bottom:25px;

    display:flex;
    justify-content:space-between;
    align-items:center;
}

.page-header h1{
    font-size:26px;
    color:#0f172a;
    margin-bottom:5px;
}

.page-header p{
    color:#64748b;
    font-size:14px;
}

.manager{
    color:#64748b;
    font-size:14px;
}

.manager strong{
    color:#2563eb;
}

/* ================= FORM CARD ================= */

.form-card{
    background:white;

    max-width:950px;

    margin:0 auto;

    padding:30px;

    border-radius:15px;

    box-shadow:0 5px 20px rgba(0,0,0,.06);
}

.form-title{
    display:flex;
    align-items:center;
    gap:12px;

    padding-bottom:20px;
    margin-bottom:25px;

    border-bottom:1px solid #e2e8f0;
}

.form-icon{
    width:50px;
    height:50px;

    border-radius:12px;

    background:#dcfce7;

    display:flex;
    align-items:center;
    justify-content:center;

    font-size:25px;
}

.form-title h2{
    font-size:20px;
}

.form-title p{
    color:#64748b;
    font-size:13px;
    margin-top:3px;
}

/* ================= FORM ================= */

.form-grid{
    display:grid;

    grid-template-columns:1fr 1fr;

    gap:22px;
}

.form-group{
    display:flex;
    flex-direction:column;
}

.form-group.full{
    grid-column:1 / -1;
}

label{
    font-size:14px;

    font-weight:600;

    color:#334155;

    margin-bottom:8px;
}

.required{
    color:#ef4444;
}

input,
select,
textarea{

    width:100%;

    padding:13px 14px;

    border:1px solid #cbd5e1;

    border-radius:9px;

    background:#f8fafc;

    color:#1e293b;

    font-size:14px;

    transition:.25s;
}

input:focus,
select:focus,
textarea:focus{

    outline:none;

    border-color:#2563eb;

    background:white;

    box-shadow:
        0 0 0 3px rgba(37,99,235,.1);
}

textarea{
    min-height:110px;
    resize:vertical;
}

.hint{
    margin-top:6px;

    font-size:12px;

    color:#94a3b8;
}

/* ================= BUTTON ================= */

.form-actions{

    display:flex;

    justify-content:flex-end;

    gap:12px;

    margin-top:30px;

    padding-top:22px;

    border-top:1px solid #e2e8f0;
}

.btn{

    padding:12px 22px;

    border:none;

    border-radius:9px;

    font-size:14px;

    font-weight:600;

    cursor:pointer;

    text-decoration:none;

    transition:.25s;
}

.btn-cancel{
    background:#e2e8f0;
    color:#334155;
}

.btn-cancel:hover{
    background:#cbd5e1;
}

.btn-save{

    background:linear-gradient(
        135deg,
        #16a34a,
        #15803d
    );

    color:white;

    box-shadow:
        0 5px 12px rgba(22,163,74,.2);
}

.btn-save:hover{

    transform:translateY(-2px);

    box-shadow:
        0 8px 18px rgba(22,163,74,.3);
}
.header-right{
    display:flex;
    align-items:center;
    gap:15px;
}

.back-dashboard{
    display:inline-flex;
    align-items:center;
    gap:6px;

    padding:10px 15px;

    background:#e2e8f0;
    color:#334155;

    border-radius:8px;

    text-decoration:none;

    font-size:13px;
    font-weight:600;

    transition:.25s;
}

.back-dashboard:hover{
    background:#cbd5e1;
    transform:translateY(-2px);
}
/* ================= INFO BOX ================= */

.info-box{

    margin-top:20px;

    padding:15px 18px;

    background:#eff6ff;

    border:1px solid #bfdbfe;

    border-radius:10px;

    color:#1e40af;

    font-size:13px;

    line-height:1.6;
}

/* ================= OVERLAY ================= */

.sidebar-overlay{
    display:none;

    position:fixed;
    inset:0;

    background:rgba(0,0,0,.5);

    z-index:999;
}

/* ================= MOBILE ================= */

@media(max-width:768px){

    .sidebar{
        transform:translateX(-100%);
        width:270px;
    }

    .sidebar.open{
        transform:translateX(0);
    }

    .sidebar-overlay.show{
        display:block;
    }

    .main{
        margin-left:0;
        padding:15px;
    }

    .mobile-header{
        display:flex;
    }

    .page-header{

        padding:20px;

        flex-direction:column;

        align-items:flex-start;

        gap:12px;
    }

    .page-header h1{
        font-size:22px;
    }

    .form-card{
        padding:20px;
    }

    .form-grid{
        grid-template-columns:1fr;
        gap:18px;
    }

    .form-group.full{
        grid-column:auto;
    }

    .form-actions{
        flex-direction:column-reverse;
    }

    .btn{
        width:100%;
        text-align:center;
    }

}
@media(max-width:768px){

    .header-right{
        width:100%;

        flex-direction:column;

        align-items:stretch;

        gap:10px;
    }

    .manager{
        text-align:left;
    }

    .back-dashboard{
        justify-content:center;
        width:100%;
    }

}
</style>

</head>

<body>


<!-- ================= SIDEBAR ================= -->

<aside class="sidebar" id="sidebar">

    <div class="brand">

        <div class="brand-icon">
            📦
        </div>

        <h2>Store Manager</h2>

        <span>Hostel Inventory System</span>

    </div>


    <nav class="nav">

        <a href="/store/dashboard">

            <span class="nav-icon">
                🏠
            </span>

            Dashboard

        </a>


        <a href="/store/items">

            <span class="nav-icon">
                📋
            </span>

            Master Items

        </a>


        <a href="/store/stock-entry" class="active">

            <span class="nav-icon">
                📥
            </span>

            Stock Entry

        </a>


        <a href="/store/current-stock">

            <span class="nav-icon">
                📦
            </span>

            Current Stock

        </a>


        <a href="/store/daily-usage">

            <span class="nav-icon">
                🍽️
            </span>

            Daily Usage

        </a>


        <a href="/store/reports">

            <span class="nav-icon">
                📊
            </span>

            Reports

        </a>

    </nav>


    <div class="logout">

        <a href="/store/logout">

            <span class="nav-icon">
                🚪
            </span>

            Logout

        </a>

    </div>

</aside>


<!-- MOBILE OVERLAY -->

<div
    class="sidebar-overlay"
    id="sidebarOverlay"
    onclick="closeSidebar()">
</div>


<!-- ================= MAIN ================= -->

<main class="main">


    <!-- MOBILE HEADER -->

    <div class="mobile-header">

        <button
            class="menu-btn"
            onclick="openSidebar()">

            ☰

        </button>

        <div class="mobile-title">
            📦 Store Management
        </div>

        <div></div>

    </div>


    <!-- PAGE HEADER -->

    <div class="page-header">

    <div>

        <h1>
            📥 Stock Entry
        </h1>

        <p>
            Record newly received grocery stock and supplier information.
        </p>

    </div>

    <div class="header-right">

        <div class="manager">

            Store Manager:

            <strong>
                <%= store.name %>
            </strong>

        </div>

        <a
            href="/store/dashboard"
            class="back-dashboard">

            ← Back to Dashboard

        </a>

    </div>

</div>


    <!-- FORM CARD -->

    <div class="form-card">


        <div class="form-title">

            <div class="form-icon">
                📥
            </div>

            <div>

                <h2>
                    Add New Stock
                </h2>

                <p>
                    Enter the details of the stock received.
                </p>

            </div>

        </div>


        <form
            action="/store/stock-entry"
            method="POST">


            <div class="form-grid">


                <!-- ITEM -->

                <div class="form-group">

                    <label>

                        Select Item

                        <span class="required">*</span>

                    </label>


                    <select
                        name="item_id"
                        required>

                        <option value="">
                            Select Grocery Item
                        </option>


                        <% items.forEach(item => { %>

                            <option value="<%= item.id %>">

                                <%= item.item_name %>

                            </option>

                        <% }) %>

                    </select>


                    <span class="hint">
                        Select the grocery item being received.
                    </span>

                </div>


                <!-- QUANTITY -->

                <div class="form-group">

                    <label>

                        Quantity

                        <span class="required">*</span>

                    </label>


                    <input
                        type="number"
                        step="0.01"
                        min="0.01"
                        name="quantity"
                        placeholder="Enter quantity"
                        required>


                    <span class="hint">
                        Enter the received quantity.
                    </span>

                </div>


                <!-- SUPPLIER -->

                <div class="form-group">

                    <label>
                        Supplier Name
                    </label>


                    <input
                        type="text"
                        name="supplier_name"
                        placeholder="Enter supplier name">

                </div>


                <!-- INVOICE -->

                <div class="form-group">

                    <label>
                        Invoice Number
                    </label>


                    <input
                        type="text"
                        name="invoice_no"
                        placeholder="Enter invoice number">

                </div>


                <!-- DATE -->

                <div class="form-group">

                    <label>

                        Entry Date

                        <span class="required">*</span>

                    </label>


                   <input
    type="date"
    name="entry_date"
    id="entryDate"
    required>

                    <span class="hint">
                        Select the date of stock entry.
                    </span>

                </div>


                <!-- REMARKS -->

                <div class="form-group">

                    <label>
                        Remarks
                    </label>


                    <textarea
                        name="remarks"
                        placeholder="Enter any additional details..."></textarea>

                </div>


            </div>


            <!-- INFO -->

            <div class="info-box">

                💡 <strong>Note:</strong>
                Saving this entry will add the received quantity to the
                item's current stock and create a stock-entry history record.

            </div>


            <!-- ACTIONS -->

            <div class="form-actions">

                <a
                    href="/store/dashboard"
                    class="btn btn-cancel">

                    Cancel

                </a>


                <button
                    type="submit"
                    class="btn btn-save">

                    💾 Save Stock Entry

                </button>

            </div>


        </form>

    </div>


</main>


<script>

function openSidebar(){

    document
        .getElementById("sidebar")
        .classList.add("open");

    document
        .getElementById("sidebarOverlay")
        .classList.add("show");

}


function closeSidebar(){

    document
        .getElementById("sidebar")
        .classList.remove("open");

    document
        .getElementById("sidebarOverlay")
        .classList.remove("show");

}
document.getElementById("entryDate").value =
    new Date().toISOString().split("T")[0];
</script>


</body>

</html>
