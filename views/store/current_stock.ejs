<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Current Stock | Store Manager</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",Tahoma,sans-serif;
}

body{
    background:#f1f5f9;
    color:#1e293b;
}

/* ================= SIDEBAR ================= */

.sidebar{
    position:fixed;
    left:0;
    top:0;
    width:260px;
    height:100vh;

    background:linear-gradient(180deg,#0f172a,#1e293b);

    color:white;
    z-index:1000;

    display:flex;
    flex-direction:column;

    box-shadow:4px 0 20px rgba(0,0,0,.15);

    transition:.3s;
}

.brand{
    padding:25px 20px;
    text-align:center;

    border-bottom:1px solid rgba(255,255,255,.1);
}

.brand-icon{
    font-size:40px;
    margin-bottom:8px;
}

.brand h2{
    font-size:20px;
}

.brand span{
    display:block;
    margin-top:5px;

    font-size:12px;
    color:#94a3b8;
}

.nav{
    padding:20px 12px;
    flex:1;
}

.nav a{
    display:flex;
    align-items:center;
    gap:13px;

    padding:13px 16px;
    margin-bottom:6px;

    color:#cbd5e1;
    text-decoration:none;

    border-radius:9px;

    transition:.25s;
}

.nav a:hover{
    background:rgba(255,255,255,.09);
    color:white;
    transform:translateX(4px);
}

.nav a.active{
    background:linear-gradient(
        135deg,
        #2563eb,
        #1d4ed8
    );

    color:white;
}

.nav-icon{
    width:25px;
    text-align:center;
    font-size:18px;
}

.logout{
    padding:15px 12px 25px;

    border-top:1px solid rgba(255,255,255,.1);
}

.logout a{
    display:flex;
    align-items:center;
    gap:13px;

    padding:13px 16px;

    color:#fecaca;
    text-decoration:none;

    border-radius:9px;
}

.logout a:hover{
    background:rgba(239,68,68,.15);
}

/* ================= MAIN ================= */

.main{
    margin-left:260px;
    min-height:100vh;
    padding:30px;
}

/* ================= MOBILE HEADER ================= */

.mobile-header{
    display:none;

    align-items:center;
    justify-content:space-between;

    background:white;

    padding:15px 18px;

    margin-bottom:20px;

    border-radius:12px;

    box-shadow:0 4px 15px rgba(0,0,0,.06);
}

.menu-btn{
    border:none;

    background:#2563eb;
    color:white;

    width:42px;
    height:42px;

    border-radius:8px;

    font-size:22px;

    cursor:pointer;
}

.mobile-title{
    font-size:17px;
    font-weight:700;
}

/* ================= PAGE HEADER ================= */

.page-header{
    background:white;

    padding:25px 30px;

    border-radius:15px;

    box-shadow:0 4px 15px rgba(0,0,0,.05);

    margin-bottom:25px;

    display:flex;

    justify-content:space-between;
    align-items:center;

    gap:20px;
}

.page-header h1{
    font-size:26px;
    color:#0f172a;

    margin-bottom:5px;
}

.page-header p{
    color:#64748b;
    font-size:14px;
}

.header-right{
    display:flex;
    align-items:center;
    gap:15px;
}

.manager{
    color:#64748b;
    font-size:14px;
    white-space:nowrap;
}

.manager strong{
    color:#2563eb;
}

.back-dashboard{
    display:inline-flex;

    align-items:center;
    justify-content:center;

    gap:6px;

    padding:10px 15px;

    background:#e2e8f0;
    color:#334155;

    border-radius:8px;

    text-decoration:none;

    font-size:13px;
    font-weight:600;

    transition:.25s;

    white-space:nowrap;
}

.back-dashboard:hover{
    background:#cbd5e1;

    transform:translateY(-2px);
}

/* ================= SUMMARY CARDS ================= */

.summary-grid{
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:20px;

    margin-bottom:25px;
}

.summary-card{
    background:white;

    padding:22px;

    border-radius:14px;

    box-shadow:0 5px 20px rgba(0,0,0,.06);

    display:flex;

    align-items:center;

    gap:16px;
}

.summary-icon{
    width:52px;
    height:52px;

    display:flex;

    align-items:center;
    justify-content:center;

    border-radius:12px;

    font-size:25px;
}

.summary-icon.blue{
    background:#dbeafe;
}

.summary-icon.green{
    background:#dcfce7;
}

.summary-icon.red{
    background:#fee2e2;
}

.summary-info h3{
    font-size:24px;
    color:#0f172a;
}

.summary-info p{
    color:#64748b;
    font-size:13px;
    margin-top:2px;
}

/* ================= TABLE CARD ================= */

.table-card{
    background:white;

    padding:25px;

    border-radius:15px;

    box-shadow:0 5px 20px rgba(0,0,0,.06);
}

.table-header{
    display:flex;

    justify-content:space-between;

    align-items:center;

    margin-bottom:20px;

    gap:15px;
}

.table-header h2{
    font-size:19px;
    color:#0f172a;
}

.table-header p{
    color:#64748b;
    font-size:13px;
    margin-top:4px;
}

.stock-badge{
    padding:7px 12px;

    border-radius:20px;

    background:#eff6ff;

    color:#2563eb;

    font-size:12px;

    font-weight:700;
}

/* ================= TABLE ================= */

.table-wrapper{
    width:100%;
    overflow-x:auto;
}

table{
    width:100%;

    border-collapse:collapse;

    min-width:750px;
}

thead th{
    background:#0f172a;

    color:white;

    padding:14px 12px;

    text-align:center;

    font-size:13px;

    font-weight:600;
}

tbody td{
    padding:14px 12px;

    border-bottom:1px solid #e2e8f0;

    text-align:center;

    font-size:14px;
}

tbody tr{
    transition:.2s;
}

tbody tr:hover{
    background:#f8fafc;
}

/* ================= ITEM ================= */

.item-name{
    font-weight:700;
    color:#1e293b;
}

.category{
    color:#64748b;
}

.quantity{
    font-size:16px;
    font-weight:700;
}

.unit{
    color:#64748b;
    font-size:12px;
}

/* ================= STATUS ================= */

.status{
    display:inline-flex;

    align-items:center;

    gap:5px;

    padding:6px 12px;

    border-radius:20px;

    font-size:12px;

    font-weight:700;
}

.status.ok{
    background:#dcfce7;
    color:#15803d;
}

.status.low{
    background:#fee2e2;
    color:#dc2626;
}

.status.zero{
    background:#fef3c7;
    color:#b45309;
}

/* ================= LOW ROW ================= */

.low-row{
    background:#fff7f7;
}

.low-row:hover{
    background:#fff1f2 !important;
}

/* ================= EMPTY ================= */

.empty{
    padding:45px 20px !important;

    text-align:center !important;

    color:#64748b;

    font-size:14px;
}

.empty-icon{
    display:block;

    font-size:40px;

    margin-bottom:10px;
}

/* ================= OVERLAY ================= */

.sidebar-overlay{
    display:none;

    position:fixed;

    inset:0;

    background:rgba(0,0,0,.5);

    z-index:999;
}

/* ================= MOBILE ================= */

@media(max-width:768px){

    .sidebar{
        transform:translateX(-100%);
        width:270px;
    }

    .sidebar.open{
        transform:translateX(0);
    }

    .sidebar-overlay.show{
        display:block;
    }

    .main{
        margin-left:0;
        padding:15px;
    }

    .mobile-header{
        display:flex;
    }

    .page-header{
        padding:20px;

        flex-direction:column;

        align-items:flex-start;

        gap:15px;
    }

    .page-header h1{
        font-size:22px;
    }

    .header-right{
        width:100%;

        flex-direction:column;

        align-items:stretch;

        gap:10px;
    }

    .manager{
        white-space:normal;
    }

    .back-dashboard{
        width:100%;
    }

    .summary-grid{
        grid-template-columns:1fr;

        gap:12px;
    }

    .summary-card{
        padding:18px;
    }

    .table-card{
        padding:15px;
    }

    .table-header{
        flex-direction:column;

        align-items:flex-start;
    }

}

</style>

</head>

<body>


<!-- ================= SIDEBAR ================= -->

<aside class="sidebar" id="sidebar">

    <div class="brand">

        <div class="brand-icon">
            📦
        </div>

        <h2>Store Manager</h2>

        <span>Hostel Inventory System</span>

    </div>


    <nav class="nav">

        <a href="/store/dashboard">

            <span class="nav-icon">
                🏠
            </span>

            Dashboard

        </a>


        <a href="/store/items">

            <span class="nav-icon">
                📋
            </span>

            Master Items

        </a>


        <a href="/store/stock-entry">

            <span class="nav-icon">
                📥
            </span>

            Stock Entry

        </a>


        <a href="/store/current-stock" class="active">

            <span class="nav-icon">
                📦
            </span>

            Current Stock

        </a>


        <a href="/store/daily-usage">

            <span class="nav-icon">
                🍽️
            </span>

            Daily Usage

        </a>


        <a href="/store/reports">

            <span class="nav-icon">
                📊
            </span>

            Reports

        </a>

    </nav>


    <div class="logout">

        <a href="/store/logout">

            <span class="nav-icon">
                🚪
            </span>

            Logout

        </a>

    </div>

</aside>


<!-- MOBILE OVERLAY -->

<div
    class="sidebar-overlay"
    id="sidebarOverlay"
    onclick="closeSidebar()">
</div>


<!-- ================= MAIN ================= -->

<main class="main">


    <!-- MOBILE HEADER -->

    <div class="mobile-header">

        <button
            class="menu-btn"
            onclick="openSidebar()">

            ☰

        </button>

        <div class="mobile-title">
            📦 Store Management
        </div>

        <div></div>

    </div>


    <!-- ================= PAGE HEADER ================= -->

    <div class="page-header">

        <div>

            <h1>
                📦 Current Stock
            </h1>

            <p>
                View the current quantity available for every grocery item.
            </p>

        </div>


        <div class="header-right">

            <div class="manager">

                Store Manager:

                <strong>
                    <%= store.name %>
                </strong>

            </div>


            <a
                href="/store/dashboard"
                class="back-dashboard">

                ← Back to Dashboard

            </a>

        </div>

    </div>


    <!-- ================= SUMMARY ================= -->

    <%
        let totalItems = stock.length;
        let lowItems = 0;
        let outItems = 0;

        stock.forEach(item => {

            const current = parseFloat(item.current_stock || 0);
            const minimum = parseFloat(item.minimum_stock || 0);

            if(current <= 0){
                outItems++;
            }
            else if(current <= minimum){
                lowItems++;
            }

        });
    %>


    <div class="summary-grid">


        <div class="summary-card">

            <div class="summary-icon blue">
                📦
            </div>

            <div class="summary-info">

                <h3>
                    <%= totalItems %>
                </h3>

                <p>
                    Total Items
                </p>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon red">
                ⚠️
            </div>

            <div class="summary-info">

                <h3>
                    <%= lowItems %>
                </h3>

                <p>
                    Low Stock Items
                </p>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon red">
                🚫
            </div>

            <div class="summary-info">

                <h3>
                    <%= outItems %>
                </h3>

                <p>
                    Out of Stock
                </p>

            </div>

        </div>

    </div>


    <!-- ================= STOCK TABLE ================= -->

    <div class="table-card">


        <div class="table-header">

            <div>

                <h2>
                    Inventory Overview
                </h2>

                <p>
                    Current available stock and minimum stock levels.
                </p>

            </div>


            <div class="stock-badge">

                <%= totalItems %> Items

            </div>

        </div>


        <div class="table-wrapper">

            <table>

                <thead>

                    <tr>

                        <th>#</th>

                        <th>Item</th>

                        <th>Category</th>

                        <th>Current Stock</th>

                        <th>Minimum Stock</th>

                        <th>Status</th>

                    </tr>

                </thead>


                <tbody>


                <% if(stock.length === 0){ %>

                    <tr>

                        <td
                            colspan="6"
                            class="empty">

                            <span class="empty-icon">
                                📦
                            </span>

                            No stock records found.

                        </td>

                    </tr>

                <% }else{ %>


                    <% stock.forEach((item,index) => { %>


                        <%
                            const current =
                                parseFloat(item.current_stock || 0);

                            const minimum =
                                parseFloat(item.minimum_stock || 0);

                            let statusClass = "ok";
                            let statusText = "✓ Available";
                            let rowClass = "";

                            if(current <= 0){

                                statusClass = "zero";
                                statusText = "⚠ Out of Stock";
                                rowClass = "low-row";

                            }else if(current <= minimum){

                                statusClass = "low";
                                statusText = "⚠ Low Stock";
                                rowClass = "low-row";

                            }
                        %>


                        <tr class="<%= rowClass %>">


                            <td>
                                <%= index + 1 %>
                            </td>


                            <td class="item-name">

                                <%= item.item_name %>

                            </td>


                            <td class="category">

                                <%= item.category %>

                            </td>


                            <td>

                                <span class="quantity">

                                    <%= item.current_stock %>

                                </span>

                                <span class="unit">

                                    <%= item.unit %>

                                </span>

                            </td>


                            <td>

                                <span class="quantity">

                                    <%= item.minimum_stock %>

                                </span>

                                <span class="unit">

                                    <%= item.unit %>

                                </span>

                            </td>


                            <td>

                                <span
                                    class="status <%= statusClass %>">

                                    <%= statusText %>

                                </span>

                            </td>


                        </tr>


                    <% }) %>


                <% } %>


                </tbody>

            </table>

        </div>

    </div>


</main>


<script>

function openSidebar(){

    document
        .getElementById("sidebar")
        .classList.add("open");

    document
        .getElementById("sidebarOverlay")
        .classList.add("show");

}


function closeSidebar(){

    document
        .getElementById("sidebar")
        .classList.remove("open");

    document
        .getElementById("sidebarOverlay")
        .classList.remove("show");

}

</script>


</body>

</html>
