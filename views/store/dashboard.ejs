<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Store Manager Dashboard</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background: #f1f5f9;
            color: #1e293b;
            overflow-x: hidden;
        }

        /* =========================
           LAYOUT
        ========================= */

        .app {
            min-height: 100vh;
        }

        /* =========================
           SIDEBAR
        ========================= */

        .sidebar {
            position: fixed;
            left: 0;
            top: 0;
            width: 260px;
            height: 100vh;

            background: linear-gradient(
                180deg,
                #0f172a,
                #1e293b
            );

            color: white;
            z-index: 1000;

            display: flex;
            flex-direction: column;

            box-shadow: 4px 0 20px rgba(0, 0, 0, 0.15);

            transition: transform 0.3s ease;
        }

        .brand {
            padding: 25px 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255,255,255,0.1);
        }

        .brand-icon {
            font-size: 42px;
            margin-bottom: 8px;
        }

        .brand h2 {
            font-size: 20px;
            font-weight: 700;
        }

        .brand span {
            display: block;
            margin-top: 5px;
            font-size: 12px;
            color: #94a3b8;
        }

        /* =========================
           NAVIGATION
        ========================= */

        .nav {
            padding: 20px 12px;
            flex: 1;
        }

        .nav a {
            display: flex;
            align-items: center;
            gap: 13px;

            padding: 13px 16px;
            margin-bottom: 6px;

            color: #cbd5e1;
            text-decoration: none;

            border-radius: 9px;

            font-size: 15px;
            font-weight: 500;

            transition: all 0.25s ease;
        }

        .nav a:hover {
            background: rgba(255,255,255,0.09);
            color: white;
            transform: translateX(4px);
        }

        .nav a.active {
            background: linear-gradient(
                135deg,
                #2563eb,
                #1d4ed8
            );

            color: white;

            box-shadow:
                0 5px 15px rgba(37,99,235,0.3);
        }

        .nav-icon {
            width: 25px;
            text-align: center;
            font-size: 18px;
        }

        /* =========================
           LOGOUT
        ========================= */

        .logout {
            padding: 15px 12px 25px;
            border-top: 1px solid rgba(255,255,255,0.1);
        }

        .logout a {
            display: flex;
            align-items: center;
            gap: 13px;

            padding: 13px 16px;

            color: #fecaca;
            text-decoration: none;

            border-radius: 9px;

            transition: .25s;
        }

        .logout a:hover {
            background: rgba(239,68,68,.15);
            color: #fca5a5;
        }

        /* =========================
           MAIN CONTENT
        ========================= */

        .main {
            margin-left: 260px;
            min-height: 100vh;
            padding: 30px;
        }

        /* =========================
           MOBILE HEADER
        ========================= */

        .mobile-header {
            display: none;

            align-items: center;
            justify-content: space-between;

            background: white;

            padding: 15px 18px;

            margin-bottom: 20px;

            border-radius: 12px;

            box-shadow: 0 4px 15px rgba(0,0,0,.06);
        }

        .menu-btn {
            border: none;
            background: #2563eb;
            color: white;

            width: 42px;
            height: 42px;

            border-radius: 8px;

            font-size: 22px;
            cursor: pointer;
        }

        .mobile-title {
            font-size: 17px;
            font-weight: 700;
        }

        /* =========================
           TOP HEADER
        ========================= */

        .top-header {
            display: flex;
            justify-content: space-between;
            align-items: center;

            background: white;

            padding: 25px 30px;

            border-radius: 15px;

            box-shadow: 0 4px 15px rgba(0,0,0,.05);

            margin-bottom: 25px;
        }

        .welcome h1 {
            font-size: 26px;
            color: #0f172a;
            margin-bottom: 6px;
        }

        .welcome h1 span {
            color: #2563eb;
        }

        .welcome p {
            color: #64748b;
            font-size: 14px;
        }

        .manager-box {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .manager-icon {
            width: 45px;
            height: 45px;

            border-radius: 50%;

            background: #dbeafe;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 22px;
        }

        .manager-info strong {
            display: block;
            color: #1e293b;
        }

        .manager-info small {
            color: #64748b;
        }

        /* =========================
           SECTION TITLE
        ========================= */

        .section-title {
            display: flex;
            justify-content: space-between;
            align-items: center;

            margin: 25px 0 15px;
        }

        .section-title h2 {
            font-size: 19px;
            color: #0f172a;
        }

        .section-title p {
            font-size: 13px;
            color: #64748b;
        }

        /* =========================
           CARDS
        ========================= */

        .cards {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));

            gap: 20px;
        }

        .card {
            position: relative;

            background: white;

            padding: 25px;

            border-radius: 15px;

            box-shadow: 0 5px 18px rgba(0,0,0,.06);

            text-decoration: none;
            color: inherit;

            transition: all .3s ease;

            overflow: hidden;
        }

        .card::before {
            content: "";

            position: absolute;

            left: 0;
            top: 0;

            width: 100%;
            height: 4px;

            background: #2563eb;
        }

        .card:hover {
            transform: translateY(-6px);

            box-shadow:
                0 12px 25px rgba(0,0,0,.1);
        }

        .card-icon {
            width: 55px;
            height: 55px;

            border-radius: 13px;

            display: flex;
            align-items: center;
            justify-content: center;

            font-size: 27px;

            margin-bottom: 18px;
        }

        .blue {
            background: #dbeafe;
        }

        .green {
            background: #dcfce7;
        }

        .orange {
            background: #ffedd5;
        }

        .purple {
            background: #ede9fe;
        }

        .cyan {
            background: #cffafe;
        }

        .card h3 {
            font-size: 17px;
            margin-bottom: 6px;
            color: #1e293b;
        }

        .card p {
            font-size: 13px;
            color: #64748b;
            line-height: 1.5;
        }

        .arrow {
            position: absolute;
            right: 20px;
            bottom: 20px;

            color: #94a3b8;
            font-size: 20px;

            transition: .25s;
        }

        .card:hover .arrow {
            color: #2563eb;
            transform: translateX(4px);
        }

        /* =========================
           QUICK INFO
        ========================= */

        .info-section {
            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(260px, 1fr));

            gap: 20px;

            margin-top: 25px;
        }

        .info-card {
            background: white;

            border-radius: 15px;

            padding: 22px;

            box-shadow: 0 5px 18px rgba(0,0,0,.05);
        }

        .info-card h3 {
            font-size: 16px;
            margin-bottom: 10px;
        }

        .info-card p {
            color: #64748b;
            font-size: 13px;
            line-height: 1.6;
        }

        /* =========================
           OVERLAY
        ========================= */

        .sidebar-overlay {
            display: none;

            position: fixed;
            inset: 0;

            background: rgba(0,0,0,.5);

            z-index: 999;
        }

        /* =========================
           MOBILE
        ========================= */

        @media(max-width: 768px) {

            .sidebar {
                transform: translateX(-100%);
                width: 270px;
            }

            .sidebar.open {
                transform: translateX(0);
            }

            .sidebar-overlay.show {
                display: block;
            }

            .main {
                margin-left: 0;
                padding: 15px;
            }

            .mobile-header {
                display: flex;
            }

            .top-header {
                padding: 20px;

                flex-direction: column;
                align-items: flex-start;

                gap: 18px;
            }

            .welcome h1 {
                font-size: 22px;
            }

            .manager-box {
                width: 100%;
            }

            .cards {
                grid-template-columns: 1fr;
            }

            .info-section {
                grid-template-columns: 1fr;
            }

            .section-title {
                align-items: flex-start;
                flex-direction: column;
                gap: 5px;
            }
        }

        @media(min-width:769px) {

            .main {
                overflow-y: auto;
                height: 100vh;
            }
        }
    </style>

</head>

<body>

<div class="app">

    <!-- ================= SIDEBAR ================= -->

    <aside class="sidebar" id="sidebar">

        <div class="brand">

            <div class="brand-icon">
                📦
            </div>

            <h2>Store Manager</h2>

            <span>Hostel Inventory System</span>

        </div>


        <nav class="nav">

            <a href="/store/dashboard" class="active">
                <span class="nav-icon">🏠</span>
                Dashboard
            </a>

            <a href="/store/items">
                <span class="nav-icon">📋</span>
                Master Items
            </a>

            <a href="/store/stock-entry">
                <span class="nav-icon">📥</span>
                Stock Entry
            </a>

            <a href="/store/current-stock">
                <span class="nav-icon">📦</span>
                Current Stock
            </a>

            <a href="/store/daily-usage">
                <span class="nav-icon">🍽️</span>
                Daily Usage
            </a>

            <a href="/store/reports">
                <span class="nav-icon">📊</span>
                Reports
            </a>

        </nav>


        <div class="logout">

            <a href="/store/logout">
                <span class="nav-icon">🚪</span>
                Logout
            </a>

        </div>

    </aside>


    <!-- MOBILE OVERLAY -->

    <div
        class="sidebar-overlay"
        id="sidebarOverlay"
        onclick="closeSidebar()">
    </div>


    <!-- ================= MAIN ================= -->

    <main class="main">

        <!-- MOBILE HEADER -->

        <div class="mobile-header">

            <button
                class="menu-btn"
                onclick="openSidebar()">
                ☰
            </button>

            <div class="mobile-title">
                📦 Store Management
            </div>

            <div></div>

        </div>


        <!-- TOP HEADER -->

        <div class="top-header">

            <div class="welcome">

                <h1>
                    Welcome,
                    <span><%= store.name %></span> 👋
                </h1>

                <p>
                    Manage hostel grocery inventory, stock and daily usage.
                </p>

            </div>


            <div class="manager-box">

                <div class="manager-icon">
                    👤
                </div>

                <div class="manager-info">

                    <strong>
                        <%= store.name %>
                    </strong>

                    <small>
                        Store Manager
                    </small>

                </div>

            </div>

        </div>


        <!-- SECTION -->

        <div class="section-title">

            <div>
                <h2>Inventory Management</h2>

                <p>
                    Select an option to manage your hostel inventory.
                </p>
            </div>

        </div>


        <!-- ================= CARDS ================= -->

        <div class="cards">


            <a
                href="/store/items"
                class="card">

                <div class="card-icon blue">
                    📋
                </div>

                <h3>
                    Master Items
                </h3>

                <p>
                    Add, edit and manage all grocery items.
                </p>

                <span class="arrow">
                    →
                </span>

            </a>


            <a
                href="/store/stock-entry"
                class="card">

                <div class="card-icon green">
                    📥
                </div>

                <h3>
                    Stock Entry
                </h3>

                <p>
                    Record newly received grocery stock and supplier details.
                </p>

                <span class="arrow">
                    →
                </span>

            </a>


            <a
                href="/store/current-stock"
                class="card">

                <div class="card-icon orange">
                    📦
                </div>

                <h3>
                    Current Stock
                </h3>

                <p>
                    View the available quantity of every grocery item.
                </p>

                <span class="arrow">
                    →
                </span>

            </a>


            <a
                href="/store/daily-usage"
                class="card">

                <div class="card-icon purple">
                    🍽️
                </div>

                <h3>
                    Daily Usage
                </h3>

                <p>
                    Record daily consumption and automatically reduce stock.
                </p>

                <span class="arrow">
                    →
                </span>

            </a>


            <a
                href="/store/reports"
                class="card">

                <div class="card-icon cyan">
                    📊
                </div>

                <h3>
                    Reports
                </h3>

                <p>
                    View inventory, usage and stock reports.
                </p>

                <span class="arrow">
                    →
                </span>

            </a>

        </div>


        <!-- ================= INFO ================= -->

        <div class="info-section">

            <div class="info-card">

                <h3>
                    📦 Inventory Management
                </h3>

                <p>
                    Maintain all grocery items, stock entries and available
                    quantities from one place.
                </p>

            </div>


            <div class="info-card">

                <h3>
                    🍽️ Daily Consumption
                </h3>

                <p>
                    Record how much stock is used every day to maintain
                    accurate inventory information.
                </p>

            </div>


            <div class="info-card">

                <h3>
                    📊 Reports
                </h3>

                <p>
                    Use reports to understand stock movement and daily
                    consumption patterns.
                </p>

            </div>

        </div>

    </main>

</div>


<script>

function openSidebar() {

    document
        .getElementById("sidebar")
        .classList.add("open");

    document
        .getElementById("sidebarOverlay")
        .classList.add("show");
}


function closeSidebar() {

    document
        .getElementById("sidebar")
        .classList.remove("open");

    document
        .getElementById("sidebarOverlay")
        .classList.remove("show");
}

</script>

</body>

</html>
