<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Store Reports | Store Manager</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",Tahoma,sans-serif;
}

body{
    background:#f1f5f9;
    color:#1e293b;
}

/* ================= SIDEBAR ================= */

.sidebar{
    position:fixed;
    left:0;
    top:0;
    width:260px;
    height:100vh;

    background:linear-gradient(180deg,#0f172a,#1e293b);

    color:white;
    z-index:1000;

    display:flex;
    flex-direction:column;

    box-shadow:4px 0 20px rgba(0,0,0,.15);

    transition:.3s;
}

.brand{
    padding:25px 20px;
    text-align:center;
    border-bottom:1px solid rgba(255,255,255,.1);
}

.brand-icon{
    font-size:40px;
    margin-bottom:8px;
}

.brand h2{
    font-size:20px;
}

.brand span{
    display:block;
    margin-top:5px;
    font-size:12px;
    color:#94a3b8;
}

.nav{
    padding:20px 12px;
    flex:1;
}

.nav a{
    display:flex;
    align-items:center;
    gap:13px;

    padding:13px 16px;
    margin-bottom:6px;

    color:#cbd5e1;
    text-decoration:none;

    border-radius:9px;

    transition:.25s;
}

.nav a:hover{
    background:rgba(255,255,255,.09);
    color:white;
    transform:translateX(4px);
}

.nav a.active{
    background:linear-gradient(
        135deg,
        #2563eb,
        #1d4ed8
    );

    color:white;
}

.nav-icon{
    width:25px;
    text-align:center;
    font-size:18px;
}

.logout{
    padding:15px 12px 25px;
    border-top:1px solid rgba(255,255,255,.1);
}

.logout a{
    display:flex;
    align-items:center;
    gap:13px;

    padding:13px 16px;

    color:#fecaca;
    text-decoration:none;

    border-radius:9px;
}

.logout a:hover{
    background:rgba(239,68,68,.15);
}

/* ================= MAIN ================= */

.main{
    margin-left:260px;
    min-height:100vh;
    padding:30px;
}

/* ================= MOBILE HEADER ================= */

.mobile-header{
    display:none;

    align-items:center;
    justify-content:space-between;

    background:white;

    padding:15px 18px;
    margin-bottom:20px;

    border-radius:12px;

    box-shadow:0 4px 15px rgba(0,0,0,.06);
}

.menu-btn{
    border:none;
    background:#2563eb;
    color:white;

    width:42px;
    height:42px;

    border-radius:8px;

    font-size:22px;
    cursor:pointer;
}

.mobile-title{
    font-size:17px;
    font-weight:700;
}

/* ================= PAGE HEADER ================= */

.page-header{
    background:white;

    padding:25px 30px;

    border-radius:15px;

    box-shadow:0 4px 15px rgba(0,0,0,.05);

    margin-bottom:25px;

    display:flex;

    justify-content:space-between;
    align-items:center;

    gap:20px;
}

.page-header h1{
    font-size:26px;
    color:#0f172a;
    margin-bottom:5px;
}

.page-header p{
    color:#64748b;
    font-size:14px;
}

.header-right{
    display:flex;
    align-items:center;
    gap:15px;
}

.manager{
    color:#64748b;
    font-size:14px;
    white-space:nowrap;
}

.manager strong{
    color:#2563eb;
}

.back-dashboard{
    display:inline-flex;

    align-items:center;
    justify-content:center;

    gap:6px;

    padding:10px 15px;

    background:#e2e8f0;
    color:#334155;

    border-radius:8px;

    text-decoration:none;

    font-size:13px;
    font-weight:600;

    transition:.25s;

    white-space:nowrap;
}

.back-dashboard:hover{
    background:#cbd5e1;
    transform:translateY(-2px);
}

/* ================= SUMMARY ================= */

.summary-grid{
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:20px;

    margin-bottom:25px;
}

.summary-card{
    background:white;

    padding:22px;

    border-radius:14px;

    box-shadow:0 5px 20px rgba(0,0,0,.06);

    display:flex;

    align-items:center;

    gap:16px;
}

.summary-icon{
    width:52px;
    height:52px;

    display:flex;

    align-items:center;
    justify-content:center;

    border-radius:12px;

    font-size:25px;
}

.blue{
    background:#dbeafe;
}

.green{
    background:#dcfce7;
}

.orange{
    background:#fef3c7;
}

.summary-info h3{
    font-size:24px;
    color:#0f172a;
}

.summary-info p{
    color:#64748b;
    font-size:13px;
    margin-top:2px;
}

/* ================= REPORT CARDS ================= */

.report-grid{
    display:grid;

    grid-template-columns:
        repeat(2,1fr);

    gap:20px;
}

.report-card{
    background:white;

    padding:25px;

    border-radius:15px;

    box-shadow:0 5px 20px rgba(0,0,0,.06);

    transition:.25s;
}

.report-card:hover{
    transform:translateY(-4px);

    box-shadow:
        0 10px 25px rgba(0,0,0,.09);
}

.report-top{
    display:flex;

    align-items:center;

    gap:15px;

    margin-bottom:15px;
}

.report-icon{
    width:52px;
    height:52px;

    display:flex;

    align-items:center;
    justify-content:center;

    border-radius:12px;

    font-size:25px;

    background:#eff6ff;
}

.report-card h2{
    font-size:18px;
    color:#0f172a;
}

.report-card p{
    color:#64748b;
    font-size:13px;
    line-height:1.5;
}

.report-btn{
    display:inline-flex;

    align-items:center;

    justify-content:center;

    margin-top:18px;

    padding:10px 15px;

    border-radius:8px;

    background:#2563eb;

    color:white;

    text-decoration:none;

    font-size:13px;

    font-weight:600;

    transition:.25s;
}

.report-btn:hover{
    background:#1d4ed8;
    transform:translateY(-2px);
}

/* ================= QUICK INFO ================= */

.info-card{
    background:white;

    margin-top:20px;

    padding:25px;

    border-radius:15px;

    box-shadow:0 5px 20px rgba(0,0,0,.06);
}

.info-card h2{
    font-size:19px;
    margin-bottom:15px;
}

.info-list{
    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    gap:15px;
}

.info-item{
    padding:16px;

    border-radius:10px;

    background:#f8fafc;

    border:1px solid #e2e8f0;
}

.info-item strong{
    display:block;

    font-size:14px;

    margin-bottom:5px;
}

.info-item span{
    color:#64748b;

    font-size:12px;

    line-height:1.5;
}

/* ================= OVERLAY ================= */

.sidebar-overlay{
    display:none;

    position:fixed;

    inset:0;

    background:rgba(0,0,0,.5);

    z-index:999;
}

/* ================= MOBILE ================= */

@media(max-width:768px){

    .sidebar{
        transform:translateX(-100%);
        width:270px;
    }

    .sidebar.open{
        transform:translateX(0);
    }

    .sidebar-overlay.show{
        display:block;
    }

    .main{
        margin-left:0;
        padding:15px;
    }

    .mobile-header{
        display:flex;
    }

    .page-header{
        padding:20px;

        flex-direction:column;

        align-items:flex-start;

        gap:15px;
    }

    .page-header h1{
        font-size:22px;
    }

    .header-right{
        width:100%;

        flex-direction:column;

        align-items:stretch;

        gap:10px;
    }

    .manager{
        white-space:normal;
    }

    .back-dashboard{
        width:100%;
    }

    .summary-grid{
        grid-template-columns:1fr;
        gap:12px;
    }

    .report-grid{
        grid-template-columns:1fr;
    }

    .info-list{
        grid-template-columns:1fr;
    }

}

</style>

</head>

<body>


<!-- ================= SIDEBAR ================= -->

<aside class="sidebar" id="sidebar">

    <div class="brand">

        <div class="brand-icon">
            📦
        </div>

        <h2>Store Manager</h2>

        <span>Hostel Inventory System</span>

    </div>


    <nav class="nav">

        <a href="/store/dashboard">

            <span class="nav-icon">
                🏠
            </span>

            Dashboard

        </a>


        <a href="/store/items">

            <span class="nav-icon">
                📋
            </span>

            Master Items

        </a>


        <a href="/store/stock-entry">

            <span class="nav-icon">
                📥
            </span>

            Stock Entry

        </a>


        <a href="/store/current-stock">

            <span class="nav-icon">
                📦
            </span>

            Current Stock

        </a>


        <a href="/store/daily-usage">

            <span class="nav-icon">
                🍽️
            </span>

            Daily Usage

        </a>


        <a href="/store/reports" class="active">

            <span class="nav-icon">
                📊
            </span>

            Reports

        </a>

    </nav>


    <div class="logout">

        <a href="/store/logout">

            <span class="nav-icon">
                🚪
            </span>

            Logout

        </a>

    </div>

</aside>


<!-- MOBILE OVERLAY -->

<div
    class="sidebar-overlay"
    id="sidebarOverlay"
    onclick="closeSidebar()">
</div>


<!-- ================= MAIN ================= -->

<main class="main">


    <!-- MOBILE HEADER -->

    <div class="mobile-header">

        <button
            class="menu-btn"
            onclick="openSidebar()">

            ☰

        </button>

        <div class="mobile-title">
            📦 Store Management
        </div>

        <div></div>

    </div>


    <!-- PAGE HEADER -->

    <div class="page-header">

        <div>

            <h1>
                📊 Store Reports
            </h1>

            <p>
                View and manage hostel grocery inventory information.
            </p>

        </div>


        <div class="header-right">

            <div class="manager">

                Store Manager:

                <strong>
                    <%= store.name %>
                </strong>

            </div>


            <a
                href="/store/dashboard"
                class="back-dashboard">

                ← Back to Dashboard

            </a>

        </div>

    </div>


    <!-- ================= SUMMARY ================= -->

    <div class="summary-grid">


        <div class="summary-card">

            <div class="summary-icon blue">
                📦
            </div>

            <div class="summary-info">

                <h3>
                    Inventory
                </h3>

                <p>
                    Current Stock
                </p>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon green">
                📥
            </div>

            <div class="summary-info">

                <h3>
                    Entries
                </h3>

                <p>
                    Stock Received
                </p>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon orange">
                🍽️
            </div>

            <div class="summary-info">

                <h3>
                    Usage
                </h3>

                <p>
                    Daily Consumption
                </p>

            </div>

        </div>

    </div>


    <!-- ================= REPORT CARDS ================= -->

    <div class="report-grid">


        <!-- CURRENT STOCK -->

        <div class="report-card">

            <div class="report-top">

                <div class="report-icon">
                    📦
                </div>

                <div>

                    <h2>
                        Current Stock
                    </h2>

                </div>

            </div>


            <p>
                Check the current quantity of every grocery item,
                minimum stock level and low-stock status.
            </p>


            <a
                href="/store/current-stock"
                class="report-btn">

                View Current Stock →

            </a>

        </div>


        <!-- STOCK ENTRY -->

        <div class="report-card">

            <div class="report-top">

                <div class="report-icon">
                    📥
                </div>

                <div>

                    <h2>
                        Stock Entries
                    </h2>

                </div>

            </div>


            <p>
                Record and review grocery stock received from
                suppliers and maintain purchase information.
            </p>


            <a
                href="/store/stock-entry"
                class="report-btn">

                Open Stock Entry →

            </a>

        </div>


        <!-- DAILY USAGE -->

        <div class="report-card">

            <div class="report-top">

                <div class="report-icon">
                    🍽️
                </div>

                <div>

                    <h2>
                        Daily Usage
                    </h2>

                </div>

            </div>


            <p>
                Record groceries consumed by the hostel and
                view today's usage history.
            </p>


            <a
                href="/store/daily-usage"
                class="report-btn">

                View Daily Usage →

            </a>

        </div>


        <!-- MASTER ITEMS -->

        <div class="report-card">

            <div class="report-top">

                <div class="report-icon">
                    📋
                </div>

                <div>

                    <h2>
                        Master Items
                    </h2>

                </div>

            </div>


            <p>
                Manage grocery item names, categories, units,
                minimum stock levels and item status.
            </p>


            <a
                href="/store/items"
                class="report-btn">

                Manage Items →

            </a>

        </div>

    </div>


    <!-- ================= QUICK INFO ================= -->

    <div class="info-card">

        <h2>
            💡 Inventory Workflow
        </h2>


        <div class="info-list">


            <div class="info-item">

                <strong>
                    1. Master Items
                </strong>

                <span>
                    Create the grocery items that are maintained
                    by the hostel store.
                </span>

            </div>


            <div class="info-item">

                <strong>
                    2. Stock Entry
                </strong>

                <span>
                    Enter the quantity received from suppliers.
                    This increases the available stock.
                </span>

            </div>


            <div class="info-item">

                <strong>
                    3. Daily Usage
                </strong>

                <span>
                    Record the quantity consumed each day.
                    This automatically reduces current stock.
                </span>

            </div>


            <div class="info-item">

                <strong>
                    4. Current Stock
                </strong>

                <span>
                    Check the remaining quantity and identify
                    items that have reached minimum stock.
                </span>

            </div>


            <div class="info-item">

                <strong>
                    5. Low Stock
                </strong>

                <span>
                    Items at or below the minimum stock level
                    should be considered for the next purchase.
                </span>

            </div>


            <div class="info-item">

                <strong>
                    6. Reports
                </strong>

                <span>
                    Use the available sections to review and
                    manage inventory activities.
                </span>

            </div>

        </div>

    </div>


</main>


<script>

function openSidebar(){

    document
        .getElementById("sidebar")
        .classList.add("open");

    document
        .getElementById("sidebarOverlay")
        .classList.add("show");

}


function closeSidebar(){

    document
        .getElementById("sidebar")
        .classList.remove("open");

    document
        .getElementById("sidebarOverlay")
        .classList.remove("show");

}

</script>


</body>

</html>
