<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Master Items | Store Manager</title>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:"Segoe UI",Tahoma,sans-serif;
}

body{
    background:#f1f5f9;
    color:#1e293b;
}

/* ================= SIDEBAR ================= */

.sidebar{
    position:fixed;
    left:0;
    top:0;
    width:260px;
    height:100vh;

    background:linear-gradient(180deg,#0f172a,#1e293b);

    color:white;
    z-index:1000;

    display:flex;
    flex-direction:column;

    box-shadow:4px 0 20px rgba(0,0,0,.15);

    transition:.3s;
}

.brand{
    padding:25px 20px;
    text-align:center;

    border-bottom:1px solid rgba(255,255,255,.1);
}

.brand-icon{
    font-size:40px;
    margin-bottom:8px;
}

.brand h2{
    font-size:20px;
}

.brand span{
    display:block;
    margin-top:5px;

    font-size:12px;
    color:#94a3b8;
}

.nav{
    padding:20px 12px;
    flex:1;
}

.nav a{
    display:flex;
    align-items:center;
    gap:13px;

    padding:13px 16px;
    margin-bottom:6px;

    color:#cbd5e1;
    text-decoration:none;

    border-radius:9px;

    transition:.25s;
}

.nav a:hover{
    background:rgba(255,255,255,.09);
    color:white;

    transform:translateX(4px);
}

.nav a.active{
    background:linear-gradient(
        135deg,
        #2563eb,
        #1d4ed8
    );

    color:white;
}

.nav-icon{
    width:25px;
    text-align:center;
    font-size:18px;
}

.logout{
    padding:15px 12px 25px;

    border-top:1px solid rgba(255,255,255,.1);
}

.logout a{
    display:flex;
    align-items:center;
    gap:13px;

    padding:13px 16px;

    color:#fecaca;
    text-decoration:none;

    border-radius:9px;
}

.logout a:hover{
    background:rgba(239,68,68,.15);
}

/* ================= MAIN ================= */

.main{
    margin-left:260px;
    min-height:100vh;
    padding:30px;
}

/* ================= MOBILE HEADER ================= */

.mobile-header{
    display:none;

    align-items:center;
    justify-content:space-between;

    background:white;

    padding:15px 18px;

    margin-bottom:20px;

    border-radius:12px;

    box-shadow:0 4px 15px rgba(0,0,0,.06);
}

.menu-btn{
    border:none;

    background:#2563eb;
    color:white;

    width:42px;
    height:42px;

    border-radius:8px;

    font-size:22px;

    cursor:pointer;
}

.mobile-title{
    font-size:17px;
    font-weight:700;
}

/* ================= PAGE HEADER ================= */

.page-header{
    background:white;

    padding:25px 30px;

    border-radius:15px;

    box-shadow:0 4px 15px rgba(0,0,0,.05);

    margin-bottom:25px;

    display:flex;

    justify-content:space-between;
    align-items:center;

    gap:20px;
}

.page-header h1{
    font-size:26px;

    color:#0f172a;

    margin-bottom:5px;
}

.page-header p{
    color:#64748b;

    font-size:14px;
}

.add-btn{
    display:inline-flex;

    align-items:center;

    gap:8px;

    background:linear-gradient(
        135deg,
        #2563eb,
        #1d4ed8
    );

    color:white;

    padding:12px 18px;

    border-radius:9px;

    text-decoration:none;

    font-size:14px;

    font-weight:600;

    white-space:nowrap;

    box-shadow:
        0 5px 12px rgba(37,99,235,.2);

    transition:.25s;
}

.add-btn:hover{
    transform:translateY(-2px);

    box-shadow:
        0 8px 18px rgba(37,99,235,.3);
}

/* ================= TABLE CARD ================= */

.table-card{
    background:white;

    border-radius:15px;

    padding:25px;

    box-shadow:0 5px 20px rgba(0,0,0,.06);

    overflow:hidden;
}

.table-header{
    margin-bottom:20px;
}

.table-header h2{
    font-size:18px;
    color:#1e293b;
}

.table-header p{
    color:#64748b;

    font-size:13px;

    margin-top:4px;
}

/* ================= TABLE ================= */

.table-wrapper{
    width:100%;
    overflow-x:auto;
}

table{
    width:100%;

    border-collapse:collapse;

    min-width:800px;
}

thead th{
    background:#0f172a;

    color:white;

    padding:14px 12px;

    text-align:center;

    font-size:13px;

    font-weight:600;
}

tbody td{
    padding:14px 12px;

    border-bottom:1px solid #e2e8f0;

    text-align:center;

    font-size:14px;
}

tbody tr{
    transition:.2s;
}

tbody tr:hover{
    background:#f8fafc;
}

.item-id{
    color:#64748b;
    font-weight:600;
}

.item-name{
    color:#1e293b;
    font-weight:600;
}

.category{
    color:#64748b;
}

.unit{
    display:inline-block;

    padding:5px 10px;

    background:#eff6ff;

    color:#2563eb;

    border-radius:15px;

    font-size:12px;

    font-weight:600;
}

.minimum{
    font-weight:600;
}

.status{
    display:inline-block;

    padding:6px 12px;

    border-radius:20px;

    font-size:12px;

    font-weight:700;
}

.status.active{
    background:#dcfce7;
    color:#15803d;
}

.status.inactive{
    background:#fee2e2;
    color:#dc2626;
}

/* ================= ACTIONS ================= */

.actions{
    display:flex;

    justify-content:center;

    align-items:center;

    gap:8px;
}

.action-btn{
    padding:7px 12px;

    border-radius:7px;

    text-decoration:none;

    font-size:12px;

    font-weight:600;

    transition:.2s;
}

.edit{
    background:#dbeafe;
    color:#2563eb;
}

.edit:hover{
    background:#bfdbfe;
}

.delete{
    background:#fee2e2;
    color:#dc2626;
}

.delete:hover{
    background:#fecaca;
}

/* ================= EMPTY ================= */

.empty{
    padding:45px 20px !important;

    text-align:center !important;

    color:#64748b;

    font-size:14px;
}

.empty-icon{
    font-size:40px;

    display:block;

    margin-bottom:10px;
}

/* ================= OVERLAY ================= */

.sidebar-overlay{
    display:none;

    position:fixed;

    inset:0;

    background:rgba(0,0,0,.5);

    z-index:999;
}

/* ================= MOBILE ================= */

@media(max-width:768px){

    .sidebar{
        transform:translateX(-100%);

        width:270px;
    }

    .sidebar.open{
        transform:translateX(0);
    }

    .sidebar-overlay.show{
        display:block;
    }

    .main{
        margin-left:0;

        padding:15px;
    }

    .mobile-header{
        display:flex;
    }

    .page-header{
        padding:20px;

        flex-direction:column;

        align-items:flex-start;
    }

    .page-header h1{
        font-size:22px;
    }

    .add-btn{
        width:100%;

        justify-content:center;
    }

    .table-card{
        padding:15px;
    }

    .table-header{
        margin-bottom:15px;
    }

}

</style>

</head>

<body>


<!-- ================= SIDEBAR ================= -->

<aside class="sidebar" id="sidebar">

    <div class="brand">

        <div class="brand-icon">
            📦
        </div>

        <h2>Store Manager</h2>

        <span>Hostel Inventory System</span>

    </div>


    <nav class="nav">

        <a href="/store/dashboard">

            <span class="nav-icon">
                🏠
            </span>

            Dashboard

        </a>


        <a href="/store/items" class="active">

            <span class="nav-icon">
                📋
            </span>

            Master Items

        </a>


        <a href="/store/stock-entry">

            <span class="nav-icon">
                📥
            </span>

            Stock Entry

        </a>


        <a href="/store/current-stock">

            <span class="nav-icon">
                📦
            </span>

            Current Stock

        </a>


        <a href="/store/daily-usage">

            <span class="nav-icon">
                🍽️
            </span>

            Daily Usage

        </a>


        <a href="/store/reports">

            <span class="nav-icon">
                📊
            </span>

            Reports

        </a>

    </nav>


    <div class="logout">

        <a href="/store/logout">

            <span class="nav-icon">
                🚪
            </span>

            Logout

        </a>

    </div>

</aside>


<!-- MOBILE OVERLAY -->

<div
    class="sidebar-overlay"
    id="sidebarOverlay"
    onclick="closeSidebar()">
</div>


<!-- ================= MAIN ================= -->

<main class="main">


    <!-- MOBILE HEADER -->

    <div class="mobile-header">

        <button
            class="menu-btn"
            onclick="openSidebar()">

            ☰

        </button>

        <div class="mobile-title">
            📦 Store Management
        </div>

        <div></div>

    </div>


    <!-- PAGE HEADER -->

    <div class="page-header">

        <div>

            <h1>
                📋 Master Grocery Items
            </h1>

            <p>
                Manage the grocery items used by the hostel store.
            </p>

        </div>


        <a
            href="/store/items/add"
            class="add-btn">

            ➕ Add Item

        </a>

    </div>


    <!-- TABLE -->

    <div class="table-card">


        <div class="table-header">

            <h2>
                Grocery Item Master
            </h2>

            <p>
                Add, edit or manage your grocery item list.
            </p>

        </div>


        <div class="table-wrapper">

            <table>

                <thead>

                    <tr>

                        <th>ID</th>

                        <th>Item Name</th>

                        <th>Category</th>

                        <th>Unit</th>

                        <th>Minimum Stock</th>

                        <th>Status</th>

                        <th>Action</th>

                    </tr>

                </thead>


                <tbody>


                <% if(items.length === 0){ %>

                    <tr>

                        <td
                            colspan="7"
                            class="empty">

                            <span class="empty-icon">
                                📦
                            </span>

                            No Grocery Items Found

                        </td>

                    </tr>

                <% } %>


                <% items.forEach(item => { %>

                    <tr>


                        <td class="item-id">

                            #<%= item.id %>

                        </td>


                        <td class="item-name">

                            <%= item.item_name %>

                        </td>


                        <td class="category">

                            <%= item.category %>

                        </td>


                        <td>

                            <span class="unit">

                                <%= item.unit %>

                            </span>

                        </td>


                        <td class="minimum">

                            <%= item.minimum_stock %>

                            <span class="category">
                                <%= item.unit %>
                            </span>

                        </td>


                        <td>

                            <% if(item.status === "Active"){ %>

                                <span class="status active">

                                    ✓ Active

                                </span>

                            <% }else{ %>

                                <span class="status inactive">

                                    ✕ Inactive

                                </span>

                            <% } %>

                        </td>


                        <td>

                            <div class="actions">


                                <a
                                    href="/store/items/edit/<%= item.id %>"
                                    class="action-btn edit">

                                    ✏️ Edit

                                </a>


                                <a
                                    href="/store/items/delete/<%= item.id %>"
                                    class="action-btn delete"
                                    onclick="return confirm('Delete this item?')">

                                    🗑 Delete

                                </a>


                            </div>

                        </td>


                    </tr>

                <% }) %>


                </tbody>

            </table>

        </div>

    </div>


</main>


<script>

function openSidebar(){

    document
        .getElementById("sidebar")
        .classList.add("open");

    document
        .getElementById("sidebarOverlay")
        .classList.add("show");

}


function closeSidebar(){

    document
        .getElementById("sidebar")
        .classList.remove("open");

    document
        .getElementById("sidebarOverlay")
        .classList.remove("show");

}

</script>


</body>

</html>
