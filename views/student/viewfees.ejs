<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Fees Dashboard | Student Portal</title>

<style>
/* ========= DESIGN TOKENS ========= */
:root {
    --bg-dark: #020617;
    --bg-surface: rgba(15, 23, 42, 0.92);
    --bg-card: rgba(15, 23, 42, 0.75);
    --text-main: #e5e7eb;
    --text-muted: #9ca3af;
    --gold: #fbbf24;

    --status-approved: #22c55e;
    --status-pending: #facc15;
    --status-rejected: #ef4444;

    --radius-lg: 14px;
    --radius-md: 10px;

    --shadow-soft: 0 18px 45px rgba(0,0,0,0.45);
}

/* ========= GLOBAL ========= */
body {
    margin: 0;
    padding: 35px 16px;
    background: radial-gradient(circle at top, #1f2937 0, #020617 55%);
    font-family: "Poppins", sans-serif;
    color: var(--text-main);
}

.container {
    max-width: 1050px;
    margin: 0 auto;
}

/* ========= PAGE TITLE ========= */
h2 {
    text-align: center;
    font-size: 26px;
    margin-bottom: 20px;
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: 1px;
}

h3 {
    margin-top: 35px;
    color: var(--gold);
    letter-spacing: 0.8px;
}

/* ========= SUMMARY CARDS ========= */
.summary-boxes {
    display: flex;
    gap: 20px;
    justify-content: space-evenly;
    flex-wrap: wrap;
    margin-bottom: 25px;
}

.summary-card {
    background: var(--bg-card);
    padding: 18px 20px;
    border-radius: var(--radius-lg);
    border: 1px solid rgba(255,255,255,0.12);
    box-shadow: var(--shadow-soft);
    width: 300px;
    text-align: center;
}

.summary-card h4 {
    font-size: 16px;
    margin: 0;
    color: var(--text-muted);
}

.summary-card p {
    margin: 8px 0 0;
    font-size: 22px;
    font-weight: 700;
    color: var(--gold);
}

/* ========= TABLE CARD ========= */
.table-card {
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-soft);
    padding: 20px;
    border: 1px solid rgba(255,255,255,0.12);
}

.table-wrapper {
    overflow-x: auto;
    border-radius: 12px;
    border: 1px solid rgba(255,255,255,0.12);
}

/* TABLE STYLING */
.fees-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    color: var(--text-main);
}

.fees-table th,
.fees-table td {
    padding: 12px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    white-space: nowrap;
}

.fees-table th {
    background: rgba(2, 6, 23, 0.8);
    color: var(--gold);
    text-transform: uppercase;
    font-size: 11px;
    letter-spacing: 0.06em;
    font-weight: 600;
}

.fees-table tbody tr:nth-child(even) {
    background: rgba(255,255,255,0.03);
}

.fees-table tbody tr:hover {
    background: rgba(255,255,255,0.07);
}

/* ========= STATUS BADGES ========= */
.status-badge {
    padding: 4px 10px;
    border-radius: 999px;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
}

.status-APPROVED { background: rgba(34,197,94,0.2); color: var(--status-approved); }
.status-PENDING { background: rgba(250,204,21,0.25); color: var(--status-pending); }
.status-REJECTED { background: rgba(239,68,68,0.2); color: var(--status-rejected); }

/* ========= MOBILE TABLE (CARDS) ========= */
@media (max-width: 720px) {
    .fees-table {
        border-collapse: separate;
        border-spacing: 0 12px;
        background: transparent;
    }

    .fees-table thead { display: none; }

    .fees-table tbody tr {
        display: block;
        background: var(--bg-card);
        border-radius: 12px;
        padding: 10px 12px;
        border: 1px solid rgba(255,255,255,0.12);
        margin-bottom: 12px;
    }

    .fees-table td {
        display: flex;
        justify-content: space-between;
        padding: 6px 4px;
        border-bottom: none;
        font-size: 13px;
        white-space: normal;
    }

    .fees-table td::before {
        content: attr(data-label);
        font-weight: 600;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-right: 10px;
        font-size: 11px;
    }
}

/* ========= BACK BUTTON ========= */
.back-link {
    display: block;
    margin: 30px auto 0;
    width: 240px;
    text-align: center;
    padding: 12px;
    border-radius: var(--radius-md);
    text-decoration: none;
    font-weight: 700;
    background: var(--gold);
    color: black;
    letter-spacing: 0.6px;
    box-shadow: 0 12px 25px rgba(251,191,36,0.25);
    transition: 0.2s;
}

.back-link:hover {
    background: #ffdd4d;
    transform: translateY(-2px);
}
/* ========= DOWNLOAD BUTTON ========= */
.status-download-btn{
    display: inline-flex;
    align-items: center;
    gap: 6px;

    padding: 6px 14px;
    border-radius: 999px;

    background: linear-gradient(135deg, #fbbf24, #fde68a);
    color: #1f2937;

    font-weight: 700;
    font-size: 13px;
    text-decoration: none;

    box-shadow: 0 6px 18px rgba(251,191,36,0.35);
    transition: all 0.2s ease;
}

.status-download-btn:hover{
    background: linear-gradient(135deg, #fde68a, #fbbf24);
    transform: translateY(-2px) scale(1.03);
    box-shadow: 0 10px 25px rgba(251,191,36,0.45);
}

.status-download-btn:active{
    transform: scale(0.96);
}

</style>
</head>

<body>


<div class="container">
    <h2>Fees Dashboard</h2>

    <!-- SUMMARY BOXES -->
    <div class="summary-boxes">
        <div class="summary-card">
            <h4>Total Paid</h4>
            <p>₹ <%= total_paid %></p>
        </div>
        <div class="summary-card">
            <h4>Remaining Due</h4>
            <p>₹ <%= remaining_due %></p>
        </div>
    </div>

    <!-- RECEIPTS TABLE -->
    <h3>Uploaded Receipts</h3>
    <div class="table-card">
        <div class="table-wrapper">
            <table class="fees-table">
                <thead>
                    <tr>
                        <th>Ref ID</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>PDF</th>
                        <th>Uploaded At</th>
                    </tr>
                </thead>

                <tbody>
                <% receipts.forEach(r => { 
                    const status = r.status ? r.status.toUpperCase() : "PENDING";
                %>
                    <tr>
                        <td data-label="Ref ID"><%= r.ref_id %></td>
                        <td data-label="Amount">₹ <%= r.amount_paid %></td>

                        <td data-label="Status">
                            <span class="status-badge status-<%= status %>">
                                <%= status %>
                            </span>
                        </td>

                        <td data-label="PDF">
                            <% if (r.pdf_path) { %>
  <a href="/<%= r.pdf_path %>"
     class="status-download-btn"
     download>
     ⬇ Download
  </a>
<% } else { %>
  N/A
<% } %>

                        </td>

                        <td data-label="Uploaded At">
                            <%= new Date(r.created_at).toLocaleString('en-IN', { dateStyle: 'short', timeStyle: 'short' }) %>
                        </td>
                    </tr>
                <% }) %>
                </tbody>

            </table>
        </div>
    </div>

    <a href="/student/dashboard" class="back-link">← Back to Dashboard</a>
</div>



</body>
</html>
