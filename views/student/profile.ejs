<div class="student-profile-page">
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;600;700&display=swap');

    :root {
      --accent: #6366f1;
      --accent-soft: rgba(99, 102, 241, 0.1);
      --glass: rgba(255, 255, 255, 0.8);
      --glass-border: rgba(255, 255, 255, 0.5);
      --text-dark: #0f172a;
      --text-light: #64748b;
      --card-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.05), 0 10px 10px -5px rgba(0, 0, 0, 0.02);
    }

    .student-profile-page {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background: radial-gradient(at top left, #e2e8f0, #ffffff), 
                  radial-gradient(at bottom right, #e0e7ff, #ffffff);
      min-height: 100vh;
      padding: 40px 20px;
      color: var(--text-dark);
    }

    .container {
  width: 100%;
  max-width: 1100px;
  margin: 0 auto;
}

/* MOBILE — dashboard mode */
@media (max-width: 768px) {
  .page-content .container {
    max-width: 100%;
    margin: 0;
    padding: 0;
  }
}

    /* --- PROFILE HEADER SECTION --- */
    .profile-hero {
      background: var(--glass);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--glass-border);
      border-radius: 24px;
      padding: 40px;
      display: flex;
      align-items: center;
      gap: 40px;
      margin-bottom: 30px;
      box-shadow: var(--card-shadow);
      position: relative;
      overflow: hidden;
    }

    /* Decorative Circle */
    .profile-hero::before {
      content: '';
      position: absolute;
      top: -50px;
      right: -50px;
      width: 150px;
      height: 150px;
      background: var(--accent-soft);
      border-radius: 50%;
      z-index: 0;
    }

    .profile-img-container {
      position: relative;
      z-index: 1;
    }

    .profile-img {
      width: 160px;
      height: 160px;
      border-radius: 22%; /* Squircle Shape */
      object-fit: cover;
      box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
      border: 4px solid #fff;
    }

    .profile-details { z-index: 1; flex-grow: 1; }

    .profile-details h1 {
      font-size: 32px;
      font-weight: 800;
      color:rgba(71, 68, 68, 0.862);
      margin: 0 0 15px 0;
      letter-spacing: -1px;
    }

    .meta-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
    }

    .tag {
      background: #fff;
      padding: 6px 14px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      color: var(--text-light);
      border: 1px solid #f1f5f9;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* --- DATA CARDS (STATS) --- */
    .stats-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-bottom: 30px;
    }

    .stat-card {
      background: var(--glass);
      padding: 24px;
      border-radius: 20px;
      border: 1px solid var(--glass-border);
      box-shadow: var(--card-shadow);
      transition: transform 0.3s ease;
    }

    .stat-card:hover { transform: translateY(-5px); }

    .stat-card small { color: var(--text-light); font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 1px; }
    .stat-card h3 { margin: 8px 0 0 0; font-size: 22px; }

    /* --- TABLE SECTION --- */
    .table-wrapper {
      background: var(--glass);
      backdrop-filter: blur(10px);
      border-radius: 24px;
      border: 1px solid var(--glass-border);
      box-shadow: var(--card-shadow);
      padding: 10px;
      margin-bottom: 30px;
      overflow: hidden;
    }

    table {
      width: 100%;
      border-collapse: separate;
      border-spacing: 0;
    }

    th {
      text-align: left;
      padding: 20px;
      color: var(--text-light);
      font-size: 13px;
      font-weight: 700;
      text-transform: uppercase;
    }

    td {
      padding: 20px;
      background: rgba(255,255,255,0.4);
      border-top: 1px solid #f1f5f9;
    }

    .status-pill {
      padding: 6px 12px;
      border-radius: 8px;
      font-size: 12px;
      font-weight: 700;
    }

    .paid-pill { background: #dcfce7; color: #15803d; }
    .due-pill { background: #fee2e2; color: #b91c1c; }

    /* --- UPLOAD FORMS --- */
    .upload-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 25px;
    }

    .glass-form {
      background: var(--glass);
      padding: 30px;
      border-radius: 24px;
      border: 1px solid var(--glass-border);
      box-shadow: var(--card-shadow);
    }

    .form-title {
      font-weight: 700;
      font-size: 18px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .file-input-group {
      position: relative;
      margin-bottom: 20px;
    }

    input[type="file"] {
      width: 100%;
      padding: 12px;
      background: #fff;
      border-radius: 12px;
      border: 2px dashed #cbd5e1;
      cursor: pointer;
    }

    .btn-gradient {
      background: linear-gradient(135deg, #6366f1 0%, #4338ca 100%);
      color: white;
      border: none;
      padding: 14px 24px;
      border-radius: 12px;
      font-weight: 700;
      width: 100%;
      cursor: pointer;
      box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.3);
      transition: 0.3s;
    }

    .btn-gradient:hover {
      transform: scale(1.02);
      box-shadow: 0 15px 20px -3px rgba(99, 102, 241, 0.4);
    }

    /* --- RESPONSIVE DESIGN --- */

    /* Tablet (768px - 1024px) */
    @media (max-width: 1024px) {
      .profile-hero { padding: 30px; gap: 25px; }
      .profile-img { width: 130px; height: 130px; }
    }

    /* Mobile (Under 768px) */
    @media (max-width: 768px) {
      .profile-hero {
        flex-direction: column;
        text-align: center;
      }
      .meta-tags { justify-content: center; }
      .upload-grid { grid-template-columns: 1fr; }
      .stats-row { grid-template-columns: 1fr 1fr; }
      .table-wrapper { overflow-x: auto; }
      th, td { padding: 12px; font-size: 12px; }
    }/* ======================================================
   EXTRA COMPACT MOBILE UI ENHANCEMENTS (SAFE OVERRIDES)
====================================================== */

/* Small Mobile Devices (≤ 480px) */
@media (max-width: 480px) {

  .student-profile-page {
    padding: 20px 12px;
  }

  .container {
    max-width: 100%;
  }

  /* --- PROFILE HERO --- */
  .profile-hero {
    padding: 20px 16px;
    gap: 18px;
    border-radius: 18px;
  }

  .profile-img {
    width: 95px;
    height: 95px;
    border-radius: 18%;
  }

  .profile-details h1 {
    font-size: 20px;
    margin-bottom: 10px;
  }

  .meta-tags {
    gap: 6px;
  }

  .tag {
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 8px;
  }

  /* --- STATS CARDS --- */
  .stats-row {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .stat-card {
    padding: 16px;
    border-radius: 16px;
  }

  .stat-card small {
    font-size: 10px;
  }

  .stat-card h3 {
    font-size: 18px;
  }

  /* --- TABLE --- */
  .table-wrapper {
    padding: 6px;
    border-radius: 18px;
  }

  th {
    font-size: 11px;
    padding: 10px;
  }

  td {
    font-size: 11px;
    padding: 10px;
  }

  .status-pill {
    padding: 4px 8px;
    font-size: 10px;
    border-radius: 6px;
  }

  /* --- UPLOAD FORMS --- */
  .upload-grid {
    gap: 16px;
  }

  .glass-form {
    padding: 18px;
    border-radius: 18px;
  }

  .form-title {
    font-size: 15px;
    margin-bottom: 14px;
  }

  .file-input-group {
    margin-bottom: 14px;
  }

  input[type="file"] {
    padding: 8px;
    font-size: 12px;
    border-radius: 10px;
  }

  /* --- BUTTONS --- */
  .btn-gradient {
    padding: 10px 16px;
    font-size: 13px;
    border-radius: 10px;
  }
}

/* Ultra Small Devices (≤ 360px) */
@media (max-width: 360px) {

  .profile-img {
    width: 80px;
    height: 80px;
  }

  .profile-details h1 {
    font-size: 18px;
  }

  .btn-gradient {
    font-size: 12px;
    padding: 9px 14px;
  }
}
/* ===== DASHBOARD MODE (MOBILE FIX) ===== */
@media (max-width: 768px) {

  .student-profile-page {
    padding: 0; /* dashboard already adds padding */
  }

  .profile-hero,
  .stats-row,
  .table-wrapper,
  .upload-grid {
    width: 100%;
  }
}
/* =====================================================
   ✅ FINAL MOBILE POLISH – PROFILE PAGE
   Clean • Compact • Safe Wrapping
===================================================== */
@media (max-width: 768px) {

  /* ---------- PAGE ---------- */
  .student-profile-page {
    padding: 12px !important;
  }

  .container {
    padding: 0 !important;
  }

  /* ---------- PROFILE HERO ---------- */
  .profile-hero {
    padding: 16px !important;
    gap: 14px !important;
    border-radius: 16px !important;
  }

  .profile-details h1 {
    font-size: 18px !important;
    line-height: 1.25;
    word-break: break-word;
  }

  /* ---------- TAGS (EMAIL, ROOM, COURSE) ---------- */
  .meta-tags {
    justify-content: center;
    gap: 6px;
  }

  .tag {
    max-width: 100%;
    font-size: 11px;
    padding: 5px 8px;
    border-radius: 8px;

    /* 🔑 SAFETY */
    word-break: break-word;
    overflow-wrap: anywhere;
    white-space: normal;
  }

  /* ---------- STATS ---------- */
  .stats-row {
    grid-template-columns: 1fr !important;
    gap: 12px;
  }

  .stat-card {
    padding: 14px;
    border-radius: 14px;
  }

  .stat-card h3 {
    font-size: 16px;
  }

  /* ---------- TABLE ---------- */
  .table-wrapper {
    border-radius: 16px;
    padding: 6px;
    overflow-x: auto;
  }

  table {
    min-width: 520px; /* controlled scroll, not overflow */
  }

  th, td {
    font-size: 11px;
    padding: 8px;
    white-space: nowrap;
  }

  /* ---------- UPLOAD FORMS ---------- */
  .upload-grid {
    grid-template-columns: 1fr !important;
    gap: 14px;
  }

  .glass-form {
    padding: 16px;
    border-radius: 16px;
  }

  .form-title {
    font-size: 14px;
  }

  input[type="file"] {
    font-size: 11px;
    padding: 8px;
  }

  .btn-gradient {
    padding: 10px;
    font-size: 12px;
    border-radius: 10px;
  }

}
/* =====================================================
   🔒 FIX: PROFILE HERO CONTAINMENT (MOBILE ONLY)
   Fixes container overflow issue
===================================================== */
@media (max-width: 768px) {

  /* Ensure container truly owns width */
  .student-profile-page .container {
    width: 100%;
    max-width: 100%;
    padding: 0 10px;
    box-sizing: border-box;
  }

  /* 🔑 MAIN FIX — profile hero stays inside container */
  .profile-hero {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;

    padding: 16px;          /* reduced but clean */
    margin: 0 auto 18px;    /* centered */
    overflow: hidden;       /* safety */
  }
}
/* =====================================================
   🔒 FIX: FEE CONTAINER CONTAINMENT (MOBILE ONLY)
===================================================== */
@media (max-width: 768px) {

  /* Fee container must stay inside main container */
  .table-wrapper {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;

    padding: 8px;
    margin: 0 auto 18px;
    overflow-x: auto;   /* allow table scroll */
    overflow-y: hidden;
  }

  /* Prevent table from forcing overflow */
  .table-wrapper table {
    width: 100%;
    min-width: 520px;   /* controlled scroll, not overflow */
    box-sizing: border-box;
  }
}

/* ---------- EXTRA SAFETY (ALL SCREENS) ---------- */
.profile-details,
.tag,
.stat-card,
.glass-form,
td {
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-word;
}

  </style>

  <div class="container">
    
    <div class="profile-hero">
      <div class="profile-img-container">
        <% if(student.profile_image){ %>
          <img class="profile-img" src="/uploads/profile_images/<%= student.profile_image %>" id="previewImg">
        <% } else { %>
          <img class="profile-img" src="/images/pr.png" id="previewImg">
        <% } %>
      </div>

      <div class="profile-details">
        <small style="color: var(--accent); font-weight: 800; text-transform: uppercase;">Student Profile</small>
        <h1><%= student.name %></h1>
        
        <div class="meta-tags">
          <div class="tag"><i class="fa fa-envelope"></i> <%= student.email %></div>
          <div class="tag"><i class="fa fa-door-open"></i> Room <%= student.room_no %></div>
          <div class="tag"><i class="fa fa-graduation-cap"></i> <%= student.course %></div>
          <div class="tag"><i class="fa fa-calendar-alt"></i> Year <%= student.year %></div>
        </div>
      </div>
    </div>

    <div class="stats-row">
      <div class="stat-card">
        <small>Current Status</small>
        <h3 style="color: var(--accent);">Active</h3>
      </div>
      <div class="stat-card">
        <small>Overall Fees</small>
        <h3>Partially Paid</h3>
      </div>
      <div class="stat-card">
        <small>Documents</small>
        <h3 style="color: #10b981;">Verified</h3>
      </div>
    </div>

    <div class="table-wrapper">
      <table>
        <thead>
          <tr>
            <th>Academic Year</th>
            <th>Room Rent</th>
            <th>Mess Bill (I)</th>
            <th>Mess Bill (II)</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% feeSummary.forEach(f => { %>
            <tr>
              <td><strong><%= f.year %></strong></td>
              <td>₹<%= f.room_rent_paid %> / <span style="color: var(--text-light); font-size: 11px;">₹<%= f.room_rent_due %></span></td>
              <td>₹<%= f.mess_bill1_paid %></td>
              <td>₹<%= f.mess_bill2_paid %></td>
              <td>
                <span class="status-pill <%= f.total_paid >= f.total_fee ? 'paid-pill' : 'due-pill' %>">
                  <%= f.total_paid >= f.total_fee ? 'COMPLETED' : 'PENDING' %>
                </span>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <div class="upload-grid">
      <div class="glass-form">
        <div class="form-title"><i class="fa fa-fingerprint" style="color: var(--accent);"></i> KYC Documents</div>
        
        <form action="/student/upload-aadhaar/student" method="POST" enctype="multipart/form-data">
          <div class="file-input-group">
            <label style="display: block; margin-bottom: 8px; font-size: 12px; font-weight: 700;">Student's Aadhaar</label>
            <input type="file" name="aadhaar" required>
          </div>
          <button class="btn-gradient" style="margin-bottom: 20px;">Upload Student ID</button>
        </form>

        <form action="/student/upload-aadhaar/father" method="POST" enctype="multipart/form-data">
          <div class="file-input-group">
            <label style="display: block; margin-bottom: 8px; font-size: 12px; font-weight: 700;">Father's Aadhaar</label>
            <input type="file" name="aadhaar" required>
          </div>
          <button class="btn-gradient">Upload Parent ID</button>
        </form>
      </div>

      <div class="glass-form">
        <div class="form-title"><i class="fa fa-user-circle" style="color: var(--accent);"></i> Profile Visuals</div>
        <p style="font-size: 13px; color: var(--text-light); line-height: 1.6;">
          Ensure your profile photo is clear and front-facing. This photo will be used for your Digital ID card.
        </p>
        <form action="/student/upload-profile" method="POST" enctype="multipart/form-data">
          <div class="file-input-group">
            <input type="file" id="photoUpload" name="profile_image" accept="image/*" onchange="previewImage(event)">
          </div>
          <button class="btn-gradient">Update Profile Picture</button>
        </form>
      </div>
    </div>

  </div>

  <script>
    function previewImage(e) {
      const img = document.getElementById('previewImg');
      if (e.target.files[0]) {
        img.src = URL.createObjectURL(e.target.files[0]);
        img.style.animation = "pulse 1s infinite alternate";
      }
    }
  </script>
</div>
