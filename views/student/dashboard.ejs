     onclick="loadPage('viewComplaints', this)">
    <i class="fa-regular fa-folder-open"></i>
    <span>My Complaints</span>
  </a>
</li>

    </ul>

    <div class="logout-section">
      <div class="logout-separator"></div>
      <button class="logout-btn" onclick="location.href='/logout'">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Logout
      </button>
    </div>
  </div>

  <!-- Main Page Content -->
  <div class="page-content" id="mainContent">
    <h2>Welcome, <%= student.name %>!</h2>

    <div class="card profile-card">
  <h3>Profile Information</h3>
  <div class="profile-content">
    <div class="profile-photo">
 <img src="<%= student.profile_image ? '/uploads/profile_images/' + student.profile_image : '/images/profile.jpg' %>" alt="Student Photo">



    </div>
    <div class="profile-details">
      <p><strong>Student ID:</strong> <%= student.student_id %></p>
      <p><strong>Name:</strong> <%= student.name %></p>
      <p><strong>Email:</strong> <%= student.email %></p>
      <p><strong>Room:</strong> <%= student.room_no || "Not Assigned" %></p>
      <p><strong>Course:</strong> <%= student.course || "N/A" %> |
         <strong>Year:</strong> <%= student.year || "N/A" %></p>
    </div>
   
  </div>
</div>

  
</body>

</html>
