<div class="apply-outpass-page">

  <style>
    .apply-outpass-page * {
      box-sizing: border-box;
    }

    .apply-outpass-page {
      font-family: "Poppins", sans-serif;
      background:
        linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)),
        url('/images/hostel-bg.jpg') no-repeat center center fixed;
      background-size: cover;
      color: #fff;
      min-height: 100vh;
      padding: 40px 20px;

      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
    }

    /* ================= CONTAINER ================= */
    .apply-outpass-page .outpass-container {
      width: 100%;
      max-width: 1100px;
      background: #f8f9fa;
      border-radius: 14px;
      box-shadow: 0 12px 36px #22304c22;
      border: 3px solid #ffd700;
      padding: 30px 28px 25px;
    }

    .apply-outpass-page h2 {
      text-align: center;
      font-size: 2em;
      font-weight: 900;
      color: #1b243b;
      margin-bottom: 30px;
    }

    .apply-outpass-page .outpass-form {
      display: flex;
      flex-direction: column;
      gap: 18px;
    }

    .apply-outpass-page label {
      font-weight: 700;
      color: #22304c;
      font-size: 1.15em;
    }

    .apply-outpass-page input[type="date"],
    .apply-outpass-page select,
    .apply-outpass-page textarea {
      width: 100%;
      padding: 12px 14px;
      border-radius: 7px;
      border: 2px solid #bdc3c7;
      background: #fff;
      font-size: 1.05em;
      color: #22304c;
      resize: none;
    }

    .apply-outpass-page textarea {
      height: 90px;
    }

    .apply-outpass-page input:focus,
    .apply-outpass-page select:focus,
    .apply-outpass-page textarea:focus {
      border-color: #ffc107;
      outline: none;
    }

    .apply-outpass-page button[type="submit"] {
      background: #ffc107;
      color: #222;
      border: none;
      border-radius: 50px;
      font-weight: 700;
      font-size: 1.15em;
      padding: 12px 0;
      width: 100%;
      cursor: pointer;
      margin-top: 20px;
      transition: 0.2s;
    }

    .apply-outpass-page button[type="submit"]:hover {
      background: #ffd700;
      transform: scale(1.01);
    }

    /* ================= POPUP ================= */
    .apply-outpass-page .popup-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.6);
      display: none;
      justify-content: center;
      align-items: center;
      z-index: 9999;
    }

    .apply-outpass-page .popup-box {
      background: #ffffff;
      color: #22304c;
      padding: 30px 35px;
      border-radius: 16px;
      text-align: center;
      box-shadow: 0 20px 40px rgba(0,0,0,0.4);
    }

    /* ===== RESPONSIVE ===== */
    @media (max-width: 1024px) {
      .apply-outpass-page {
        padding: 30px 14px;
      }
    }

    @media (max-width: 600px) {
      .apply-outpass-page {
        padding: 18px 10px;
      }
    }
  </style>

  <div class="outpass-container">
    <h2>Apply for Outpass</h2>

    <form id="outpassForm" action="/student/applyOutpass" method="POST" class="outpass-form">
      <label>Reason</label>
      <textarea name="reason" required></textarea>

      <label>Outpass Type</label>
      <select name="type" required>
        <option value="">-- Select Type --</option>
        <option>Normal</option>
        <option>Emergency</option>
      </select>

      <label>Leave Start Date</label>
      <input type="date" name="leave_start" required>

      <label>Leave End Date</label>
      <input type="date" name="leave_end" required>

      <button type="submit">Submit Outpass</button>
    </form>
    <script>
  const startDate = document.getElementById("startDate");
  const endDate = document.getElementById("endDate");

  // Get today's date (YYYY-MM-DD)
  const today = new Date().toISOString().split("T")[0];

  // 🔒 Start date should not allow past dates
  startDate.min = today;

  // 🔁 When start date changes
  startDate.addEventListener("change", () => {
    // End date must be >= start date
    endDate.min = startDate.value;

    // Auto-fix if end date is already invalid
    if (endDate.value && endDate.value < startDate.value) {
      endDate.value = startDate.value;
    }
  });

  // 🛡 Final safety check on submit
  document.getElementById("outpassForm").addEventListener("submit", (e) => {
    if (endDate.value < startDate.value) {
      e.preventDefault();
      alert("End date must be same or after start date.");
    }
  });
</script>

  </div>

</div>
