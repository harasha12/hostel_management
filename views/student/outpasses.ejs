<div class="student-outpasses-page">

<style>
/* ===== HARD STOP DASHBOARD INHERITANCE ===== */
.student-outpasses-page {
  all: initial;
  display: block;
  width: 100%;
  font-family: 'Poppins', sans-serif;
}

/* ===== SCOPE EVERYTHING ===== */
.student-outpasses-page *,
.student-outpasses-page *::before,
.student-outpasses-page *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* ===== PAGE BACKGROUND (REPLACES BODY) ===== */
.student-outpasses-page {
  background:
    linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.7)),
    url('/images/hostel-bg.jpg') no-repeat center center fixed;
  background-size: cover;
  min-height: 100vh;
  display: flex;
  justify-content: center;
  padding: 20px;
}

/* ================= CONTAINER ================= */
.student-outpasses-page .outpass-container {
  max-width: 1000px;
  width: 100%;
  margin: 40px auto;
  background: #ffffff;
  border-radius: 16px;
  box-shadow: 0 15px 45px rgba(10, 20, 30, 0.3);
  overflow: hidden;
}

.student-outpasses-page .gold-header-bar {
  height: 8px;
  background: linear-gradient(90deg, #ffd700, #ffc400);
}

.student-outpasses-page .content-wrapper {
  padding: 24px;
}

/* ================= HEADING ================= */
.student-outpasses-page h2 {
  font-family: 'Montserrat', sans-serif;
  font-size: 1.5em;
  font-weight: 900;
  color: #1a2a47;
  text-align: center;
  margin-bottom: 24px;
}

/* ================= DESKTOP TABLE ================= */
.student-outpasses-page .desktop-table {
  display: none;
}

.student-outpasses-page table {
  width: 100%;
  border-collapse: collapse;
  border-radius: 8px;
  overflow: hidden;
  border: 1px solid #e0e0e0;
}

.student-outpasses-page thead {
  background: linear-gradient(135deg, #1a2a47, #0f1a2e);
}

.student-outpasses-page th {
  padding: 14px 18px;
  font-weight: 600;
  color: #f9fafb;
  font-size: 0.85em;
  text-transform: uppercase;
}

.student-outpasses-page td {
  padding: 14px 18px;
  border-bottom: 1px solid #e0e0e0;
  color: #374151;
}

.student-outpasses-page tbody tr:nth-child(even) {
  background-color: #f9fafb;
}

.student-outpasses-page tbody tr:hover {
  background-color: #f0f4f8;
}

/* ================= MOBILE CARDS ================= */
.student-outpasses-page .mobile-cards {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.student-outpasses-page .outpass-card {
  background: #ffffff;
  border: 1px solid #e5e7eb;
  border-radius: 12px;
  padding: 20px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.student-outpasses-page .outpass-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 22px rgba(0,0,0,0.15);
}

.student-outpasses-page .card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 16px;
  padding-bottom: 12px;
  border-bottom: 1px solid #f3f4f6;
}

.student-outpasses-page .card-period {
  font-family: 'Montserrat', sans-serif;
  font-weight: 700;
  color: #1a2a47;
  font-size: 1.1em;
}

.student-outpasses-page .card-reason {
  color: #6b7280;
  font-size: 0.9em;
  margin-top: 4px;
}

.student-outpasses-page .card-dates {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}

.student-outpasses-page .date-item {
  background: #f9fafb;
  padding: 12px;
  border-radius: 8px;
  transition: background-color 0.25s ease, box-shadow 0.25s ease;
}

.student-outpasses-page .date-item:hover {
  background: #f1f5f9;
  box-shadow: inset 0 0 0 1px #e5e7eb;
}

.student-outpasses-page .date-label {
  font-size: 0.75em;
  color: #6b7280;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 4px;
}

.student-outpasses-page .date-value {
  font-weight: 600;
  color: #1f2937;
}

/* ================= STATUS BADGES ================= */
.student-outpasses-page .status-badge {
  display: inline-block;
  padding: 6px 14px;
  border-radius: 999px;
  font-weight: 600;
  font-size: 0.8em;
  letter-spacing: 0.03em;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.student-outpasses-page .status-badge:hover {
  transform: scale(1.05);
  box-shadow: 0 4px 10px rgba(0,0,0,0.15);
}

.student-outpasses-page .status-approved {
  background-color: #ecfdf5;
  color: #047857;
  border: 1px solid #047857;
}

.student-outpasses-page .status-pending {
  background-color: #f3f4f6;
  color: #4b5563;
  border: 1px solid #9ca3af;
}

.student-outpasses-page .status-rejected {
  background-color: #fef2f2;
  color: #b91c1c;
  border: 1px solid #b91c1c;
}

/* ================= BACK BUTTON ================= */
.student-outpasses-page .back-link {
  display: inline-block;
  margin-top: 24px;
  padding: 12px 28px;
  border-radius: 999px;
  background: linear-gradient(135deg, #ffd700, #ffc400);
  color: #1a2a47;
  text-decoration: none;
  font-weight: 700;
  font-size: 0.95em;
  box-shadow: 0 4px 15px rgba(255, 215, 0, 0.3);
  transition: all 0.25s ease;
}

.student-outpasses-page .back-link:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(255, 215, 0, 0.4);
}

/* ================= DESKTOP ROW ZOOM ================= */
.student-outpasses-page table tbody tr {
  transition: transform 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
}

.student-outpasses-page table tbody tr:hover {
  transform: scale(1.015);
  background-color: rgba(243, 246, 251, 0.95);
  box-shadow: 0 8px 22px rgba(0, 0, 0, 0.12);
}

/* ================= RESPONSIVE ================= */
@media (min-width: 768px) {
  .student-outpasses-page .mobile-cards { display: none; }
  .student-outpasses-page .desktop-table { display: block; }
  .student-outpasses-page .content-wrapper { padding: 32px 40px; }
  .student-outpasses-page h2 { font-size: 1.8em; }
}
</style>

<div class="outpass-container">
  <div class="gold-header-bar"></div>
  <div class="content-wrapper">
    <h2>Your Outpass Requests</h2>

    <!-- Mobile / Tablet -->
    <div class="mobile-cards">
      <% outpasses.forEach(op => { 
        const status = (op.status || 'pending').trim().toLowerCase();
      %>
      <div class="outpass-card">
        <div class="card-header">
          <div>
            <div class="card-period">Days : <%= op.period %></div>
            <div class="card-reason"><%= op.reason %></div>
          </div>
          <span class="status-badge status-<%= status %>"><%= op.status %></span>
        </div>
        <div class="card-dates">
          <div class="date-item">
            <div class="date-label">Out Date</div>
            <div class="date-value"><%= op.out_date.toISOString().split('T')[0] %></div>
          </div>
          <div class="date-item">
            <div class="date-label">Return Date</div>
            <div class="date-value"><%= op.return_date.toISOString().split('T')[0] %></div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <!-- Desktop -->
    <div class="desktop-table">
      <table>
        <thead>
          <tr>
            <th>Period</th>
            <th>Reason</th>
            <th>Out Date</th>
            <th>Return Date</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% outpasses.forEach(op => { 
            const status = (op.status || 'pending').trim().toLowerCase();
          %>
          <tr>
            <td><%= op.period %></td>
            <td><%= op.reason %></td>
            <td><%= op.out_date.toISOString().split('T')[0] %></td>
            <td><%= op.return_date.toISOString().split('T')[0] %></td>
            <td><span class="status-badge status-<%= status %>"><%= op.status %></span></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>

    <a href="/student/dashboard" class="back-link">← Back to Dashboard</a>
  </div>
</div>

</div>
<!-- ======================================
     END OF STUDENT OUTPASSES – SAFE PARTIAL -->
