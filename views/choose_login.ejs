<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Student Management Portal</title>

  <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" />

  <style>
    /* Notification Bar */
    .notification-bar-container {
        width: 100%;
        overflow: hidden;
        background: rgba(255, 204, 0, 0.95);
        color: #000;
        padding: 10px 0;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
        margin-bottom: 20px;
    }

    .notification-bar-text {
        display: inline-block;
        white-space: nowrap;
        padding-left: 100%;
        animation: scroll-left 25s linear infinite;
        font-weight: 700;
        font-size: 1rem;
    }

    @keyframes scroll-left {
        0% { transform: translateX(0%); }
        100% { transform: translateX(-100%); }
    }

    body {
      background: url("images/hostel-bg.jpg") no-repeat center center fixed;
      background-size: cover;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      margin: 0;
    }

    .overlay {
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(5px);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 0; /* Changed for better mobile spacing */
    }

    /* ====== Header Section ====== */
    .college-header {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 30px 40px;
      background: rgba(255, 255, 255, 0.1);
      border-bottom: 2px solid rgba(255, 255, 255, 0.2);
    }

    .college-header img {
      max-height: 110px;
      margin-right: 25px;
      filter: drop-shadow(0 0 5px rgba(255, 255, 255, 0.5));
    }

    .header-text { text-align: center; }

    .header-text h2 {
      margin: 0;
      font-size: 2.2rem;
      font-weight: 800;
      color: #fff;
      text-transform: uppercase;
      text-shadow: 2px 2px 4px #000;
    }

    .header-text p {
      margin: 8px 0 0;
      font-size: 1rem;
      color: #e0e0e0;
      line-height: 1.5;
    }

    .autonomous { color: #ffcc00; font-weight: bold; }

    /* ====== Welcome & Buttons ====== */
    .main-content {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 40px 20px;
    }

    .welcome h3 {
      font-weight: 400;
      color: #fff;
      font-size: 2.2rem;
      text-align: center;
      margin-bottom: 40px;
      text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8);
    }

    .login-buttons-horizontal {
      display: flex;
      justify-content: center;
      gap: 20px;
      width: 100%;
      max-width: 1000px;
    }

    .login-btn {
      flex: 1;
      font-size: 1.1rem;
      border-radius: 12px;
      padding: 18px 20px;
      text-transform: uppercase;
      font-weight: bold;
      transition: all 0.3s ease;
      border: none;
      box-shadow: 0px 6px 15px rgba(0, 0, 0, 0.4);
      text-decoration: none;
      text-align: center;
      color: #fff !important;
    }

    .login-btn-student { background: linear-gradient(135deg, #007bff, #0056b3); }
    .login-btn-warden { background: linear-gradient(135deg, #28a745, #1e7e34); }
    .login-btn-admin { background: linear-gradient(135deg, #17a2b8, #117a8b); }
    .login-btn-security { background: linear-gradient(135deg, #ffc107, #e0a800); color: #000 !important; }

    .login-btn:hover {
      transform: translateY(-5px);
      box-shadow: 0px 10px 25px rgba(0, 0, 0, 0.6);
      filter: brightness(1.1);
    }

    /* ====== Responsive Mobile UI ====== */
    @media (max-width: 768px) {
      .college-header {
        flex-direction: column;
        padding: 20px 15px;
      }

      .college-header img {
        max-height: 70px;
        margin-right: 0;
        margin-bottom: 15px;
      }

      .header-text h2 {
        font-size: 1.1rem;
        line-height: 1.3;
      }

      .header-text p {
        font-size: 0.75rem;
      }

      .welcome h3 {
        font-size: 1.5rem;
        margin-bottom: 30px;
      }

      .login-buttons-horizontal {
        flex-direction: column;
        gap: 15px;
        width: 100%;
        padding: 0 10px;
      }

      .login-btn {
        width: 100%;
        padding: 15px;
        font-size: 1rem;
      }
      
      .notification-bar-text {
        font-size: 0.85rem;
      }
    }
  </style>
</head>

<body>

  <style>
    #popup-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.6); backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; z-index: 99999; }
    .popup-box { width: 320px; padding: 25px; background: #fff; border-radius: 15px; text-align: center; color: #333; transform: scale(0.7); opacity: 0; transition: 0.3s; }
    .popup-show { transform: scale(1); opacity: 1; }
    .popup-icon { font-size: 50px; margin-bottom: 10px; }
    .popup-success { color: #28a745; }
    .popup-error { color: #dc3545; }
  </style>

  <div id="popup-overlay">
    <div id="popup-box" class="popup-box">
      <div id="popup-icon" class="popup-icon"></div>
      <div id="popup-message"></div>
    </div>
  </div>

  <div class="overlay">
    <header class="college-header">
      <img src="images/college_logo.png" alt="College Logo" />
      <div class="header-text">
        <h2>SIR C R REDDY COLLEGE OF ENGINEERING <br> BOYS HOSTEL (<span class="autonomous">AUTONOMOUS</span>)</h2>
        <p>
          Approved by AICTE & Affiliated to JNTUK | NAAC-A Accredited<br>
          Vatluru, Eluru, AP - 534007
        </p>
      </div>
    </header>

    <div class="notification-bar-container">
      <div class="notification-bar-text">
        📢 *IMPORTANT NOTICE:* Hostel fee payment deadline is approaching. Please pay before 30th November. | Mandatory gate pass application for all weekend leaves. | Check the notice board for more updates. 📢
      </div>
    </div>

    <main class="main-content">
      <div class="welcome">
        <h3>Welcome to Management Portal</h3>
        <div class="login-buttons-horizontal">
          <a href="/login/student" class="login-btn login-btn-student">Student Login</a>
          <a href="/login/warden" class="login-btn login-btn-warden">Warden Login</a>
          <a href="/login/admin" class="login-btn login-btn-admin">Admin Login</a>
          <a href="/login/security" class="login-btn login-btn-security">Security Login</a>
        </div>
      </div>
    </main>
  </div>

  <script id="__flash_data" type="application/json">
    <%- JSON.stringify({
        success: typeof flashSuccess !== 'undefined' ? flashSuccess : [],
        error: typeof flashError !== 'undefined' ? flashError : [],
        cookieLogout: typeof cookieLogoutMsg !== 'undefined' ? cookieLogoutMsg : null
    }) %>
  </script>

  <script>
    (function () {
      const overlay = document.getElementById("popup-overlay");
      const box = document.getElementById("popup-box");
      const icon = document.getElementById("popup-icon");
      const msgBox = document.getElementById("popup-message");
      let data = { success: [], error: [], cookieLogout: null };
      try { data = JSON.parse(document.getElementById("__flash_data").textContent); } catch(e) {}

      function showPopup(type, message) {
        overlay.style.display = "flex";
        if (type === "success") {
          icon.innerHTML = "✔️"; icon.className = "popup-icon popup-success";
        } else {
          icon.innerHTML = "❌"; icon.className = "popup-icon popup-error";
        }
        msgBox.innerHTML = `<strong>${message}</strong>`;
        setTimeout(() => box.classList.add("popup-show"), 30);
        setTimeout(() => {
          box.classList.remove("popup-show");
          setTimeout(() => overlay.style.display = "none", 300);
        }, 2500);
      }
      data.success.forEach(m => showPopup("success", m));
      data.error.forEach(m => showPopup("error", m));
      if (data.cookieLogout) showPopup("success", data.cookieLogout);
    })();
  </script>

  <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.5.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
