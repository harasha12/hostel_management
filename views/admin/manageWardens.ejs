<%
  const success = messages && messages.success ? messages.success : [];
  const error   = messages && messages.error   ? messages.error   : [];
%>

<% if (success.length > 0) { %>
  <div class="flash-message success auto-hide">
    <%= success[0] %>
  </div>
<% } %>

<% if (error.length > 0) { %>
  <div class="flash-message error auto-hide">
    <%= error[0] %>
  </div>
<% } %>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Manage Wardens</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>

<style>
.manage-warden-page {
  font-family: "Montserrat", sans-serif;
  padding: 30px;
  color: #111;
}

.manage-warden-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 30px;
  max-width: 1100px;
  margin: auto;
  box-shadow: 0 12px 30px rgba(0,0,0,0.15);
  border-top: 6px solid #f8d300;
}

.manage-warden-card h2 {
  text-align: center;
  font-size: 2rem;
  margin-bottom: 6px;
  color: #162039;
}

.manage-warden-card p {
  text-align: center;
  color: #555;
  margin-bottom: 20px;
}

/* ===== FLASH MESSAGES ===== */
.flash-message {
  padding: 14px 18px;
  margin: 18px 0;
  border-radius: 10px;
  font-weight: 700;
  text-align: center;
  transition: opacity 0.5s ease, transform 0.5s ease;
}

.flash-message.success {
  background: #e8f5e9;
  color: #1b5e20;
  border: 1px solid #a5d6a7;
}

.flash-message.error {
  background: #fdecea;
  color: #b71c1c;
  border: 1px solid #f5c6cb;
}

/* ===== FORM ===== */
.warden-form {
  background: #f4f6fb;
  padding: 20px;
  border-radius: 12px;
  margin-bottom: 30px;
}

.warden-form .row {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
  justify-content: center;
}

.warden-form input {
  padding: 12px;
  width: 220px;
  border-radius: 8px;
  border: 1px solid #ccc;
}

.warden-form input:focus {
  outline: 2px solid #f8d300;
}

.btn-primary {
  background: #f8d300;
  color: #162039;
  border: none;
  padding: 12px 30px;
  border-radius: 10px;
  font-weight: bold;
  cursor: pointer;
}

.btn-primary:hover {
  background: #ffea61;
  border: 2px solid #000;   /* ✅ black border on hover */
}

/* ===== TABLE SCROLL ===== */
.table-box {
  max-height: 350px;
  overflow-y: auto;
  overflow-x: auto;
  border-radius: 10px;
  border: 1px solid #ddd;
}

table {
  width: 100%;
  border-collapse: collapse;
  min-width: 800px;
}

th {
  background: #22304c;
  color: #ffe082;
  padding: 12px;
  position: sticky;
  top: 0;
}

td {
  padding: 10px;
  border-bottom: 1px solid #ddd;
  text-align: center;
}

/* ===== DELETE BUTTON ===== */
.btn-danger {
  background: transparent;
  color: #dc2626;
  border: 1px solid #dc2626;
  padding: 6px 12px;
  border-radius: 6px;
  cursor: pointer;
  font-weight: 600;
}

.btn-danger:hover {
  background: rgba(220,38,38,0.12);
}
/* ================= MOBILE WARDEN CARDS ================= */
@media (max-width: 768px) {

  /* Hide table on mobile */
  .table-box {
    display: none;
  }

  /* Card list container */
  .warden-card-list {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: 20px;
  }

  .warden-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 14px 16px;
    box-shadow: 0 6px 18px rgba(0,0,0,0.12);
    border: 1px solid #e5e5e5;
  }

  .warden-card h3 {
    margin: 0 0 6px;
    font-size: 1rem;
    font-weight: 700;
    color: #162039;
  }

  .warden-card .info {
    font-size: 0.85rem;
    color: #444;
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 10px;
  }

  .warden-card .info span {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .warden-card .info i {
    color: #f8d300;
    min-width: 16px;
  }

  .warden-card form {
    margin-top: 8px;
  }

  .warden-card .btn-danger {
    width: 100%;
    padding: 10px;
    font-size: 0.85rem;
  }

  /* Stack form inputs */
  .warden-form .row {
    flex-direction: column;
    align-items: stretch;
  }

  .warden-form input {
    width: 100%;
  }

  .btn-primary {
    width: 100%;
  }
}
@media (max-width: 768px) {

  /* Prevent card overflow */
  .warden-card {
    overflow: hidden;
  }

  /* Warden name */
  .warden-card h3 {
    word-break: break-word;
    overflow-wrap: anywhere;
    line-height: 1.3;
    max-width: 100%;
  }

  /* Info rows */
  .warden-card .info span {
    word-break: break-word;
    overflow-wrap: anywhere;
    max-width: 100%;
  }

  /* Email + text container */
  .warden-card .info {
    overflow: hidden;
  }

  /* Icons should never shrink */
  .warden-card .info i {
    flex-shrink: 0;
  }
  /* ===== FIX EMAIL OVERFLOW IN MOBILE WARDEN CARD ===== */
.warden-card .info span {
  display: flex;
  align-items: flex-start;
  gap: 6px;

  /* IMPORTANT */
  flex-wrap: nowrap;
}

.warden-card .info strong {
  white-space: nowrap;   /* 🔒 keeps "Email:" in one line */
  flex-shrink: 0;        /* prevents shrinking */
}

.warden-card .info span > :last-child {
  word-break: break-word;
  overflow-wrap: anywhere;
}

}
/* ===== SMOOTH DELETE ANIMATION ===== */
.warden-card {
  transition:
    opacity 0.35s ease,
    transform 0.35s ease,
    max-height 0.4s ease,
    margin 0.4s ease,
    padding 0.4s ease;
  max-height: 500px;
}

.warden-card.deleting {
  opacity: 0;
  transform: translateX(-20px) scale(0.97);
  max-height: 0;
  margin: 0;
  padding-top: 0;
  padding-bottom: 0;
  overflow: hidden;
}

</style>
</head>

<body>

<div class="manage-warden-page">
  <div class="manage-warden-card">

    <h2><i class="fas fa-user-shield"></i> Manage Wardens</h2>
    <p><strong>Add and manage wardens in your hostel system</strong></p>

    <!-- ✅ FLASH MESSAGES -->
    <% if (success.length > 0) { %>
      <div class="flash-message success auto-hide">
        <%= success[0] %>
      </div>
    <% } %>

    <% if (error.length > 0) { %>
      <div class="flash-message error auto-hide">
        <%= error[0] %>
      </div>
    <% } %>

    <!-- ===== ADD FORM ===== -->
    <form action="/admin/addWarden" method="POST" class="warden-form">
      <div class="row">
        <input type="text" name="hostel_id" placeholder="Hostel ID" required>
        <input type="text" name="name" placeholder="Warden Name" required>
        <input type="email" name="email" placeholder="Warden Email" required>
        <input type="password" name="password" placeholder="Password" required>
      </div>
      <div style="text-align:center;margin-top:15px;">
        <button class="btn-primary">
          <i class="fas fa-user-plus"></i> Add Warden
        </button>
      </div>
    </form>

    <!-- ===== TABLE ===== -->
    <div class="table-box">
      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Hostel</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
        <% wardens.forEach(w => { %>
          <tr>
            <td><%= w.warden_id %></td>
            <td><%= w.name %></td>
            <td><%= w.email %></td>
            <td><%= w.hostel_id %></td>
            <td>
              <form action="/admin/deleteWarden/<%= w.warden_id %>" method="POST"
      onsubmit="return handleWardenDelete(event, this);">

                <button class="btn-danger">
                  <i class="fas fa-trash"></i> Delete
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <!-- ================= MOBILE WARDEN CARDS ================= -->
<div class="warden-card-list">
  <% wardens.forEach(w => { %>

    <div class="warden-card">
      <h3><i class="fas fa-user"></i> <%= w.name %></h3>

      <div class="info">
        <span>
          <i class="fas fa-envelope"></i>
          <strong>Email:</strong> <%= w.email %>
        </span>

        <span>
          <i class="fas fa-building"></i>
          <strong>Hostel:</strong> <%= w.hostel_id %>
        </span>

        <span>
          <i class="fas fa-id-badge"></i>
          <strong>ID:</strong> <%= w.warden_id %>
        </span>
      </div>

      <form action="/admin/deleteWarden/<%= w.warden_id %>" method="POST"
            onsubmit="return confirm('Are you sure you want to delete this warden?');">
        <button class="btn-danger">
          <i class="fas fa-trash"></i> Delete Warden
        </button>
      </form>
    </div>

  <% }) %>
</div>


  </div>
</div>

<!-- ✅ AUTO HIDE SCRIPT -->
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const messages = document.querySelectorAll(".auto-hide");

    messages.forEach(msg => {
      setTimeout(() => {
        msg.style.opacity = "0";
        msg.style.transform = "translateY(-10px)";
        setTimeout(() => msg.remove(), 500);
      }, 5000);
    });
  });
</script>
<script>
function handleWardenDelete(event, form) {
  event.preventDefault();

  if (!confirm("Are you sure you want to delete this warden?")) {
    return false;
  }

  const card = form.closest(".warden-card");

  if (card) {
    card.classList.add("deleting");

    // wait for animation, then submit
    setTimeout(() => {
      form.submit();
    }, 350);
  } else {
    // fallback (should never happen)
    form.submit();
  }

  return false;
}
</script>

<%- include('../partials/footer') %>
</body>
</html>
