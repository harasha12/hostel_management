
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Yearly Fees Management</title>
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">
  <style>
    
    :root {
      --color-gold: #FFD700;
      --color-light-gold: #fff176;
      --color-dark: #2c3e50;
      --color-white: #FFFFFF;
      --color-light-grey: #f8f9fa;
    }

    body {
      margin: 0;
      font-family: 'Poppins', sans-serif;
      background-color: var(--color-light-grey);
      color: #FFFFFF;
      min-height: 100vh;
    }

    /* 🌟 HEADER FIXED TOP */
    header {
      background: var(--color-gold);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 12px 40px;
      position: sticky;
      top: 0;
      z-index: 1000;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    }

    header .logo a {
      text-decoration: none;
      font-weight: 700;
      font-size: 1.3rem;
      color: var(--color-dark);
    }

    header nav {
      display: flex;
      gap: 20px;
    }

    header nav a {
      text-decoration: none;
      font-weight: 600;
      color: var(--color-dark);
      background: var(--color-white);
      padding: 8px 14px;
      border-radius: 8px;
      transition: 0.3s;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
    }

    header nav a:hover {
      background: var(--color-light-gold);
      transform: translateY(-2px);
    }

    /* 🌿 MAIN CONTENT */
    .container {
  width: 95%;
  max-width: 900px;
  margin: 100px auto 40px;
  background: var(--color-white);
  border: 2px solid var(--color-gold);
  border-radius: 12px;
  padding: 30px 40px;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  box-sizing: border-box;
}

     /* prevents anything from going out */
     
    
   


     h3 {
      text-align: center;
      color: var(--color-dark);
      margin-bottom: 20px;
      font-weight: 700;
    }

     

   

    .fee-form {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
      margin-bottom: 40px;
      padding: 20px;
      border: 1px dashed var(--color-gold);
      border-radius: 8px;
    }

    label {
      font-weight: 600;
      color: var(--color-dark);
      margin-bottom: 5px;
      font-size: 0.9rem;
    }

    input {
      padding: 10px 12px;
      border-radius: 6px;
      border: 1px solid #ccc;
      background-color: var(--color-light-grey);
      color: var(--color-dark);
      font-size: 15px;
      transition: all 0.3s ease;
    }

    input:focus {
      outline: none;
      border-color: var(--color-gold);
      box-shadow: 0 0 5px rgba(255, 215, 0, 0.5);
      background-color: var(--color-white);
    }

    .button-full-width {
      grid-column: 1 / -1;
    }

    button {
      width: 100%;
      padding: 14px;
      background-color: var(--color-gold);
      color: var(--color-dark);
      border: none;
      border-radius: 8px;
      font-weight: 700;
      font-size: 16px;
      cursor: pointer;
      transition: 0.3s;
      box-shadow: 0 4px 10px rgba(255, 215, 0, 0.4);
    }

    button:hover {
      background-color: var(--color-light-gold);
      transform: translateY(-2px);
      box-shadow: 0 6px 15px rgba(255, 215, 0, 0.6);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 25px;
      border-radius: 8px;
      overflow: hidden;
      border: 1px solid #ddd;
    }

    th, td {
      padding: 15px 12px;
      text-align: center;
      color: var(--color-dark);
      font-weight: 500;
      border-bottom: 1px solid #eee;
    }

    th {
      background-color: var(--color-gold);
      color: var(--color-dark);
      font-weight: 700;
      text-transform: uppercase;
      font-size: 0.9rem;
    }

    tr:nth-child(even) {
      background-color: var(--color-light-grey);
    }

    tr:hover {
      background-color: rgba(255, 215, 0, 0.1);
      transition: 0.3s;
    }

    .total-cell {
      font-weight: 700;
      color: var(--color-dark);
      background-color: rgba(255, 215, 0, 0.2);
    }
    /* --- NEW HEADER CONTAINER STYLE (Kept previous h2 styling) --- */
.header-container {
    text-align: center; /* Center the h2 wrapper */
    margin-bottom: 25px; /* Spacing below the heading */
}

.header-container h2 {
    font-weight: 800;
    font-size: 1.9em;
    color: #222;
    letter-spacing: 0.8px;
    margin: 0; /* Remove default margin from h2 */
    display: inline-block;
    border-bottom: 3px solid #ffd700;
    background: linear-gradient(90deg, #8E8EED 60%, #EBD483 100%);
    border-radius: 6px;
    padding: 8px 16px;
}
.fee-form > div {
  display: flex;
  flex-direction: column;
}
input:hover {
  border-color: var(--color-gold);
}button:active {
  transform: scale(0.97);
}

table {
  display: block;
  width: 100%;
  overflow-x: auto;
}

thead, tbody, tr {
  width: 100%;
}
@media (max-width: 600px) {
  th, td {
    padding: 10px 8px;
    font-size: 0.85rem;
  }

  h3 {
    font-size: 1.1rem;
  }
}
.container {
  animation: fadeIn 0.4s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
.container {
  animation: fadeIn 0.4s ease-in-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 768px) {
  .container {
    padding: 20px;
    margin: 80px 12px 30px;
    border-radius: 10px;
  }
}




    @media (max-width: 600px) {
      header {
        flex-direction: column;
        text-align: center;
      }
      header nav {
        flex-wrap: wrap;
        justify-content: center;
      }
      .fee-form {
        grid-template-columns: 1fr;
      }
    }
    /* ================= MOBILE TABLE CARD VIEW ================= */
@media (max-width: 600px) {

  /* Keep container safe */
  .container {
    overflow: hidden;
  }

  /* Convert table to block layout */
  table,
  thead,
  tbody,
  th,
  tr,
  td {
    display: block;
    width: 100%;
  }

  /* Hide table header */
  thead {
    display: none;
  }

  /* Each row becomes a card */
  tbody tr {
    background: #ffffff;
    border: 1px solid #ddd;
    border-radius: 10px;
    margin-bottom: 15px;
    padding: 12px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.08);
  }

  /* Cell layout: label | value */
  td {
    display: grid;
    grid-template-columns: 40% 60%;
    padding: 8px 0;
    border: none;
    font-size: 0.9rem;
    box-sizing: border-box;
  }

  /* Labels (left column) */
  td:nth-child(1)::before { content: "Year"; }
  td:nth-child(2)::before { content: "Room Rent"; }
  td:nth-child(3)::before { content: "Mess Bill 1"; }
  td:nth-child(4)::before { content: "Mess Bill 2"; }
  td:nth-child(5)::before { content: "Total Amount"; }

  td::before {
    font-weight: 700;
    color: var(--color-dark);
  }

  /* Data (right column) */
  td {
    color: #333;
  }

  /* Total highlight */
  .total-cell {
    background: rgba(255, 215, 0, 0.15);
    border-radius: 6px;
    padding: 8px;
    font-weight: 700;
  }
}
@media (max-width: 1024px) {
  .container {
    max-width: 900px;
    margin: 90px auto 30px;
    padding: 30px 40px;
    border-radius: 12px;
  }
}
@media (max-width: 600px) {
  .container {
    max-width: 100%;
    margin: 80px 12px 25px;
    padding: 20px;
    border-radius: 12px;
    overflow: hidden;
  }
}
/* ================= TABLE ROWS AS CONTAINERS (MOBILE + TABLET) ================= */
@media (max-width: 1024px) {

  /* Keep desktop table untouched */
  table {
    display: block;
    width: 100%;
  }

  thead {
    display: none; /* hide header on mobile & tablet */
  }

  tbody,
  tr,
  td {
    display: block;
    width: 100%;
  }

  /* Each row becomes its own container */
  tbody tr {
    background: #ffffff;
    border: 1px solid #ddd;
    border-radius: 12px;
    margin-bottom: 16px;
    padding: 14px;
    box-shadow: 0 6px 14px rgba(0,0,0,0.08);
    box-sizing: border-box;
  }

  /* Label | Value layout */
  td {
    display: grid;
    grid-template-columns: 45% 55%;
    padding: 8px 0;
    border: none;
    font-size: 0.95rem;
    box-sizing: border-box;
  }

  /* Column labels */
  td:nth-child(1)::before { content: "Year"; }
  td:nth-child(2)::before { content: "Room Rent"; }
  td:nth-child(3)::before { content: "Mess Bill 1"; }
  td:nth-child(4)::before { content: "Mess Bill 2"; }
  td:nth-child(5)::before { content: "Total Amount"; }

  td::before {
    font-weight: 700;
    color: var(--color-dark);
  }

  /* Value styling */
  td {
    color: #333;
  }

  /* Highlight total */
  .total-cell {
    background: rgba(255, 215, 0, 0.18);
    border-radius: 6px;
    padding: 10px;
    font-weight: 700;
  }
}
/* ================= MOBILE SCROLL & FOOTER FIX ================= */
@media (max-width: 600px) {

  /* Allow page scrolling on mobile */
  body {
    overflow-y: auto;
  }

  /* Make container scroll-friendly */
  .container {
    max-height: calc(100vh - 90px); /* leaves space for header */
    overflow-y: auto;               /* ✅ scroll enabled */
    -webkit-overflow-scrolling: touch;
  }

  /* Footer / copyright small & subtle */
  footer,
  .footer,
  .copyright {
    font-size: 0.60rem;      /* ✅ very small */
    text-align: center;
    padding: 6px 0;
    color: #777;
  }
}


  </style>
</head>
<body>
 

  <div class="container">

    <div class="header-container">
        <h2>Set Yearly Fees</h2>
    </div>

    <form action="/admin/yearlyFees" method="POST" class="fee-form">
      <div>
        <label for="year">Academic Year:</label>
        <input type="number" id="year" name="year" required>
      </div>

      <div>
        <label for="room_rent">Room Rent (₹):</label>
        <input type="number" step="0.01" id="room_rent" name="room_rent" required>
      </div>

      <div>
        <label for="mess_bill1">Mess Bill 1 (₹):</label>
        <input type="number" step="0.01" id="mess_bill1" name="mess_bill1" required>
      </div>

      <div>
        <label for="mess_bill2">Mess Bill 2 (₹):</label>
        <input type="number" step="0.01" id="mess_bill2" name="mess_bill2" required>
      </div>

      <div class="button-full-width">
        <button type="submit">💾 Save / Update</button>
      </div>
    </form>

    <h3>📋 Existing Yearly Fees</h3>
    <table>
      <thead>
        <tr>
          <th>Year</th>
          <th>Room Rent (₹)</th>
          <th>Mess Bill 1 (₹)</th>
          <th>Mess Bill 2 (₹)</th>
          <th>Total Amount (₹)</th>
        </tr>
      </thead>
      <tbody>
        <% if(!fees || fees.length === 0) { %>
          <tr><td colspan="5">No fee data available.</td></tr>
        <% } else { %>
          <% fees.forEach(f => { %>
            <tr>
              <td><%= f.year %></td>
              <td>₹<%= parseFloat(f.room_rent || 0).toFixed(2) %></td>
              <td>₹<%= parseFloat(f.mess_bill1 || 0).toFixed(2) %></td>
              <td>₹<%= parseFloat(f.mess_bill2 || 0).toFixed(2) %></td>
              <td class="total-cell">₹<%= (
                parseFloat(f.room_rent || 0) + 
                parseFloat(f.mess_bill1 || 0) + 
                parseFloat(f.mess_bill2 || 0)
              ).toFixed(2) %></td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
  
</body>
</html>
