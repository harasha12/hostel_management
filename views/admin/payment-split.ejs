<!DOCTYPE html>
<html>
<head>
  <title>Payment Split</title>
  <style>
    body{font-family:Arial;background:#f4f6fb;padding:30px}
    .card{background:#fff;padding:25px;border-radius:8px;max-width:700px;margin:auto}
    label{display:block;margin-top:12px;font-weight:bold}
    input,select{width:100%;padding:8px;margin-top:5px}
    button{margin-top:20px;padding:10px;background:#2563eb;color:#fff;border:none;width:100%}
    /* ================= MOBILE RESPONSIVE ================= */
@media (max-width: 768px) {

  body {
    padding: 14px;
    background: #eef2ff;
  }

  .card {
    padding: 18px;
    border-radius: 14px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
  }

  h2 {
    font-size: 1.25rem;
    text-align: center;
    margin-bottom: 12px;
  }

  p {
    font-size: 14px;
    line-height: 1.5;
    background: #f8fafc;
    padding: 12px;
    border-radius: 10px;
    border-left: 4px solid #2563eb;
  }

  label {
    font-size: 14px;
    margin-top: 14px;
  }

  input,
  select {
    padding: 12px;
    font-size: 15px;
    border-radius: 10px;
    border: 1px solid #c7d2fe;
  }

  input:focus,
  select:focus {
    outline: none;
    border-color: #2563eb;
    box-shadow: 0 0 0 2px rgba(37,99,235,0.2);
  }

  button {
    margin-top: 22px;
    padding: 14px;
    font-size: 16px;
    font-weight: bold;
    border-radius: 14px;
    background: linear-gradient(90deg,#2563eb,#1e40af);
    box-shadow: 0 6px 18px rgba(37,99,235,0.4);
  }

  button:active {
    transform: scale(0.97);
  }
}

/* ================= SMALL DEVICES ================= */
@media (max-width: 420px) {

  h2 {
    font-size: 1.1rem;
  }

  p {
    font-size: 13px;
  }

  input,
  select {
    font-size: 14px;
  }
}

  </style>
</head>
<body>

<div class="card">
  <h2>💰 Payment Split</h2>

  <p>
    Bank Amount: <b>₹<%= txn.amount %></b><br>
    Ref: <b><%= txn.reference_no || 'N/A' %></b>
  </p>

  <form method="POST" action="/admin/payment-split">
    <input type="hidden" name="bank_txn_id" value="<%= txn.id %>">

    <label>Student</label>
    <select name="student_id" required>
      <% students.forEach(s=>{ %>
        <option value="<%= s.student_id %>"><%= s.name %></option>
      <% }) %>
    </select>

    <label>Academic Year</label>
    <input type="number" name="academic_year" required>

    <label>Room Rent</label>
    <input type="number" step="0.01" name="room_rent">

    <label>Mess Bill 1</label>
    <input type="number" step="0.01" name="mess1">

    <label>Mess Bill 2</label>
    <input type="number" step="0.01" name="mess2">

    <button>✔ Apply Split</button>
  </form>
</div>

</body>
</html>
