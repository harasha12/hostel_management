<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Bank Transactions</title>

  <style>
    body{
  font-family: "Segoe UI", sans-serif;
  background:#f3f4f6;
  padding:30px;
  color:#111;
}


    h2{
      text-align:center;
      margin-bottom:20px;
      color:#1f2937;
    }

    .search-box{
      max-width:500px;
      margin:0 auto 20px;
      display:flex;
      gap:10px;
    }

    .search-box input{
      flex:1;
      padding:10px 14px;
      border-radius:8px;
      border:1px solid #d1d5db;
      font-size:14px;
    }

    .search-box button{
      padding:10px 18px;
      border-radius:8px;
      border:none;
      background:#2563eb;
      color:#fff;
      font-weight:600;
      cursor:pointer;
    }

    table{
      width:100%;
      border-collapse:collapse;
      background:#fff;
      box-shadow:0 8px 24px rgba(0,0,0,.08);
      border-radius:12px;
      overflow:hidden;
    }

    th,td{
      padding:12px 14px;
      border-bottom:1px solid #e5e7eb;
      text-align:center;
      font-size:14px;
    }

    th{
      background:#1e40af;
      color:#fff;
      text-transform:uppercase;
      font-size:13px;
      letter-spacing:.05em;
    }

    tr:nth-child(even){
      background:#f9fafb;
    }

    .status{
      font-weight:700;
      padding:4px 10px;
      border-radius:999px;
      font-size:12px;
      display:inline-block;
    }

    .UNMATCHED{ background:#fee2e2; color:#991b1b; }
    .MATCHED{ background:#dcfce7; color:#166534; }
    .VERIFIED{ background:#dcfce7; color:#166534; }

    a.verify{
      text-decoration:none;
      padding:6px 12px;
      background:#16a34a;
      color:#fff;
      border-radius:6px;
      font-size:13px;
      font-weight:600;
    }

    a.verify:hover{
      background:#15803d;
    }

    .no-data{
      padding:20px;
      color:#6b7280;
    }
    .top-bar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin-bottom:20px;
}

.back-btn{
  text-decoration:none;
  padding:8px 16px;
  background:#e5e7eb;
  color:#111827;
  border-radius:8px;
  font-weight:600;
  font-size:14px;
}

.back-btn:hover{
  background:#d1d5db;
}
/* ================= MOBILE UI ================= */
@media (max-width: 768px) {

  body {
    padding: 12px;
  }

  /* Top bar stack */
  .top-bar {
    flex-direction: column;
    align-items: stretch;
    gap: 12px;
  }

  .top-bar h2 {
    text-align: center;
    font-size: 1.3rem;
  }

  .back-btn {
    text-align: center;
  }

  /* Search box stack */
  .search-box {
    flex-direction: column;
    max-width: 100%;
  }

  .search-box input,
  .search-box button {
    width: 100%;
    font-size: 15px;
  }

  /* Hide table header */
  table thead {
  display: none;
}


  table,
  tbody,
  tr,
  td {
    display: block;
    width: 100%;
  }

  table {
    box-shadow: none;
    background: transparent;
  }

  tr {
    background: #fff;
    margin-bottom: 14px;
    border-radius: 14px;
    padding: 14px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }

  td {
    border: none;
    text-align: left;
    padding: 6px 0;
    font-size: 14px;
  }

  td::before {
    content: attr(data-label);
    font-weight: 700;
    color: #374151;
    display: block;
    font-size: 12px;
    margin-bottom: 2px;
  }

  /* Status pill */
  .status {
    font-size: 12px;
  }

  /* Verify button full width */
  a.verify {
    display: block;
    text-align: center;
    margin-top: 10px;
    padding: 10px;
    font-size: 14px;
  }

  .no-data {
    text-align: center;
    padding: 20px;
  }
}
/* 🔥 FORCE TEXT VISIBILITY – MOBILE FIX */
@media (max-width: 768px) {

  body {
    color: #111;
  }

  table,
  tbody,
  tr,
  td {
    color: #111;
  }

  td::before {
    color: #374151;
  }

  h2,
  .top-bar,
  .search-box,
  .search-box input {
    color: #111;
  }

  a.verify {
    color: #fff;
  }
}

  </style>
</head>
<body>

<div class="top-bar">
  <a href="/admin/dashboard" class="back-btn">⬅ Back to Dashboard</a>
  <h2>📋 Bank Transactions</h2>
</div>


<form method="GET" class="search-box">
  <input
    type="text"
    name="q"
    placeholder="Search by Transaction ID / Cheque No / DUM No / Reference No"
    value="<%= query || '' %>"
  />
  <button type="submit">Search</button>
</form>

<table>
  <tr>
    <th>Date</th>
    <th>Amount</th>
    <th>Reference</th>
    <th>Source</th>
    <th>Status</th>
    <th>Action</th>
  </tr>

  <% if (rows && rows.length) { %>
    <% rows.forEach(t => { %>
      <tr>
        <td data-label="Date"><%= t.transaction_date || t.txn_date || '-' %></td>
<td data-label="Amount">₹<%= Number(t.total_amount).toFixed(2) %></td>
<td data-label="Reference"><%= t.bank_ref_no || t.cheque_no || t.dum_number || '-' %></td>
<td data-label="Source"><%= t.bank_source || '-' %></td>
<td data-label="Status">

          <span class="status <%= t.status %>"><%= t.status %></span>
        </td>
        <td data-label="Action">
          <% if (t.status === 'UNMATCHED') { %>
            <a class="verify" href="/admin/bank/<%= t.id %>/verify">Verify</a>
          <% } else { %>
            —
          <% } %>
        </td>
      </tr>
    <% }) %>
  <% } else { %>
    <tr>
      <td colspan="6" class="no-data">No bank transactions found</td>
    </tr>
  <% } %>
</table>

</body>
</html>
