<div class="paid-receipts">

  <h2 class="page-title">Paid / Verified Fee Receipts</h2>

  <% if (!accepted || accepted.length === 0) { %>
    <p class="no-data">No paid receipts found</p>
  <% } else { %>

    <div class="receipt-grid">
      <% accepted.forEach(r => { %>
        <div class="receipt-card">

          <div class="card-header">
            <span class="student-name"><%= r.name %></span>
            <span class="status <%= r.status.toLowerCase() %>">
              <%= r.status %>
            </span>
          </div>

          <div class="card-body">
            <p><b>Student ID:</b> <%= r.student_unique_id %></p>
            <p><b>Reference ID:</b> <%= r.ref_id %></p>
            <p><b>Amount:</b> ₹<%= r.amount_paid %></p>
            <p><b>Verified At:</b>
              <%= r.verified_at
                ? new Date(r.verified_at).toLocaleString('en-IN')
                : 'N/A' %>
            </p>
          </div>

          <div class="card-footer">
  <% if (r.pdf_path) { %>
    <a
      href="<%= '/' + r.pdf_path.replace(/^\/+/,'') %>"
      target="_blank"
      rel="noopener"
      class="pdf-btn">
      View PDF
    </a>
  <% } else { %>
    <span class="no-pdf">No PDF</span>
  <% } %>
</div>


        </div>
      <% }) %>
    </div>

  <% } %>
</div>

<style>
/* ===== PAGE ===== */
.paid-receipts {
  max-width: 1100px;
  margin: auto;
}

.page-title {
  text-align: center;
  color: #ffd700;
  margin-bottom: 20px;
}

/* ===== GRID ===== */
.receipt-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 20px;
}

/* ===== CARD ===== */
.receipt-card {
  background: rgba(255,255,255,0.1);
  border-radius: 14px;
  padding: 16px;
  box-shadow: 0 6px 18px rgba(0,0,0,0.4);
  backdrop-filter: blur(6px);
  transition: transform .2s ease;
}

.receipt-card:hover {
  transform: translateY(-4px);
}

/* ===== HEADER ===== */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10px;
}

.student-name {
  font-weight: 700;
  font-size: 1.05rem;
  color: #fff;
}

/* ===== STATUS ===== */
.status {
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 700;
}

.status.paid,
.status.verified,
.status.accepted,
.status.success {
  background: #dcfce7;
  color: #166534;
}

/* ===== BODY ===== */
.card-body p {
  margin: 6px 0;
  font-size: 0.9rem;
  color: #e5e7eb;
}

/* ===== FOOTER ===== */
.card-footer {
  margin-top: 12px;
  text-align: center;
}

.pdf-btn {
  display: inline-block;
  padding: 8px 14px;
  background: #2563eb;
  color: #fff;
  border-radius: 8px;
  font-weight: 600;
  text-decoration: none;
}

.pdf-btn:hover {
  background: #1d4ed8;
}

.no-pdf {
  color: #9ca3af;
  font-size: 13px;
}

/* ===== NO DATA ===== */
.no-data {
  text-align: center;
  color: #9ca3af;
}
</style>
