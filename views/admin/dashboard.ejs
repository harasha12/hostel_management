<%
  const noticeData = latestNotice || null;
  let showNotice = false;
  let noticeTime = null;
  let isNew = false;

  if (noticeData) {
    noticeTime = new Date(noticeData.created_at);
    const now = new Date();
    const hoursDiff = Math.abs(now - noticeTime) / 36e5;
    isNew = hoursDiff <= 24;
    showNotice = true;
  }
%>

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Admin Dashboard</title>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css"/>

<style>
/* ===== ROOT RESET (THIS FIXES LOCALHOST ISSUE) ===== */
html, body {
  margin: 0;
  padding: 0;
  height: 100%;
  overflow: hidden; /* 🔒 page no scroll */
  font-family: "Segoe UI", Tahoma, sans-serif;
}

/* ===== BACKGROUND ===== */
body {
  background: url("/images/hostel-bg.jpg") no-repeat center center fixed;
  background-size: cover;
  color: #fff;
}

/* ===== OVERLAY ===== */
.overlay {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: rgba(0,0,0,0.6);
  backdrop-filter: blur(5px);
}

/* ===== HEADER ===== */
.college-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 20px;
  background: rgba(255,255,255,0.1);
  text-align: center;
}

.college-header img {
  height: 90px;
}

.header-text h2 {
  margin: 0;
  font-size: 1.8rem;
  font-weight: bold;
}

.autonomous {
  color: #ffcc00;
}

/* ===== NOTICE ===== */
.notification-banner {
  flex-shrink: 0;
  width: 100%;
  background: linear-gradient(90deg,#ffd600,#ffcc00);
  color: #000;
  font-weight: bold;
  overflow: hidden;
}

.scrolling-text {
  padding: 10px 0;
  white-space: nowrap;
  display: inline-block;
  animation: scroll 15s linear infinite;
}

@keyframes scroll {
  from { transform: translateX(100%); }
  to { transform: translateX(-100%); }
}

/* ===== DASHBOARD ===== */
.dashboard {
  flex: 1;
  display: flex;
  min-height: 0; /* 🔥 critical fix */
}

/* ===== SIDEBAR ===== */
.sidebar {
  width: 250px;
  background: linear-gradient(180deg,#0a1f44,#153b77);
  display: flex;
  flex-direction: column;
  overflow-y: auto; /* ✅ sidebar scroll */
}

.sidebar.compressed {
  width: 70px;
}

.toggle-container {
  padding: 10px;
  text-align: right;
}

.toggle-btn {
  background: rgba(255,255,255,0.1);
  border: none;
  color: #ffcc00;
  font-size: 1.4rem;
  cursor: pointer;
}

.menu a,
.logout a {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 18px;
  color: #fff;
  text-decoration: none;
}

.menu a:hover {
  background: rgba(255,255,255,0.1);
  color: #ffcc00;
}

.sidebar.compressed .nav-text {
  display: none;
}

.logout {
  margin-top: auto;
  border-top: 1px solid rgba(255,255,255,0.2);
}

/* ===== MAIN CONTENT ===== */
.main-content {
  flex: 1;
  padding: 40px;
  overflow: hidden; /* 🔒 no page scroll */
}

.main-content h2 {
  color: #ffcc00;
}
</style>
</head>

<body>
<div class="overlay">

  <!-- HEADER -->
  <div class="college-header">
    <img src="/images/college_logo.png" alt="Logo">
    <div class="header-text">
      <h2>
        SIR C R REDDY COLLEGE OF ENGINEERING – BOYS HOSTEL
        (<span class="autonomous">AUTONOMOUS</span>)
      </h2>
      <p>Approved by AICTE | JNTUK | NAAC-A</p>
    </div>
  </div>

  <!-- NOTICE -->
  <% if (showNotice) { %>
  <div class="notification-banner">
    <div class="scrolling-text">
      <% if (isNew) { %> 🆕 <strong>NEW</strong> | <% } %>
      📢 <%= noticeData.title %> — <%= noticeData.description %>
      ⏱ <%= noticeTime.toLocaleString() %>
    </div>
  </div>
  <% } %>

  <!-- DASHBOARD -->
  <div class="dashboard">

    <!-- SIDEBAR -->
    <div class="sidebar" id="sidebar">
      <div class="toggle-container">
        <button class="toggle-btn" id="toggleBtn">
          <i class="fas fa-bars"></i>
        </button>
      </div>

      <div class="menu">
        <a href="/admin/manageWardens"><i class="fas fa-user-tie"></i><span class="nav-text">Manage Wardens</span></a>
        <a href="/admin/uploadSBI"><i class="fas fa-upload"></i><span class="nav-text">Upload SBI PDF</span></a>
        <a href="/admin/acceptedReceipts"><i class="fas fa-clock"></i><span class="nav-text">Paid Receipts</span></a>
        <a href="/admin/viewOutpasses"><i class="fas fa-sign-out-alt"></i><span class="nav-text">Out Passes</span></a>
        <a href="/admin/viewStudents"><i class="fas fa-users"></i><span class="nav-text">Students</span></a>
        <a href="/admin/admin_complaints"><i class="fas fa-comments"></i><span class="nav-text">Complaints</span></a>
        <a href="/admin/yearlyFees"><i class="fas fa-sliders-h"></i><span class="nav-text">Yearly Fees</span></a>
      </div>

      <div class="logout">
        <a href="/logout"><i class="fas fa-sign-out-alt"></i><span class="nav-text">Logout</span></a>
      </div>
    </div>

    <!-- CONTENT -->
    <div class="main-content">
      <h2>Welcome, <%= user.name %> (Admin)</h2>
    </div>

  </div>
</div>

<script>
const btn = document.getElementById("toggleBtn");
const sidebar = document.getElementById("sidebar");

btn.onclick = () => sidebar.classList.toggle("compressed");
</script>
</body>
</html>
